");\n\n    if (error) {\n      console.error(\"Error fetching flags:\", error);\n      return NextResponse.json(\n        { error: \"Failed to fetch flags\" },\n        { status: 500 }\n      );\n    }\n\n    const flagsMap: Record<string, boolean> = {};\n    flags?.forEach((flag) => {\n      flagsMap[flag.flag_key] = flag.flag_value;\n    });\n\n    return NextResponse.json({ flags: flagsMap });\n  } catch (error) {\n    console.error(\"Toggles GET error:\", error);\n    return NextResponse.json(\n      { error: \"Internal server error\" },\n      { status: 500 }\n    );\n  }\n}\n\n/**\n * POST /api/admin/automation/toggles\n * \n * Update feature flags\n */\nexport async function POST(request: NextRequest) {\n  try {\n    await validateAdmin();\n  } catch (error) {\n    return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n  }\n\n  const serverSupabase = getSupabaseServer();\n  if (!serverSupabase) {\n    return NextResponse.json(\n      { error: \"Server configuration error\" },\n      { status: 500 }\n    );\n  }\n\n  try {\n    const body = await request.json();\n    const updates = body as Record<string, boolean>;\n\n    // Update each flag\n    for (const [key, value] of Object.entries(updates)) {\n      await serverSupabase\n        .from(\"feature_flags\")\n        .upsert(\n          {\n            flag_key: key,\n            flag_value: value,\n            updated_at: new Date().toISOString(),\n          },\n          {\n            onConflict: \"flag_key\",\n          }\n        );\n    }\n\n    return NextResponse.json({ success: true });\n  } catch (error) {\n    console.error(\"Toggles POST error:\", error);\n    return NextResponse.json(\n      { error: \"Internal server error\" },\n      { status: 500 }\n    );\n  }\n}\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/admin/email-logs/export/route.t