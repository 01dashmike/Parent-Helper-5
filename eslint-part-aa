w Date();\n    const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);\n\n    // 1. Total new users (30 days)\n    // Query auth.users via admin API\n    let totalNewUsers = 0;\n    try {\n      const { data: users } = await supabase.auth.admin.listUsers();\n      if (users?.users) {\n        totalNewUsers = users.users.filter(\n          (user) => new Date(user.created_at) >= thirtyDaysAgo\n        ).length;\n      }\n    } catch (error) {\n      console.error(\"[admin/insights] Error fetching users:\", error);\n    }\n\n    // 2. Total bookings (30 days)\n    const { data: bookings, error: bookingsError } = await supabase\n      .from(\"simple_bookings\")\n      .select(\"id, created_at, status\")\n      .gte(\"created_at\", thirtyDaysAgo.toISOString());\n\n    const totalBookings = await supabaseRowCount(\n      supabase,\n      \"simple_bookings\",\n      (q) => q.gte(\"created_at\", thirtyDaysAgo.toISOString())\n    ).catch(() => bookings?.length || 0);\n\n    const confirmedBookings = bookings?.filter((b) => b.status === \"confirmed\" || b.status === \"paid\").length || 0;\n\n    // Get daily bookings for chart\n    const bookingsByDate = new Map<string, number>();\n    bookings?.forEach((booking) => {\n      const date = new Date(booking.created_at).toISOString().split(\"T\")[0];\n      bookingsByDate.set(date, (bookingsByDate.get(date) || 0) + 1);\n    });\n\n    // 3. Total referrals + conversion rate\n    const { data: memberReferrals, error: memberRefError } = await supabase\n      .from(\"member_referrals\")\n      .select(\"id, status, created_at\")\n      .gte(\"created_at\", thirtyDaysAgo.toISOString());\n\n    const { data: providerReferrals, error: providerRefError } = await supabase\n      .from(\"provider_referrals\")\n      .select(\"id, status, created_at\")\n      .gte(\"created_at\", thirtyDaysAgo.toISOString());\n\n    const memberReferralsCount = await supabaseRowCount(\n      supabase,\n      \"member_referrals\",\n      (q) => q.gte(\"created_at\", thirtyDaysAgo.toISOString())\n    ).catch(() => memberReferrals?.length || 0);\n\n    const providerReferralsCount = await supabaseRowCount(\n      supabase,\n      \"provider_referrals\",\n      (q) => q.gte(\"created_at\", thirtyDaysAgo.toISOString())\n    ).catch(() => providerReferrals?.length || 0);\n\n    const totalReferrals = memberReferralsCount + providerReferralsCount;\n    const convertedReferrals =\n      (memberReferrals?.filter((r) => r.status === \"converted\").length || 0) +\n      (providerReferrals?.filter((r) => r.status === \"first_booking\").length || 0);\n    const conversionRate = totalReferrals > 0 ? (convertedReferrals / totalReferrals) * 100 : 0;\n\n    // Referral conversion breakdown\n    const signupConversions = memberReferrals?.filter((r) => r.status === \"converted\").length || 0;\n    const bookingConversions = providerReferrals?.filter((r) => r.status === \"first_booking\").length || 0;\n\n    // 4. Total rewards issued + redeemed (30 days)\n    const { data: rewards, error: rewardsError } = await supabase\n      .from(\"rewards\")\n      .select(\"id, status, value_cents, created_at\")\n      .gte(\"created_at\", thirtyDaysAgo.toISOString());\n\n    const totalRewardsIssued = await supabaseRowCount(\n      supabase,\n      \"rewards\",\n      (q) => q.gte(\"created_at\", thirtyDaysAgo.toISOString())\n    ).catch(() => rewards?.length || 0);\n    const totalRewardsRedeemed = rewards?.filter((r) => r.status === \"redeemed\").length || 0;\n    const totalRewardsValueCents = rewards?.reduce((sum, r) => sum + (r.value_cents || 0), 0) || 0;\n\n    // 5. Provider growth metrics\n    const { data: providers, error: providersError } = await supabase\n      .from(\"providers\")\n      .select(`\n        id,\n        name,\n        slug,\n        rating,\n        review_count,\n        photo_url,\n        created_at,\n        classes!inner(id)\n      `)\n      .eq(\"classes.is_active\", true);\n\n    // Calculate 