st lastWeekRevenue = bookingsData\n      .filter((b) => new Date(b.createdAt) >= lastWeek)\n      .reduce((sum, b) => {\n        const paid = typeof b.totalPaid === \"string\" ? parseFloat(b.totalPaid) : b.totalPaid || 0;\n        return sum + paid;\n      }, 0);\n\n    const previousWeekRevenue = bookingsData\n      .filter((b) => {\n        const date = new Date(b.createdAt);\n        return date >= new Date(lastWeek.getTime() - 7 * 24 * 60 * 60 * 1000) && date < lastWeek;\n      })\n      .reduce((sum, b) => {\n        const paid = typeof b.totalPaid === \"string\" ? parseFloat(b.totalPaid) : b.totalPaid || 0;\n        return sum + paid;\n      }, 0);\n\n    const revenueGrowth = previousWeekRevenue > 0\n      ? ((lastWeekRevenue - previousWeekRevenue) / previousWeekRevenue) * 100\n      : 0;\n\n    // Get conversion rate (bookings / requests)\n    let conversionRate = 0;\n    try {\n      const { data: bookingRequests } = await supabase\n        .from(\"booking_requests\")\n        .select(\"id, status, created_at\")\n        .gte(\"created_at\", lastMonth.toISOString());\n\n      const totalRequests = bookingRequests?.length || 0;\n      conversionRate = totalRequests > 0\n        ? (bookingsData.length / totalRequests) * 100\n        : 0;\n    } catch (error) {\n      // booking_requests table might not exist\n      console.warn(\"Could not fetch booking requests:\", error);\n    }\n\n    // Get wallet credits total\n    let totalWalletCredits = 0;\n    try {\n      const walletCredits = await db\n        .select({\n          amountCents: walletTransactions.amountCents,\n          type: walletTransactions.type,\n        })\n        .from(walletTransactions)\n        .innerJoin(familyWallets, eq(walletTransactions.walletId, familyWallets.id));\n\n      totalWalletCredits = walletCredits.reduce((sum, t) => {\n        if (t.type === \"credit\" || t.type === \"gift\" || t.type === \"bonus\") {\n          return sum + t.amountCents;\n        } else {\n          return sum - t.amountCents;\n        }\n      }, 0);\n    } catch (error) {\n      // wallet tables might not exist\n      console.warn(\"Could not fetch wallet credits:\", error);\n    }\n\n    // Get top provider\n    const topProviders = await db\n      .select({\n        providerId: bookings.providerId,\n        count: sql<number>`count(*)`,\n      })\n      .from(bookings)\n      .where(eq(bookings.status, \"confirmed\"))\n      .groupBy(bookings.providerId)\n      .orderBy(sql`count(*) desc`)\n      .limit(1);\n\n    const topProviderId = topProviders[0]?.providerId;\n    let topProviderName = \"N/A\";\n    if (topProviderId) {\n      const providerData = await db\n        .select({ name: providers.name })\n        .from(providers)\n        .where(eq(providers.id, topProviderId))\n        .limit(1);\n      topProviderName = providerData[0]?.name || \"N/A\";\n    }\n\n    // Also try to get wallet credits from user_wallets table\n    let walletCreditsFromWallets = 0;\n    try {\n      const { data: wallets } = await supabase\n        .from(\"user_wallets\")\n        .select(\"balance_cents\");\n      walletCreditsFromWallets = wallets?.reduce((sum, w) => sum + (w.balance_cents || 0), 0) || 0;\n    } catch {\n      // user_wallets might not exist\n    }\n\n    const finalWalletCredits = walletCreditsFromWallets || totalWalletCredits;\n\n    return NextResponse.json({\n      revenue_cents: Math.round(totalRevenue * 100), // Convert to cents\n      conversion_rate: parseFloat(conversionRate.toFixed(1)),\n      wallet_credits_cents: finalWalletCredits,\n      growth_prediction: \"AI predicts steady growth next week.\", // Will be updated by client-side forecast\n      top_provider: topProviderName,\n    });\n  } catch (error) {\n    console.error(\"[api/admin/automation/summary] Error:\", error);\n    return NextResponse.json(\n      { error: \"Failed to fetch summary\" },\n      { status: 500 }\n    );\n  }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","re