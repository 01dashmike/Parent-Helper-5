t } from \"@/lib/supabase/server\";\nimport { isAIInsightsEnabled } from \"@/lib/env\";\n\nexport const dynamic = \"force-dynamic\";\nexport const runtime = \"nodejs\";\n\n// This endpoint should be protected with a secret token or cron job authentication\nconst CRON_SECRET = process.env.CRON_SECRET || process.env.VERCEL_CRON_SECRET;\n\nasync function generateGrowthInsights() {\n  const supabase = createServerClient();\n  if (!supabase) {\n    throw new Error(\"Supabase not configured\");\n  }\n\n  // Get the current week start (Monday)\n  const now = new Date();\n  const dayOfWeek = now.getDay();\n  const diff = dayOfWeek === 0 ? -6 : 1 - dayOfWeek; // Monday = 1\n  const weekStart = new Date(now);\n  weekStart.setDate(now.getDate() + diff);\n  weekStart.setHours(0, 0, 0, 0);\n\n  // Check if insights already exist for this week\n  const { data: existing } = await supabase\n    .from(\"insights_reports\")\n    .select(\"id\")\n    .eq(\"week_start\", weekStart.toISOString().split(\"T\")[0])\n    .maybeSingle();\n\n  // Fetch latest metrics from growth_metrics_view\n  const { data: metrics, error: metricsError } = await supabase\n    .from(\"growth_metrics_view\")\n    .select(\"*\")\n    .order(\"week\", { ascending: false })\n    .limit(2);\n\n  if (metricsError) {\n    console.error(\"[generateGrowthInsights] Error fetching metrics:\", metricsError);\n    throw new Error(\"Failed to fetch growth metrics\");\n  }\n\n  if (!metrics || metrics.length === 0) {\n    throw new Error(\"No growth metrics available\");\n  }\n\n  const currentWeek = metrics[0];\n  const previousWeek = metrics[1] || null;\n\n  // Calculate additional metrics\n  const referralConversionRate =\n    currentWeek.total_referrals > 0\n      ? ((currentWeek.conversions || 0) / currentWeek.total_referrals) * 100\n      : 0;\n\n  const avgWalletBalance = currentWeek.wallet_credits || 0;\n  const campaignOpenRate =\n    currentWeek.emails_sent > 0\n      ? ((currentWeek.emails_opened || 0) / currentWeek.emails_sent) * 100\n      : 0;\n\n  // Calculate week-over-week changes\n  const revenueChange = previousWeek\n    ? ((currentWeek.total_revenue - previousWeek.total_revenue) / previousWeek.total_revenue) * 100\n    : 0;\n  const usersChange = previousWeek\n    ? ((currentWeek.active_users - previousWeek.active_users) / previousWeek.active_users) * 100\n    : 0;\n\n  // Build prompt for OpenAI\n  const metricsPrompt = `\nGiven the following weekly growth metrics for Parent Helper, write a concise 5-bullet summary with insights and recommended next actions. Use a professional business tone.\n\nCURRENT WEEK METRICS:\n- Total Revenue: £${currentWeek.total_revenue?.toFixed(2) || \"0.00\"}\n- Active Users: ${currentWeek.active_users || 0}\n- Wallet Credits: £${currentWeek.wallet_credits?.toFixed(2) || \"0.00\"}\n- Referral Conversion Rate: ${referralConversionRate.toFixed(1)}%\n- Average Wallet Balance: £${avgWalletBalance.toFixed(2)}\n- Campaign Open Rate: ${campaignOpenRate.toFixed(1)}%\n- Total Referrals: ${currentWeek.total_referrals || 0}\n- Conversions: ${currentWeek.conversions || 0}\n- Emails Sent: ${currentWeek.emails_sent || 0}\n- Emails Opened: ${currentWeek.emails_opened || 0}\n- Marketing Conversions: ${currentWeek.marketing_conversions || 0}\n\n${previousWeek ? `PREVIOUS WEEK COMPARISON:\n- Revenue Change: ${revenueChange >= 0 ? \"+\" : \"\"}${revenueChange.toFixed(1)}%\n- Users Change: ${usersChange >= 0 ? \"+\" : \"\"}${usersChange.toFixed(1)}%` : \"This is the first week of data.\"}\n\nReturn a JSON object with this structure:\n{\n  \"summary\": \"5-bullet summary with insights (each bullet on a new line)\",\n  \"actions\": [\"Action 1\", \"Action 2\", \"Action 3\", \"Action 4\", \"Action 5\"]\n}\n\nFocus on actionable insights and data-driven recommendations.`;\n\n  // Call OpenAI API\n  if (!process.env.OPENAI_API_KEY) {\n    throw new Error(\"OPENAI_API_KEY not configured\");\n  }\n\n  const openaiResponse = await fetch(\"https://api.openai.com/v1