Store = await cookies();\n  const cookieSecret = cookieStore.get(\"ph_admin\")?.value;\n  const adminSecret = process.env.ADMIN_SECRET;\n  if (!adminSecret || cookieSecret !== adminSecret) {\n    throw new Error(\"Unauthorized\");\n  }\n}\n\ntype GrowthMetricRow = {\n  week: string;\n  active_users: number;\n  total_revenue: number;\n  wallet_credits: number;\n  total_referrals: number;\n  conversions: number;\n  emails_opened: number;\n  emails_sent: number;\n  emails_clicked: number;\n  marketing_conversions: number;\n};\n\ntype GrowthMetricsResponse = {\n  metrics: GrowthMetricRow[];\n  kpis: {\n    referral_conversion_rate: number;\n    avg_wallet_balance: number;\n    revenue_growth_rate: number;\n    email_open_rate: number;\n    email_click_rate: number;\n  };\n};\n\nexport async function GET(req: NextRequest) {\n  try {\n    await validateAdmin();\n  } catch (error) {\n    return NextResponse.json({ error: \"Forbidden\" }, { status: 403 });\n  }\n\n  if (!isGrowthDashboardEnabled()) {\n    return NextResponse.json({ error: \"Growth dashboard is disabled\" }, { status: 403 });\n  }\n\n  const supabase = getSupabaseServer();\n  if (!supabase) {\n    return NextResponse.json({ error: \"Server error\" }, { status: 500 });\n  }\n\n  try {\n    // Query the materialized view directly\n    const { data: viewMetrics, error: metricsError } = await supabase\n      .from(\"growth_metrics_view\")\n      .select(\"*\")\n      .order(\"week\", { ascending: false })\n      .limit(52);\n\n    if (metricsError) {\n      console.error(\"Error fetching growth metrics:\", metricsError);\n      // If view doesn't exist, return empty data (view will be created by migration)\n      return NextResponse.json({\n        metrics: [],\n        kpis: {\n          referral_conversion_rate: 0,\n          avg_wallet_balance: 0,\n          revenue_growth_rate: 0,\n          email_open_rate: 0,\n          email_click_rate: 0,\n        },\n        topWallets: [],\n        campaignStats: [],\n      });\n    }\n    const metrics = viewMetrics || [];\n\n    const metricsRows = metrics as GrowthMetricRow[];\n\n    // Calculate KPIs\n    const thisWeek = metricsRows[0];\n    const lastWeek = metricsRows[1];\n\n    const totalReferrals = metricsRows.reduce((sum, m) => sum + (m.total_referrals || 0), 0);\n    const totalConversions = metricsRows.reduce((sum, m) => sum + (m.conversions || 0), 0);\n    const referralConversionRate = totalReferrals > 0 ? (totalConversions / totalReferrals) * 100 : 0;\n\n    const totalActiveUsers = metricsRows.reduce((sum, m) => sum + (m.active_users || 0), 0);\n    const totalWalletCredits = metricsRows.reduce((sum, m) => sum + (m.wallet_credits || 0), 0);\n    const avgWalletBalance = totalActiveUsers > 0 ? totalWalletCredits / totalActiveUsers : 0;\n\n    const revenueGrowthRate = lastWeek && lastWeek.total_revenue > 0\n      ? ((thisWeek?.total_revenue || 0) - lastWeek.total_revenue) / lastWeek.total_revenue * 100\n      : 0;\n\n    const totalEmailsSent = metricsRows.reduce((sum, m) => sum + (m.emails_sent || 0), 0);\n    const totalEmailsOpened = metricsRows.reduce((sum, m) => sum + (m.emails_opened || 0), 0);\n    const totalEmailsClicked = metricsRows.reduce((sum, m) => sum + (m.emails_clicked || 0), 0);\n    const emailOpenRate = totalEmailsSent > 0 ? (totalEmailsOpened / totalEmailsSent) * 100 : 0;\n    const emailClickRate = totalEmailsSent > 0 ? (totalEmailsClicked / totalEmailsSent) * 100 : 0;\n\n    // Fetch additional data for tables\n    let topWallets: any[] = [];\n    try {\n      const { data: wallets } = await supabase.rpc(\"get_top_wallets\", { limit_count: 10 });\n      topWallets = wallets || [];\n    } catch (err) {\n      console.warn(\"get_top_wallets function not available, using fallback\");\n      // Fallback: query wallets directly\n      const { data: walletData } = await supabase\n        .from(\"family_wallets\")\n        .select(\"id, owner_id\")\n        .limit(10)\n        .catch(() => ({ data: null }));\n      topWallets = (walletData || []).map((w: any) => ({\n        wallet_id: w.id,\n        owner_id: w.owner_id,\n        total_credits: 0,\n        total_transactions: 0,\n        member_count: 0,\n      }));\n    }\n\n    let marketingCampaigns: any[] = [];\n    try {\n      const { data: campaigns } = await supabase\n        .from(\"marketing_events\")\n        .select(\"campaign_id, event_type\")\n        .not(\"campaign_id\", \"is\", null)\n        .limit(1000);\n      marketingCampaigns = campaigns || [];\n    } catch (err) {\n      console.warn(\"marketing_events table not available\");\n      marketingCampaigns = [];\n    }\n\n    // Aggregate campaign data\n    const campaignStats: Record<string, { sent: number; opened: number; clicked: number; converted: number }> = {};\n    marketingCampaigns.forEach((event) => {\n      const campaignId = event.campaign_id;\n      if (!campaignId) return;\n      if (!campaignStats[campaignId]) {\n        campaignStats[campaignId] = { sent: 0, opened: 0, clicked: 0, converted: 0 };\n      }\n      if (event.event_type === \"email_sent\") campaignStats[campaignId].sent++;\n      if (event.event_type === \"email_open\") campaignStats[campaignId].opened++;\n      if (event.event_type === \"email_click\") campaignStats[campaignId].clicked++;\n      if (event.event_type === \"converted\") campaignStats[campaignId].converted++;\n    });\n\n    const campaignTable = Object.entries(campaignStats).map(([campaignId, stats]) => ({\n      campaignId,\n      sent: stats.sent,\n      opened: stats.opened,\n      clicked: stats.clicked,\n      converted: stats.converted,\n      openRate: stats.sent > 0 ? (stats.opened / stats.sent) * 100 : 0,\n      clickRate: stats.sent > 0 ? (stats.clicked / stats.sent) * 100 : 0,\n      conversionRate: stats.sent > 0 ? (stats.converted / stats.sent) * 100 : 0,\n    }));\n\n    const response: GrowthMetricsResponse = {\n      metrics: metricsRows,\n      kpis: {\n        referral_conversio