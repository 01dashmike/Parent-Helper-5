{
  "name": "parent-helper-next",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "railway-build": "npm install && npm run build",
    "prebuild": "npm run migration:verify && npm run check:server-actions",
    "predev": "echo \"Skipping Supabase schema check in local dev\"",
    "dev": "next dev",
    "build": "npm run build:next",
    "build:clean": "rm -rf .next && next build",
    "build:next": "next build",
    "start": "node server.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier . --write",
    "lint:errors": "eslint . --ext .ts,.tsx",
    "fix:errors": "node scripts/eslint-fix-errors.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand",
    "test:e2e": "playwright test --config=tests/config/playwright.config.ts --reporter=list",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:full": "npm run test:unit && npm run test:e2e",
    "test:ci": "npm run build && npm run test:full",
    "test:type": "tsc --noEmit",
    "seed:test": "node scripts/seed-test-data.mjs",
    "test:a11y": "playwright test tests/a11y/accessibility.spec.ts --config=tests/a11y/playwright.config.ts",
    "test:a11y:pages": "playwright test tests/a11y/page-level-accessibility.spec.ts --config=tests/a11y/playwright.config.ts",
    "test:a11y:pa11y": "pa11y-ci --config .pa11yci.json",
    "test:perf": "node tests/performance/lighthouse.test.mjs",
    "test:quality": "npm run test:a11y && npm run test:perf",
    "test:migrations": "npm run migration:verify && npm run test:unit tests/unit/migrations/validateMigrations.test.ts",
    "check:a11y": "playwright test tests/a11y/accessibility.spec.ts",
    "fix:a11y": "node scripts/fix-a11y.mjs",
    "heal:a11y": "npm run check:a11y || npm run fix:a11y",
    "check-env": "node scripts/check-env.mjs",
    "migration:verify": "node scripts/migration-verify.mjs",
    "rebuild": "npm run clean && npm install && npm run build",
    "fix-build": "node scripts/fix-build.mjs",
    "fix-deps": "npm install react@^18.2.0 react-dom@^18.2.0",
    "verify-supabase": "node scripts/ensure-supabase-schema.mjs",
    "images:opt": "node scripts/compress-images.mjs",
    "images:blur": "node scripts/generate-blurs.mjs",
    "images:fix": "node scripts/fix-images.mjs",
    "analyze": "next build && next start -p 4000",
    "lighthouse": "npm run analyze & sleep 3 && open http://localhost:4000",
    "check:server-actions": "node scripts/check-server-actions.mjs",
    "clean": "node scripts/clean-next.mjs || true",
    "dev:clean": "rm -rf .next && next dev",
    "inspect:modules": "node --loader ts-node/esm scripts/dev/inspect-modules.mts",
    "prestart": "npm run migration:verify && node scripts/check-next-health.mjs",
    "diagnose:react": "node -e \"const {execSync}=require('child_process');try{console.log(execSync('npm ls react react-dom').toString())}catch(e){console.log(e.stdout?.toString()||e.message)}\"",
    "preinstall": "echo \"Skipping assert-next-version in local dev\"",
    "seed:demo": "node scripts/seed-demo-families.mjs",
    "health:frontend": "node scripts/frontend-health.mjs",
    "dead-code": "node ./scripts/dead-code-scan.mts",
    "preflight": "node scripts/dev/preflight.mjs",
    "reproduce": "npx tsx scripts/reproduce",
    "reproduce:all": "for script in scripts/reproduce/*.ts; do echo \"Running $script...\"; npx tsx \"$script\"; echo \"\"; done",
    "debug:error": "node scripts/debug-error.js",
    "test:contracts": "jest tests/unit/api/error-sandbox.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
