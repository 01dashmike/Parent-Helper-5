    "images:fix": "node scripts/fix-images.mjs",
    "analyze": "next build && next start -p 4000",
    "lighthouse": "npm run analyze & sleep 3 && open http://localhost:4000",
    "check:server-actions": "node scripts/check-server-actions.mjs",
    "clean": "node scripts/clean-next.mjs || true",
    "dev:clean": "rm -rf .next && next dev",
    "inspect:modules": "node --loader ts-node/esm scripts/dev/inspect-modules.mts",
    "diagnose:react": "node -e \"const {execSync}=require('child_process');try{console.log(execSync('npm ls react react-dom').toString())}catch(e){console.log(e.stdout?.toString()||e.message)}\""
