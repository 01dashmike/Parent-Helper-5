tion ensureUniqueSlug(\n  supabase: SupabaseClient<any>,\n  desired: string,\n  excludeId?: string,\n) {\n  let candidate = desired || `post-${Date.now()}`;\n  let suffix = 1;\n  // eslint-disable-next-line no-constant-condition -- intentional loop that returns once a unique slug is found\n  while (true) {\n    const { data } = await supabase\n      .from(\"blog_posts_ai\")\n      .select(\"id\")\n      .eq(\"slug\", candidate)\n      .limit(1)\n      .maybeSingle();\n    if (!data || (excludeId && data.id === excludeId)) {\n      return candidate;\n    }\n    suffix += 1;\n    candidate = `${desired}-${suffix}`;\n  }\n}\n\nasync function validateAdmin() {\n  const cookieStore = await cookies();\n  const cookieSecret = cookieStore.get(\"ph_admin\")?.value;\n  if (!process.env.ADMIN_SECRET || cookieSecret !== process.env.ADMIN_SECRET) {\n    throw new Error(\"Unauthorised\");\n  }\n}\n\nexport async function POST(req: Request) {\n  try {\n    await validateAdmin();\n  } catch (error) {\n    return NextResponse.json({ error: \"Forbidden\" }, { status: 403 });\n  }\n\n  const body = await req.json().catch(() => ({}));\n  const { action, id, updates } = body as { action?: string; id?: string; updates?: any };\n  if (!action || !id) return NextResponse.json({ error: \"Missing action or id\" }, { status: 400 });\n\n  const supabase = getSupabaseServer();\n  if (!supabase) {\n    return NextResponse.json({ error: \"Supabase not configured\" }, { status: 500 });\n  }\n\n  if (action === \"delete\") {\n    await supabase.from(\"blog_posts_ai\").delete().eq(\"id\", id);\n    revalidatePath(\"/blog\");\n    return NextResponse.json({ ok: true });\n  }\n\n  if (action === \"update\") {\n    const payload = { ...updates, updated_at: new Date().toISOString() };\n    if (typeof payload.title === \"string\" && !payload.slug) {\n      const desired = slugify(payload.title);\n      payload.slug = await ensureUniqueSlug(supabase, desired, id);\n    }\n    await supabase.from(\"blog_posts_ai\").update(payload).eq(\"id\", id);\n    if (payload.status === \"published\") {\n      revalidatePath(\"/blog\");\n      if (payload.slug) {\n        revalidatePath(`/blog/${payload.slug}`);\n      }\n    }\n    return NextResponse.json({ ok: true });\n  }\n\n  if (action === \"publish\") {\n    const { data, error } = await supabase\n      .from(\"blog_posts_ai\")\n      .select(\"title, slug, seo_title, seo_description, category, locality, hero_image, created_at, updated_at\")\n      .eq(\"id\", id)\n      .single();\n    if (error || !data) return NextResponse.json({ error: \"Not found\" }, { status: 404 });\n\n    const slug = await ensureUniqueSlug(supabase, data.slug || slugify(data.title), id);\n\n    const baseUrl = process.env.NEXT_PUBLIC_APP_URL ?? \"https://parenthelper.example\";\n    const heroImage = data.hero_image\n      ? data.hero_image.startsWith(\"http\")\n        ? data.hero_image\n        : `${baseUrl}${data.hero_image}`\n      : undefined;\n\n    const schema = {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Article\",\n      headline: data.seo_title || data.title,\n      description: data.seo_description || data.seo_title,\n      author: {\n        \"@type\": \"Person\",\n        name: \"Parent Helper\",\n      },\n      publisher: {\n        \"@type\": \"Organization\",\n        name: \"Parent Helper\",\n        logo: {\n          \"@type\": \"ImageObject\",\n          url: `${baseUrl}/images/logo.png`,\n        },\n      },\n      url: `${baseUrl}/blog/${slug}`,\n      image: heroImage ? [heroImage] : undefined,\n      datePublished: data.created_at ?? new Date().toISOString(),\n      dateModified: new Date().toISOString(),\n      articleSection: data.category,\n      about: data.locality ?? undefined,\n    };\n\n    await supabase\n      .from(\"blog_posts_ai\")\n      .update({\n        status: \"published\",\n        slug,\n        schema_json: schema,\n        updated_at: new Date().toISOString(),\n      })\n      .eq(\"id\", id);\n\n    revalidatePath(\"/blog\");\n    revalidatePath(`/blog/${slug}`);\n    return NextResponse.json({ ok: true });\n  }\n\n  return NextResponse.json({ error: \"Unknown action\" }, { status: 400 });\n}\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/blog/cron/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/blog/generate/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'error' is defined but never used.","line":119,"column":12,"nodeType":null,"messageId":"unusedVar","endLine":119,"endColumn":17},{"ruleId":"no-useless-escape","severity":2,"message":"Unnecessary escape character: \\-.","line":150,"column":21,"nodeType":"Literal","messageId":"unnecessaryEscape","endLine":150,"endColumn":22,"suggestions":[{"messageId":"removeEscape","fix":{"range":[5822,5823],"text":""},"desc":"Remove the `\\`. This maintains the current functionality."},{"messageId":"escapeBackslash","fix":{"range":[5822,5822],"text":"\\"},"desc":"Replace the `\\` with `\\\\` to include the actual backslash character."}]}],"suppressedMessages":[{"ruleId":"no-constant-condition","severity":2,"message":"Unexpected constant condition.","line":165,"column":10,"nodeType":"Literal","messageId":"unexpected","endLine":165,"endColumn":14,"suppressions":[{"kind":"directive","justification":"intentional loop that returns once a unique slug is found"}]}],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"export const dynamic = \"force-dynamic\";\nexport const runtime = \"nodejs\";\n\nimport type { SupabaseClient } from \"@supabase/supabase-js\";\nimport { getSupabaseServer } from \"@/lib/supabase.server\";\nimport { slugify } from \"@/lib/slug\";\nimport { NextResponse } from \"next/server\";\nimport { getTopicSuggestions } from \"@/lib/insights\";\nimport { toError } from \"@/lib/errors\";\n\ntype Topic = {\n  id: number;\n  topic: string;\n  intent?: string | null;\n  category?: string | null;\n  target_locality?: string | null;\n  target_postcode_prefix?: string | null;\n};\n\ntype GeneratedPayload = {\n  meta?: {\n    title?: string;\n    excerpt?: string;\n    category?: string;\n    tags?: string[];\n    hero_image?: string | null;\n    heroImageHint?: string | null;\n    readingTime?: number | null;\n    wordCount?: number | null;\n    sources?: any;\n    seoTitle?: string | null;\n    seoDescription?: string | null;\n    locality?: string | null;\n    postcodePrefix?: string | null;\n    lat?: number | null;\n    lon?: number | null;\n    ogImage?: string | null;\n  };\n  content?: string;\n  markdown?: string;\n};\n\nconst MIN_WORDS = 900;\n\n// Cache for trending topics (refresh every hour)\nlet trendingTopicsCache: { topics: string[]; timestamp: number } | null = null;\nconst CACHE_DURATION = 60 * 60 * 1000; // 1 hour\n\nasync function getTrendingTopicsForPrompt(): Promise<string> {\n  const now = Date.now();\n  \n  // Use cache if recent\n  if (trendingTopicsCache && (now - trendingTopicsCache.timestamp) < CACHE_DURATION) {\n    return formatTrendingTopics(trendingTopicsCache.topics);\n  }\n  \n  // Fetch fresh trends\n  try {\n    const topics = await getTopicSuggestions();\n    trendingTopicsCache = { topics, timestamp: now };\n    return formatTrendingTopics(topics);\n  } catch (error) {\n    console.error(\"Failed to fetch trending topics:\", error);\n    return \"\";\n  }\n}\n\nfunction formatTrendingTopics(topics: string[]): string {\n  if (topics.length === 0) return \"\";\n  \n  return `\\n\\nRECENT USER INTERESTS (use these to influence topic relevance):\\n${topics.map((t, i) => `${i + 1}. ${t}`).join('\\n')}`;\n}\n\nfunction buildUserPrompt(topic: Topic, trendingContext: string = \"\") {\n  return `Write a long-form UK parenting article for the Parent Helper Journal.${trendingContext}\\n\\nTOPIC: ${topic.topic}\\n${topic.intent ? `INTENT: ${topic.intent}\\n` : \"\"}\\nAudience: UK parents and carers. Voice: warm, well-educated British parent; supportive, practical, never condescending.\\nLength: 1,200-1,700 words (minimum ${MIN_WORDS} words).\\nTone: supportive, knowledgeable, and encouraging. Format with headings, bullets, and a 2-sentence intro summary.\\nStructure: punchy hook intro; H2/H3 subheads; short paragraphs; bullet lists; one pull quote; finish with an actionable checklist.\\nInclude 2-4 internal link placeholders like [link:classes/sensory] or [link:blog/sleep].\\nInclude 4-7 reputable UK sources (NHS, BBC, GOV.UK, universities) and return them as an array of objects in the JSON payload.\\nIf locality is provided (${topic.target_locality ?? \"none\"}), include a short \"Getting started in ${topic.target_locality}\" box with universally helpful tips (no invented venues).\\nFocus on topics local parents are searching for recently, based on analytics data.\\nReturn strictly valid JSON matching:\\n{\\n  \"meta\": {\"title\": string, \"excerpt\": string, \"category\": string, \"tags\": string[], \"hero_image\": string | null, \"seoTitle\": string, \"seoDescription\": string, \"locality\": string | null, \"postcodePrefix\": string | null, \"sources\": [{\"title\": string, \"url\": string}] },\\n  \"content\": \"Markdown here\"\\n}.\\nDo not include backticks or extra text.`;\n}\n\nasync function callOpenAI(topic: Topic, trendingContext: string = \"\", attempt = 1): Promise<GeneratedPayload> {\n  if (!process.env.OPENAI_API_KEY) {\n    throw new Error(\"OPENAI_API_KEY not configured\");\n  }\n\n  const response = await fetch(\"https://api.openai.com/v1/chat/completions\", {\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      Authorization: `Bearer ${process.env.OPENAI_API_KEY}`,\n    },\n    body: JSON.stringify({\n      model: process.env.OPENAI_MODEL ?? \"gpt-4o-mini\",\n      response_format: { type: \"json_object\" },\n      messages: [\n        {\n          role: \"system\",\n          content:\n            \"You are a British parent writing for Parent Helper. Never mention AI, cite NHS/BBC/GOV.UK sources, keep tone supportive and practical. Focus on topics that local parents are actively searching for and engaging with.\",\n        },\n        {\n          role: \"user\",\n          content: buildUserPrompt(topic, trendingContext),\n        },\n      ],\n      temperature: 0.7,\n      max_tokens: 3200,\n    }),\n  });\n\n  if (!response.ok) {\n    const error = await response.text();\n    throw new Error(`OpenAI error: ${error}`);\n  }\n\n  const json = await response.json();\n  const content = json?.choices?.[0]?.message?.content;\n  if (!content) throw new Error(\"No content returned\");\n  let parsed: GeneratedPayload;\n  try {\n    parsed = JSON.parse(content);\n  } catch (error) {\n    if (attempt === 1) {\n      return callOpenAI(topic, trendingContext, attempt + 1);\n    }\n    throw new Error(\"Failed to parse model response as JSON\");\n  }\n  return parsed;\n}\n\nasync function pickTopic(sb: SupabaseClient<any>, topicId?: number) {\n  if (topicId) {\n    const { data } = await sb\n      .from(\"blog_topics_queue\")\n      .select(\"*\")\n      .eq(\"id\", topicId)\n      .maybeSingle();\n    return data as Topic | null;\n  }\n  const { data } = await sb\n    .from(\"blog_topics_queue\")\n    .select(\"*\")\n    .eq(\"status\", \"pending\")\n    .order(\"priority\", { ascending: false })\n    .order(\"scheduled_for\", { ascending: true })\n    .limit(1)\n    .maybeSingle();\n  return (data as Topic | null) ?? null;\n}\n\nfunction countWords(markdown: string) {\n  return markdown\n    .replace(/[#*_`>\\-]/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim()\n    .split(\" \")\n    .filter(Boolean).length;\n}\n\nasync function ensureUniqueSlug(\n  sb: SupabaseClient<any>,\n  desired: string,\n  excludeId?: string,\n) {\n  let candidate = desired;\n  let suffix = 1;\n  // eslint-disable-next-line no-constant-condition -- intentional loop that returns once a unique slug is found\n  while (true) {\n    const { data } = await sb\n      .from(\"blog_posts_ai\")\n      .select(\"id\")\n      .eq(\"slug\", candidate)\n      .limit(1)\n      .maybeSingle();\n    if (!data || (excludeId && data.id === excludeId)) {\n      return candidate;\n    }\n    suffix += 1;\n    candidate = `${desired}-${suffix}`;\n  }\n}\n\nfunction normaliseSources(value: unknown) {\n  if (!Array.isArray(value)) return [];\n  return value\n    .map((entry) => {\n      if (typeof entry === \"string\") {\n        return { title: entry, url: entry };\n      }\n      if (entry && typeof entry === \"object\") {\n        const { title, url } = entry as Record<string, string>;\n        if (!url) return null;\n        return {\n          title: title ?? url,\n          url,\n        };\n      }\n      return null;\n    })\n    .filter(Boolean);\n}\n\nexport async function POST(req: Request) {\n  const { topicId, trendSource } = await req.json().catch(() => ({}));\n  const sb = getSupabaseServer();\n  if (!sb) {\n    return NextResponse.json({ error: \"Supabase not configured\" }, { status: 500 });\n  }\n  const topic = await pickTopic(sb, topicId);\n\n  if (!topic) {\n    return NextResponse.json({ error: \"No topics pending\" }, { status: 404 });\n  }\n\n  await sb.from(\"blog_topics_queue\").update({ status: \"in_progress\" }).eq(\"id\", topic.id);\n\n  try {\n    // Get trending topics for context\n    const trendingContext = await getTrendingTopicsForPrompt();\n    const result = await callOpenAI(topic, trendingContext);\n    const markdown = (result.content ?? result.markdown ?? \"\").trim();\n    if (!markdown) {\n      throw new Error(\"Model returned empty content\");\n    }\n\n    const wordCount = result.meta?.wordCount ?? countWords(markdown);\n    if (wordCount < MIN_WORDS) {\n      // attempt one retry\n      const retry = await callOpenAI(topic, trendingContext, 2);\n      const retryContent = (retry.content ?? retry.markdown ?? \"\").trim();\n      if (!retryContent) {\n        throw new Error(\"Model returned empty content on retry\");\n      }\n      const retryWords = retry.meta?.wordCount ?? countWords(retryContent);\n      if (retryWords > wordCount) {\n        result.meta = retry.meta;\n        result.content = retryContent;\n        result.markdown = retryContent;\n      }\n    }\n\n    // Store the trend source if provided\n    const trendSourceValue = trendSource || null;\n\n    const meta = result.meta ?? {};\n    const title = meta.title?.trim() || topic.topic;\n    const excerpt = (meta.excerpt || result.content?.slice(0, 240) || \"\")\n      .replace(/\\s+/g, \" \")\n      .trim();\n    const category = meta.category || topic.category || \"Parenting Advice\";\n    const baseSlug = slugify(title) || `post-${topic.id}-${Date.now()}`;\n    const slug = await ensureUniqueSlug(sb, baseSlug);\n    const resolvedMarkdown = result.content ?? result.markdown ?? \"\";\n    const finalWordCount = countWords(resolvedMarkdown);\n    const readingTime = meta.readingTime ?? Math.max(1, Math.round(finalWordCount / 225));\n\n    const { data, error } = await sb\n      .from(\"blog_posts_ai\")\n      .insert({\n        status: \"draft\",\n        title,\n        slug,\n        excerpt,\n        category,\n        tags: Array.isArray(meta.tags) ? meta.tags : [],\n        hero_image: meta.hero_image ?? meta.heroImageHint ?? null,\n        body_markdown: resolvedMarkdown,\n        reading_time_minutes: readingTime,\n        word_count: finalWordCount,\n        sources: normaliseSources(meta.sources),\n        locality: meta.locality ?? topic.target_locality ?? null,\n        postcode_prefix: meta.postcodePrefix ?? topic.target_postcode_prefix ?? null,\n        lat: meta.lat ?? null,\n        lon: meta.lon ?? null,\n        seo_title: meta.seoTitle ?? title,\n        seo_description: meta.seoDescription ?? excerpt,\n        og_image: meta.ogImage ?? null,\n        trend_source: trendSourceValue,\n      })\n      .select()\n      .single();\n\n    if (error) throw toError(error);\n\n    await sb\n      .from(\"blog_topics_queue\")\n      .update({ status: \"done\", scheduled_for: null })\n      .eq(\"id\", topic.id);\n\n    return NextResponse.json({ ok: true, post: data });\n  } catch (error: any) {\n    const err = toError(error);\n    await sb\n      .from(\"blog_topics_queue\")\n      .update({ status: \"error\" })\n      .eq(\"id\", topic.id);\n    return NextResponse.json({ error: err.message ?? \"Generation failed\" }, { status: 500 });\n  }\n}\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/blog/topics/trends/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/book/start-with-wallet/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/book/start/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'createSupabaseRouteHandlerClient' is defined but never used. Allowed unused vars must match /^(?:_|[A-Z].*)$/u.","line":3,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":3,"endColumn":42}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { NextRequest, NextResponse } from \"next/server\";\nimport { getSupabaseServer } from \"@/lib/supabase.server\";\nimport { createSupabaseRouteHandlerClient } from \"@/lib/supabase/ssr\";\nimport { getStripe } from \"@/lib/stripe\";\nimport { isBookingsFeatureEnabled } from \"@/lib/env\";\nimport { z } from \"zod\";\n\nexport const dynamic = \"force-dynamic\";\n\nconst startBookingSchema = z.object({\n  classId: z.coerce.number(),\n  occurrenceId: z.coerce.number(),\n  parentName: z.string().min(1, \"Parent name is required\"),\n  parentEmail: z.string().email(\"Valid email is required\"),\n  parentPhone: z.string().min(10, \"Phone number is required\"),\n  childName: z.string().min(1, \"Child name is required\"),\n  childAge: z.coerce.number().min(0).max(18),\n  reward_id: z.string().uuid().optional(),\n  coupon_id: z.string().optional(),\n});\n\nexport async function POST(req: NextRequest) {\n  if (!isBookingsFeatureEnabled()) {\n    return NextResponse.json({ error: \"Bookings feature is disabled\" }, { status: 403 });\n  }\n\n  try {\n    const body = await req.json();\n    const parsed = startBookingSchema.safeParse(body);\n\n    if (!parsed.success) {\n      return NextResponse.json(\n        { error: parsed.error.errors[0]?.message ?? \"Invalid booking data\" },\n        { status: 400 }\n      );\n    }\n\n    const { classId, occurrenceId, parentName, parentEmail, parentPhone, childName, childAge, reward_id, coupon_id } = parsed.data;\n\n    const supabase = getSupabaseServer();\n    if (!supabase) {\n      return NextResponse.json({ error: \"Server error\" }, { status: 500 });\n    }\n\n    // Verify class and occurrence exist and are bookable\n    const { data: occurrence, error: occurrenceError } = await supabase\n      .from(\"session_instances\")\n      .select(\n        `\n        id,\n        starts_at,\n        ends_at,\n        capacity,\n        available_spots,\n        bookable,\n        class_sessions!inner(\n          id,\n          classes!inner(\n            id,\n            name,\n            price,\n            booking_price,\n            provider_id,\n            providers!inner(\n              id,\n              name,\n              contact_email\n            )\n          )\n        )\n      `\n      )\n      .eq(\"id\", occurrenceId)\n      .eq(\"class_sessions.classes.id\", classId)\n      .single();\n\n    if (occurrenceError || !occurrence) {\n      return NextResponse.json({ error: \"Class or occurrence not found\" }, { status: 404 });\n    }\n\n    const classData = (occurrence.class_sessions as any)?.classes;\n    const providerData = classData?.providers;\n\n    if (!classData || !providerData) {\n      return NextResponse.json({ error: \"Class data not found\" }, { status: 404 });\n    }\n\n    if (!occurrence.bookable) {\n      return NextResponse.json({ error: \"This occurrence is not available for booking\" }, { status: 400 });\n    }\n\n    // Check availability\n    if (occurrence.capacity && occurrence.available_spots !== null && occurrence.available_spots <= 0) {\n      return NextResponse.json({ error: \"No spots available\" }, { status: 400 });\n    }\n\n    // Calculate price (use booking_price if available, otherwise parse from price field)\n    const bookingPrice = classData.booking_price\n      ? Number(classData.booking_price)\n      : classData.price\n        ? parseFloat(classData.price.replace(/[^0-9.]/g, \"\")) || 0\n        : 0;\n\n    if (bookingPrice <= 0) {\n      return NextResponse.json({ error: \"Invalid price for this class\" }, { status: 400 });\n    }\n\n    const amountCents = Math.round(bookingPrice * 100);\n    const commissionRate = 0.07; // 7% commission\n    const commissionCents = Math.round(amountCents * commissionRate);\n    const providerAmountCents = amountCents - commissionCents;\n\n    // Create pending booking request\n    const { data: bookingRequest, error: bookingError } = await supabase\n      .from(\"booking_requests\")\n      .insert({\n        class_id: classId,\n        provider_id: providerData.id,\n        parent_name: parentName,\n        parent_email: parentEmail,\n        parent_phone: parentPhone,\n        child_name: childName,\n        child_age: childAge,\n        booking_type: \"single\",\n        sessions_requested: 1,\n        session_instance_id: occurrenceId,\n        currency: \"gbp\",\n        total_amount: (amountCents / 100).toFixed(2),\n        commission_amount: (commissionCents / 100).toFixed(2),\n        provider_amount: (providerAmountCents / 100).toFixed(2),\n        status: \"pending\",\n        payment_status: \"pending\",\n        expires_at: new Date(Date.now() + 30 * 60 * 1000).toISOString(), // 30 minutes\n      })\n      .select()\n      .single();\n\n    if (bookingError || !bookingRequest) {\n      console.error(\"Error creating booking request:\", bookingError);\n      return NextResponse.json({ error: \"Failed to create booking\" }, { status: 500 });\n    }\n\n    // Validate coupon if provided\n    let validatedCouponId: string | undefined;\n    if (coupon_id) {\n      const stripe = getStripe();\n      try {\n        const coupon = await stripe.coupons.retrieve(coupon_id);\n        \n        // Validate coupon is still valid\n        if (coupon.valid === false) {\n          return NextResponse.json(\n            { error: \"The selected reward coupon is no longer valid\" },\n            { status: 400 }\n          );\n        }\n\n        // Check expiration\n        if (coupon.redeem_by && coupon.redeem_by < Math.floor(Date.now() / 1000)) {\n          return NextResponse.json(\n            { error: \"The selected reward coupon has expired\" },\n            { status: 400 }\n          );\n        }\n\n        // Check max redemptions\n        if (\n          coupon.max_redemptions &&\n          coupon.times_redeemed >= coupon.max_redemptions\n        ) {\n          return NextResponse.json(\n            { error: \"The selected reward coupon has reached its redemption limit\" },\n            { status: 400 }\n          );\n        }\n\n        validatedCouponId = coupon_id;\n      } catch (stripeError: any) {\n        if (stripeError.code === \"resource_missing\") {\n          return NextResponse.json(\n            { error: \"Invalid reward coupon\" },\n            { status: 400 }\n          );\n        }\n        console.error(\"[POST /api/book/start] Coupon validation error:\", stripeError);\n        return NextResponse.json(\n          { error: \"Failed to validate reward coupon\" },\n          { status: 500 }\n        );\n      }\n    }\n\n    // Create Stripe Checkout Session\n    const stripe = getStripe();\n    const siteUrl = process.env.NEXT_PUBLIC_APP_URL || \"http://localhost:3000\";\n\n    const sessionConfig: any = {\n      payment_method_types: [\"card\"],\n      line_items: [\n        {\n          price_data: {\n            currency: \"gbp\",\n            product_data: {\n              name: classData.name || \"Class Booking\",\n              description: `Booking for ${childName} (age ${childAge})`,\n            },\n            unit_amount: amountCents,\n          },\n          quantity: 1,\n        },\n      ],\n      mode: \"payment\",\n      success_url: `${siteUrl}/book/thank-you?session_id={CHECKOUT_SESSION_ID}`,\n      cancel_url: `${siteUrl}/class/${classId}?canceled=true`,\n      customer_email: parentEmail,\n      metadata: {\n        booking_request_id: String(bookingRequest.id),\n        class_id: String(classId),\n        occurrence_id: String(occurrenceId),\n        provider_id: String(providerData.id),\n        ...(reward_id && { reward_id: String(reward_id) }),\n        ...(validatedCouponId && { coupon_id: String(validatedCouponId) }),\n      },\n      expires_at: Math.floor(Date.now() / 1000) + 30 * 60, // 30 minutes\n    };\n\n    // Add discount if coupon is provided and validated\n    if (validatedCouponId) {\n      sessionConfig.discounts = [{ coupon: validatedCouponId }];\n    }\n\n    const session = await stripe.checkout.sessions.create(sessionConfig);\n\n    // Update booking request with Stripe session ID\n    await supabase\n      .from(\"booking_requests\")\n      .update({ stripe_payment_intent_id: session.id })\n      .eq(\"id\", bookingRequest.id);\n\n    return NextResponse.json({\n      ok: true,\n      checkoutUrl: session.url,\n      bookingRequestId: bookingRequest.id,\n    });\n  } catch (error: any) {\n    console.error(\"Error in POST /api/book/start:\", error);\n    return NextResponse.json({ error: error.message || \"Internal server error\" }, { status: 500 });\n  }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/book/webhook/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/boosts/checkout/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'product' is assigned a value but never used. Allowed unused vars must match /^(?:_|[A-Z].*)$/u.","line":78,"column":11,"nodeType":null,"messageId":"unusedVar","endLine":78,"endColumn":18}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { NextResponse } from \"next/server\";\nimport { z } from \"zod\";\nimport { getStripe } from \"@/lib/stripe\";\nimport { createClient } from \"@/lib/supabase/server\";\nimport { getActiveMembershipForUser } from \"@/app/provider/_lib/membership\";\n\nconst requestSchema = z.object({\n  classId: z.number().int().positive(),\n  plan: z.enum([\"BOOST_WEEKLY\", \"BOOST_MONTHLY\"]),\n  successUrl: z.string().url().optional(),\n  cancelUrl: z.string().url().optional(),\n});\n\n// Stripe Product IDs - these should be created in Stripe Dashboard\nconst BOOST_PRODUCTS = {\n  BOOST_WEEKLY: process.env.STRIPE_BOOST_WEEKLY_PRODUCT_ID || \"prod_boost_weekly\",\n  BOOST_MONTHLY: process.env.STRIPE_BOOST_MONTHLY_PRODUCT_ID || \"prod_boost_monthly\",\n};\n\nexport async function POST(req: Request) {\n  try {\n    const stripe = getStripe();\n    const supabase = createClient();\n    const body = await req.json();\n    const payload = requestSchema.parse(body);\n\n    // Authenticate provider\n    const {\n      data: { session },\n    } = await supabase.auth.getSession();\n\n    if (!session?.user) {\n      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    }\n\n    const membership = await getActiveMembershipForUser(supabase, session.user.id);\n    if (!membership || !membership.providers) {\n      return NextResponse.json({ error: \"No active provider membership\" }, { status: 403 });\n    }\n\n    const providerId = membership.providers.id;\n\n    // Verify class belongs to provider\n    const { data: classData, error: classError } = await supabase\n      .from(\"classes\")\n      .select(\"id, name, provider_id\")\n      .eq(\"id\", payload.classId)\n      .eq(\"provider_id\", providerId)\n      .single();\n\n    if (classError || !classData) {\n      return NextResponse.json({ error: \"Class not found or access denied\" }, { status: 404 });\n    }\n\n    // Check for existing active boost\n    const { data: existingBoost } = await supabase\n      .from(\"class_boosts\")\n      .select(\"id, status, expires_at\")\n      .eq(\"class_id\", payload.classId)\n      .eq(\"status\", \"active\")\n      .gt(\"expires_at\", new Date().toISOString())\n      .single();\n\n    if (existingBoost) {\n      return NextResponse.json(\n        { error: \"This class already has an active boost\" },\n        { status: 400 }\n      );\n    }\n\n    // Get product ID\n    const productId = BOOST_PRODUCTS[payload.plan];\n    if (!productId) {\n      return NextResponse.json({ error: \"Invalid boost plan\" }, { status: 400 });\n    }\n\n    // 