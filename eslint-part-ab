ount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { NextRequest, NextResponse } from \"next/server\";\nimport { createSupabaseRouteHandlerClient } from \"@/lib/supabase\";\nimport { isMagicLinkSigninEnabled } from \"@/lib/env\";\nimport { sendTransactional } from \"@/lib/emails/sendTransactional\";\n\nexport const dynamic = \"force-dynamic\";\nexport const runtime = \"nodejs\";\n\nconst MAGIC_LINK_RATE_LIMIT_MS = 30_000; // 30 seconds\nconst rateLimitMap = new Map<string, number>();\n\nfunction checkRateLimit(email: string): boolean {\n  const now = Date.now();\n  const lastSent = rateLimitMap.get(email);\n  if (lastSent && now - lastSent < MAGIC_LINK_RATE_LIMIT_MS) {\n    return false;\n  }\n  rateLimitMap.set(email, now);\n  return true;\n}\n\nexport async function POST(req: NextRequest) {\n  if (!isMagicLinkSigninEnabled()) {\n    return NextResponse.json(\n      { error: \"Magic link sign-in is disabled\" },\n      { status: 503 }\n    );\n  }\n\n  try {\n    const body = await req.json().catch(() => ({}));\n    const { email, next } = body;\n\n    if (!email || typeof email !== \"string\") {\n      return NextResponse.json(\n        { error: \"Email is required\" },\n        { status: 400 }\n      );\n    }\n\n    // Rate limiting\n    if (!checkRateLimit(email.toLowerCase())) {\n      return NextResponse.json(\n        { error: \"Please wait before requesting another magic link\" },\n        { status: 429 }\n      );\n    }\n\n    const supabase = createSupabaseRouteHandlerClient(req, NextResponse.next());\n\n    // Generate magic link - Supabase will send the email automatically\n    // Configure emailRedirectTo in Supabase dashboard to point to /auth/callback\n    const redirectUrl = new URL(\n      `/auth/callback?next=${encodeURIComponent(next || \"/onboarding/child\")}`,\n      process.env.NEXT_PUBLIC_APP_URL || \"http://localhost:3000\"\n    );\n\n    const { data, error } = await supabase.auth.signInWithOtp({\n      email: email.toLowerCase(),\n      options: {\n        emailRedirectTo: redirectUrl.toString(),\n        shouldCreateUser: true,\n      },\n    });\n\n    if (error) throw error;\n\n    // Note: Supabase sends the magic link email automatically\n    // Make sure to configure the email template in Supabase dashboard\n    // and set Site URL to match your domain\n\n    return NextResponse.json({\n      success: true,\n      message: \"Magic link sent to your email\",\n    });\n  } catch (error: any) {\n    console.error(\"[api/auth/magic-link] Error:\", error);\n    return NextResponse.json(\n      { error: error?.message ?? \"Failed to send magic link\" },\n      { status: 500 }\n    );\n  }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/auth/user/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/billing/checkout/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/billing/plans/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/billing/portal/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErro