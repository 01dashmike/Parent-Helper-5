 Verify admin authentication\n */\nasync function verifyAdmin(): Promise<boolean> {\n  const cookieStore = await cookies();\n  const cookieSecret = cookieStore.get(\"ph_admin\")?.value;\n  return !!(process.env.ADMIN_SECRET && cookieSecret === process.env.ADMIN_SECRET);\n}\n\n/**\n * GET /api/admin/rewards\n * \n * List rewards with optional filters:\n * - user_id: Filter by user ID\n * - status: Filter by status (available, redeemed, expired)\n * - from_date: Filter by creation date (ISO string)\n * - to_date: Filter by creation date (ISO string)\n * - limit: Limit results (default: 100)\n * - offset: Pagination offset (default: 0)\n */\nexport async function GET(request: NextRequest) {\n  if (!(await verifyAdmin())) {\n    return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n  }\n\n  const supabase = createClient();\n\n  try {\n    const { searchParams } = new URL(request.url);\n    const userId = searchParams.get(\"user_id\");\n    const status = searchParams.get(\"status\");\n    const fromDate = searchParams.get(\"from_date\");\n    const toDate = searchParams.get(\"to_date\");\n    const limit = parseInt(searchParams.get(\"limit\") || \"100\", 10);\n    const offset = parseInt(searchParams.get(\"offset\") || \"0\", 10);\n\n    let query = supabase\n      .from(\"rewards\")\n      .select(`\n        id,\n        user_id,\n        source,\n        points,\n        value_cents,\n        status,\n        metadata,\n        created_at\n      `)\n      .order(\"created_at\", { ascending: false })\n      .range(offset, offset + limit - 1);\n\n    if (userId) {\n      query = query.eq(\"user_id\", userId);\n    }\n\n    if (status) {\n      query = query.eq(\"status\", status);\n    }\n\n    if (fromDate) {\n      query = query.gte(\"created_at\", fromDate);\n    }\n\n    if (toDate) {\n      query = query.lte(\"created_at\", toDate);\n    }\n\n    const { data: rewards, error: rewardsError } = await query;\n\n    if (rewardsError) {\n      console.error(\"[admin/rewards] Error fetching rewards:\", rewardsError);\n      return NextResponse.json(\n        { error: \"Failed to fetch rewards\" },\n        { status: 500 }\n      );\n    }\n\n    // Get user emails for display\n    const userIds = [...new Set(rewards?.map((r: any) => r.user_id) || [])];\n    const userEmailMap = new Map<string, string>();\n\n    if (userIds.length > 0) {\n      // Get user emails from auth.users via admin API\n      for (const uid of userIds) {\n        try {\n          const { data: user } = await supabase.auth.admin.getUserById(String(uid));\n          if (user?.user?.email) {\n            userEmailMap.set(String(uid), user.user.email);\n          }\n        } catch (error) {\n          // Skip if user not found\n        }\n      }\n    }\n\n    // Get total count for pagination\n    let countQuery = supabase.from(\"rewards\").select(\"id\", { count: \"exact\", head: true });\n    if (userId) countQuery = countQuery.eq(\"user_id\", userId) as any;\n    if (status) countQuery = countQuery.eq(\"status\", status) as any;\n    if (fromDate) countQuery = countQuery.gte(\"created_at\", fromDate) as any;\n    if (toDate) countQuery = countQuery.lte(\"created_at\", toDate) as any;\n\n    const { count } = await countQuery;\n\n    const rewardsWithEmails = rewards?.map((reward: any) => ({\n      ...reward,\n      user_email: userEmailMap.get(reward.user_id) || null,\n    }));\n\n    return NextResponse.json({\n      rewards: rewardsWithEmails || [],\n      total: count || 0,\n      limit,\n      offset,\n    });\n  } catch (error: any) {\n    console.error(\"[admin/rewards] Error:\", error);\n    return NextResponse.json(\n      { error: error.message || \"Internal server error\" },\n      { status: 500 }\n    );\n  }\n}\n\n/**\n * POST /api/admin/rewards\n * \n * Create a manual reward\n * \n * Body:\n * - user_id: UUID (required)\n * - value_cents: number (required)\n * - points: number (optional, defaults to value_cents)\n * - source: string (optional, defaults to \"manual\")\n * - status: string (optional, defaults to \"available\")\n * - reason: string (optional, for metadata)\n * - metadata: object (optional, additional metadata)\n */\nconst createRewardSchema = z.object({\n  user_id: z.string().uuid(),\n  value_cents: z.number().int().min(0),\n  points: z.number().int().min(0).optional(),\n  source: z.string().optional().default(\"manual\"),\n  status: z.enum([\"pending\", \"available\", \"redeemed\", \"expired\"]).optional().default(\"available\"),\n  reason: z.string().optional(),\n  metadata: z.record(z.any()).optional(),\n});\n\nexport async function POST(request: NextRequest) {\n  if (!(await verifyAdmin())) {\n    return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n  }\n\n  const supabase = createClient();\n\n  try {\n    const body = await request.json();\n    const validated = createRewardSchema.parse(body);\n\n    // Build metadata\n    const metadata: Record<string, any> = {\n      source: validated.source,\n      ...validated.metadata,\n    };\n\n    if (validated.reason) {\n      metadata.reason = validated.reason;\n      metadata.admin_created = true;\n      metadata.created_reason = validated.reason;\n    }\n\n    const { data: reward, error: rewardError } = await supabase\n      .from(\"rewards\")\n      .insert({\n        user_id: validated.user_id,\n        value_cents: validated.value_cents,\n        points: validated.points || validated.value_cents,\n        source: validated.source,\n        status: validated.status,\n        metadata,\n      })\n      .select()\n      .single();\n\n    if (rewardError) {\n      console.error(\"[admin/rewards] Error creating reward:\", rewardError);\n      return NextResponse.json(\n        { error: \"Failed to create reward\" },\n        { status: 500 }\n      );\n    }\n\n    return NextResponse.json({\n      success: true,\n      reward,\n    });\n  } catch (error: any) {\n    if (error instanceof z.ZodError) {\n      return NextResponse.json(\n        { error: \"Invalid request\", details: error.errors },\n        { status: 400 }\n      );\n    }\n\n    console.error(\"[admin/rewards] Error:\", error);\n    return NextResponse.json(\n      { error: error.message || \"Internal server error\" },\n      { status: 500 }\n    );\n  }\n}\n\n/**\n * PATCH /api/admin/rewards\n * \n * Update a reward\n * \n * Body:\n * - id: UUID (required)\n * - status: string (optional)\n * - value_cents: number (optional)\n * - points: number (optional)\n * - metadata: object (optional, will merge with existing)\n */\nconst updateRewardSchema = z.object({\n  id: z.string().uuid(),\n  status: z.enum([\"pending\", \"available\", \"redeemed\", \"expired\"]).optional(),\n  value_cents: z.number().int().min(0).optional(),\n  points: z.number().int().min(0).optional(),\n  metadata: z.record(z.any()).optional(),\n});\n\nexport async function PATCH(request: NextRequest) {\n  if (!(await verifyAdmin())) {\n    return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n  }\n\n  const supabase = createClient();\n\n  try {\n    const body = await request.json();\n    const validated = updateRewardSchema.parse(body);\n\n    // Get existing reward to merge metadata\n    const { data: existingReward, error: fetchError } = await supabase\n      .from(\"rewards\")\n      .select(\"metadata\")\n      .eq(\"id\", validated.id)\n      .single();\n\n    if (fetchError || !existingReward) {\n      return NextResponse.json(\n        { error: \"Reward not found\" },\n        { status: 404 }\n      );\n    }\n\n    // Merge metadata\n    const existingMetadata = (existingReward.metadata as Record<string, any>) || {};\n    const updatedMetadata = validated.metadata\n      ? { ...existingMetadata, ...validated.metadata }\n      : existingMetadata;\n\n    // Build update object\n    const updateData: Record<string, any> = {};\n    if (validated.status !== undefined) updateData.status = validated.status;\n    if (validated.value_cents !== undefined) updateData.value_cents = validated.value_cents;\n    if (validated.points !== undefined) updateData.points = validated.points;\n    if (validated.metadata !== undefined) updateData.metadata = updatedMetadata;\n\n    const { data: reward, error: updateError } = await supabase\n      .from(\"rewards\")\n      .update(updateData)\n      .eq(\"id\", validated.id)\n      .select()\n      .single();\n\n    if (updateError) {\n      console.error(\"[admin/rewards] Error updating reward:\", updateError);\n      return NextResponse.json(\n        { error: \"Failed to update reward\" },\n        { status: 500 }\n      );\n    }\n\n    return NextResponse.json({\n      success: true,\n      reward,\n    });\n  } catch (error: any) {\n    if (error instanceof z.ZodError) {\n      return NextResponse.json(\n        { error: \"Invalid request\", details: error.errors },\n        { status: 400 }\n      );\n    }\n\n    console.error(\"[admin/rewards] Error:\", error);\n    return NextResponse.json(\n      { error: error.message || \"Internal server error\" },\n      { status: 500 }\n    );\n  }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/admin/security/block-ip/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/admin/security/unblock-ip/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Docum