ent) * 100 \n      : 0;\n\n    // Referrals by type\n    const referralsByType = {\n      member: memberRefs.length,\n      provider: providerRefs.length,\n    };\n\n    // Top referrers leaderboard (member referrals)\n    const referrerCounts = new Map<string, { count: number; conversions: number }>();\n    memberRefs.forEach((ref) => {\n      const userId = ref.referrer_user_id;\n      if (!referrerCounts.has(userId)) {\n        referrerCounts.set(userId, { count: 0, conversions: 0 });\n      }\n      const stats = referrerCounts.get(userId)!;\n      stats.count++;\n      if (ref.status === \"converted\") {\n        stats.conversions++;\n      }\n    });\n\n    const topReferrers = Array.from(referrerCounts.entries())\n      .map(([userId, stats]) => ({\n        user_id: userId,\n        referrals_sent: stats.count,\n        conversions: stats.conversions,\n        conversion_rate: stats.count > 0 ? (stats.conversions / stats.count) * 100 : 0,\n      }))\n      .sort((a, b) => b.referrals_sent - a.referrals_sent)\n      .slice(0, 10);\n\n    // Provider-specific metrics\n    const totalProviderReferrals = providerRefs.length;\n    const providerConversions = providerRefs.filter((r) => \n      r.status === \"first_booking\" || r.status === \"listing_created\"\n    ).length;\n    const providerConversionRate = totalProviderReferrals > 0 \n      ? (providerConversions / totalProviderReferrals) * 100 \n      : 0;\n\n    // Provider reward coupons issued (discount type or has stripe_coupon_id)\n    const providerCouponsIssued = providerRewardsList.filter((r) => \n      r.reward_type === \"discount\"\n    ).length;\n\n    // Provider leaderboard (ordered by referrals sent)\n    const providerReferralCounts = new Map<number, { count: number; conversions: number; name: string; slug: string }>();\n    providerRefs.forEach((ref) => {\n      const providerId = ref.provider_id;\n      if (!providerReferralCounts.has(providerId)) {\n        const provider = providersList.find(