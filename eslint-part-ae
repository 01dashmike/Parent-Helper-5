rom(\"referrals\")\n            .select(\"id, reward_status\")\n            .eq(\"referrer_user_id\", userId);\n\n        const referredCount = referrals?.length || 0;\n        const convertedCount = referrals?.filter((r) => r.reward_status === \"earned\" || r.reward_status === \"redeemed\").length || 0;\n\n        return NextResponse.json({\n            success: true,\n            data: {\n                points: totalPoints,\n                value_cents: availableValueCents,\n                earned_value_cents: earnedValueCents,\n                redeemed_value_cents: redeemedValueCents,\n                referred_count: referredCount,\n                converted_count: convertedCount,\n                rewards: rewards || [],\n            },\n        });\n    } catch (error: any) {\n        console.error(\"[GET /api/rewards/summary] Unexpected error:\", error);\n        return NextResponse.json(\n            { error: error.message || \"Internal server error\" },\n            { status: 500 }\n        );\n    }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/rewards/validate-coupon/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/search/alerts/weekly/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'userIds' is assigned a value but never used. Allowed unused vars must match /^(?:_|[A-Z].*)$/u.","line":113,"column":11,"nodeType":null,"messageId":"unusedVar","endLine":113,"endColumn":18}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { NextRequest, NextResponse } from \"next/server\";\nimport { createServerClient } from \"@/lib/supabase/server\";\nimport { isWeeklyAlertsEnabled } from \"@/lib/env\";\nimport { sendTransactional } from \"@/lib/emails/sendTransactional\";\n\nexport const dynamic = \"force-dynamic\";\nexport const runtime = \"nodejs\";\n\n// This endpoint should be protected with a secret token or cron job authentication\nconst CRON_SECRET = process.env.CRON_SECRET || process.env.VERCEL_CRON_SECRET;\n\nfunction parseSearchQuery(query: string): {\n  q?: string;\n  town?: string;\n  age?: string;\n  [key: string]: string | undefined;\n} {\n  const params = new URLSearchParams(query);\n  const result: Record<string, string> = {};\n  params.forEach((value, key) => {\n    result[key] = value;\n  });\n  return result;\n}\n\nasync function findMatchingClasses(\n  supabase: ReturnType<typeof createServerClient>,\n  searchQuery: string,\n  town: string | null,\n  filters: Record<string, any> | null,\n  sinceDate: Date | null\n): Promise<Array<{ id: number; title: string; town: string | null; category: string | null }>> {\n  const params = parseSearchQuery(searchQuery);\n  const q = params.q || \"\";\n  const age = params.age || \"\";\n\n  let query = supabase.from(\"classes\").select(\"id, title, town, category, description\").limit(20);\n\n  // Apply filters\n  if (q) {\n    const likeValue = `%${q}%`;\n    query = query.or(`title.ilike.${likeValue},name.ilike.${likeValue},description.ilike.${likeValue}`);\n  }\n\n  if (town) {\n    query = query.ilike(\"town\", `%${town}%`);\n  }\n\n  if (age) {\n    query = query.ilike(\"age_range\", `%${age}%`);\n  }\n\n  // Filter by created_at if sinceDate is provided\n  if (sinceDate) {\n    query = query.gte(\"created_at\", sinceDate.toISOString());\n  }\n\n  const { data, error } = await query;\n  if (error) {\n    console.error(\"[alerts/weekly] Error querying classes:\", error);\n    return [];\n  }\n\n  return (data || []).map((item) => ({\n    id: item.id,\n    title: item.title || item.name || \"Untitled Class\",\n    town: item.town || null,\n    category: item.category || null,\n  }));\n}\n\nexport async function GET(req: NextRequest) {\n  // Verify cron secret if provided\n  const authHeader = req.headers.get(\"authorization\");\n  if (CRON_SECRET && authHeader !== `Bearer ${CRON_SECRET}`) {\n    // Allow Vercel Cron requests (they include a special header)\n    const cronHeader = req.headers.get(\"x-vercel-cron\");\n    if (!cronHeader) {\n      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    }\n  }\n\n  if (!isWeeklyAlertsEnabled()) {\n    return NextResponse.json(\n      { error: \"Weekly alerts feature is disabled\" },\n      { status: 503 }\n    );\n  }\n\n  try {\n    const supabase = createServerClient();\n    if (!supabase) {\n      throw new Error(\"Supabase client not available\");\n    }\n\n    // Find all active saved searches with weekly alerts\n    const { data: searches, error: searchesError } = await supabase\n      .from(\"saved_searches\")\n      .select(\"id, user_id, query, town, filters, last_alert_at, alert_frequency\")\n      .eq(\"is_active\", true)\n      .eq(\"alert_frequency\", \"weekly\");\n\n    if (searchesError) throw searchesError;\n    if (!searches || searches.length === 0) {\n      return NextResponse.json({\n        success: true,\n        message: \"No active weekly alerts found\",\n        processed: 0,\n      });\n    }\n\n    // Get user emails\n    const userIds = Array.from(new Set(searches.map((s) => s.user_id)));\n    const { data: users, error: usersError } = await supabase.auth.admin.listUsers();\n    if (usersError) {\n      console.error(\"[alerts/weekly] Error fetching users:\", usersError);\n    }\n\n    const userEmailMap = new Map<string, string>();\n    users?.users.forEach((user) => {\n      if (user.email) {\n        userEmailMap.set(user.id, user.email);\n      }\n    });\n\n    let processed = 0;\n    let emailsSent = 0;\n    let errors = 0;\n\n    for (const search of searches) {\n      try {\n        const sinceDate = search.last_alert_at ? new Date(search.last_alert_at) : null;\n        const matchingClasses = await findMatchingClasses(\n          supabase,\n          search.query,\n          search.town,\n          search.filters,\n          sinceDate\n        );\n\n        if (matchingClasses.length === 0) {\n          continue; // No new classes, skip\n        }\n\n        const userEmail = userEmailMap.get(search.user_id);\n        if (!userEmail) {\n          console.warn(`[alerts/weekly] No email found for user ${search.user_id}`);\n          continue;\n        }\n\n        // Build email content\n        const townDisplay = search.town || \"your area\";\n        const previewClass = matchingClasses[0];\n        const classList = matchingClasses.slice(0, 5).map((c) => ({\n          title: c.title,\n          town: c.town || townDisplay,\n          category: c.category || \"Class\",\n        }));\n\n        const viewAllUrl = new URL(\n          `/search?${search.query}`,\n          process.env.NEXT_PUBLIC_APP_URL || \"http://localhost:3000\"\n        );\n\n        const unsubscribeUrl = new URL(\n          `/account/searches?unsubscribe=${search.id}`,\n          process.env.NEXT_PUBLIC_APP_URL || \"http://localhost:3000\"\n        );\n\n        const emailResult = await sendTransactional({\n          to: userEmail,\n          subject: `New classes near ${townDisplay} this week 🎨`,\n          html: `\n            <!DOCTYPE html>\n            <html>\n            <head>\n              <meta charset=\"utf-8\">\n              <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n            </head>\n            <body style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;\">\n              <div style=\"background: #f9f9f9; border-radius: 8px; padding: 24px; margin-bottom: 24px;\">\n                <h1 style=\"color: #2d5016; margin-top: 0;\">New classes near ${townDisplay} this week 🎨</h1>\n                <p>We found <strong>${matchingClasses.length}</strong> new ${matchingClasses.length === 1 ? \"class\" : \"classes\"} matching your saved search!</p>\n                \n                <div style=\"margin: 24px 0;\">\n                  ${classList\n                    .map(\n                      (c) => `\n                    <div style=\"background: white; border-left: 3px solid #2d5016; padding: 12px; margin-bottom: 12px; border-radius: 4px;\">\n                      <h3 style=\"margin: 0 0 4px 0; color: #2d5016;\">${c.title}</h3>\n                      <p style=\"margin: 0; font-size: 14px; color: #666;\">${c.category} • ${c.town}</p>\n                    </div>\n                  `\n                    )\n                    .join(\"\")}\n                </div>\n\n                ${matchingClasses.length > 5 ? `<p style=\"color: #666; font-size: 14px;\">And ${matchingClasses.length - 5} more...</p>` : \"\"}\n\n                <div style=\"text-align: center; margin: 32px 0;\">\n                  <a href=\"${viewAllUrl.toString()}\" style=\"display: inline-block; background: #2d5016; color: white; text-decoration: none; padding: 12px 24px; border-radius: 6px; font-weight: 600;\">View all on Parent Helper</a>\n                </div>\n\n                <hr style=\"border: none; border-top: 1px solid #ddd; margin: 24px 0;\" />\n\n                <p style=\"font-size: 12px; color: #999; text-align: center; margin-bottom: 0;\">\n                  <a href=\"${unsubscribeUrl.toString()}\" style=\"color: #999; text-decoration: underline;\">Unsubscribe from these alerts</a>\n                </p>\n              </div>\n              <p style=\"font-size: 12px; color: #999; text-align: center;\">Parent Helper - Connecting families with trusted baby and toddler activities</p>\n            </body>\n            </html>\n          `,\n          text: `New classes near ${townDisplay} this week!\\n\\nWe found ${matchingClasses.length} new ${matchingClasses.length === 1 ? \"class\" : \"classes\"} matching your saved search.\\n\\n${classList.map((c) => `• ${c.title} (${c.category}, ${c.town})`).join(\"\\n\")}\\n\\n${matchingClasses.length > 5 ? `And ${matchingClasses.length - 5} more...\\n` : \"\"}\\nView all: ${viewAllUrl.toString()}\\n\\nUnsubscribe: ${unsubscribeUrl.toString()}`,\n          type: \"weekly_digest\",\n        });\n\n        if (emailResult.ok) {\n          // Update last_alert_at\n          await supabase\n            .from(\"saved_searches\")\n            .update({ last_alert_at: new Date().toISOString() })\n            .eq(\"id\", search.id);\n\n          // Log to alerts_log\n          await supabase.from(\"alerts_log\").insert({\n            saved_search_id: search.id,\n            count_classes: matchingClasses.length,\n            preview_class: previewClass.title,\n          });\n\n          emailsSent++;\n        } else {\n          console.error(`[alerts/weekly] Failed to send email to ${userEmail}:`, emailResult.error);\n          errors++;\n        }\n\n        processed++;\n      } catch (error: any) {\n        console.error(`[alerts/weekly] Error processing search ${search.id}:`, error);\n        errors++;\n      }\n    }\n\n    return NextResponse.json({\n      success: true,\n      message: `Processed ${processed} searches, sent ${emailsSent} emails`,\n      processed,\n      emailsSent,\n      errors,\n    });\n  } catch (error: any) {\n    console.error(\"[api/search/alerts/weekly] Error:\", error);\n    return NextResponse.json(\n      { error: error?.message ?? \"Failed to process weekly alerts\" },\n      { status: 500 }\n    );\n  }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-