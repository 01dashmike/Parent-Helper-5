ery: string;\n  town: string;\n  age: string;\n};\n\ntype DbClassRecord = {\n  id: number;\n  title?: string | null;\n  name?: string | null;\n  description?: string | null;\n  latitude?: number | string | null;\n  longitude?: number | string | null;\n  category?: string | null;\n  main_category?: string | null;\n  town?: string | null;\n  age_range?: string | null;\n  provider_id?: number | null;\n  is_featured?: boolean;\n  featured_status?: string | null;\n  featured_priority?: number | null;\n  featured_starts_at?: string | null;\n  featured_ends_at?: string | null;\n  popularity?: number | null;\n  review_count?: number | null;\n};\n\ntype FeaturedListingRecord = {\n  class_id: number;\n  status: string;\n  daily_cap: number | null;\n  daily_spend_cents: number | null;\n  monthly_budget_cents: number | null;\n  provider_subscription_id: number | null;\n  starts_at: string | null;\n  ends_at: string | null;\n};\n\ntype ClassBoostRecord = {\n  class_id: number;\n  plan: string;\n  status: string;\n  expires_at: string;\n};\n\ntype ProviderRecord = {\n  id: number;\n  current_plan_id: number | null;\n  billing_status: string | null;\n};\n\ntype PlanRecord = {\n  id: number;\n  slug: string;\n  featured_boost: number | null;\n  includes_featured: boolean;\n};\n\nfunction normalize(value: string | null): string {\n  return (value ?? \"\").trim().toLowerCase();\n}\n\nfunction buildFilters(url: URL): SearchFilters & { childId?: string; latitude?: number; longitude?: number; radius?: number } {\n  const lat = url.searchParams.get(\"lat\");\n  const lng = url.searchParams.get(\"lng\");\n  const radius = url.searchParams.get(\"radius\");\n  \n  return {\n    query: normalize(url.searchParams.get(\"q\")),\n    town: normalize(url.searchParams.get(\"town\")),\n    age: normalize(url.searchParams.get(\"age\")),\n    childId: url.searchParams.get(\"childId\") || undefined,\n    latitude: lat ? parseFloat(lat) : undefined,\n    longitude: lng ? parseFloat(lng) : undefined,\n    radius: radius ? parseInt(radius, 10) : undefined,\n  };\n}\n\nfunction matchesFilter(value: string | null | undefined, filter: string) {\n  if (!filter) return true;\n  if (!value) return false;\n  return value.toLowerCase().includes(filter);\n}\n\nfunction filterDemoClasses(filters: SearchFilters): ClassResult[] {\n  return demoClasses\n    .filter((item) => {\n      const matchesQuery =\n        matchesFilter(item.title, filters.query) ||\n        matchesFilter(item.description, filters.query) ||\n        matchesFilter(item.category, filters.query);\n\n      const matchesTown = matchesFilter(item.town, filters.town);\n      const matchesAge = matchesFilter(item.age_range, filters.age);\n\n      return matchesQuery && matchesTown && matchesAge;\n    })\n    .slice(0, 50);\n}\n\nfunction isWithinRange(now: Date, startAt: string | null, endAt: string | null) {\n  const startsOk = !startAt || new Date(startAt) <= now;\n  const endsOk = !endAt || new Date(endAt) >= now;\n  return startsOk && endsOk;\n}\n\nfunction hasBudgetCapacity(listing: FeaturedListingRecord | undefined) {\n  if (!listing) return true;\n  if (listing.status !== \"active\") return false;\n\n  const dailyCap = listing.daily_cap ?? 0;\n  const dailySpend = listing.daily_spend_cents ?? 0;\n  if (dailyCap > 0 && dailySpend >= dailyCap) {\n    return false;\n  }\n\n  const monthlyBudget = listing.monthly_budget_cents ?? 0;\n  if (monthlyBudget > 0 && dailySpend > monthlyBudget) {\n    return false;\n  }\n\n  return true;\n}\n\nfunction computeScore(params: {\n  classItem: DbClassRecord;\n  plan: PlanRecord | undefined;\n  listing: FeaturedListingRecord | undefined;\n  boost: ClassBoostRecord | undefined;\n  now: Date;\n}) {\n  const { classItem, plan, listing, boost, now } = params;\n\n  const popularity = Number(classItem.popularity ?? 0);\n  const reviewCount = Number(classItem.review_count ?? 0);\n  const featuredPriority = Number(classItem.featured_priority ?? 0);\n\n  const isFeaturedFlag =\n    Boolean(classItem.is_featured) &&\n    (classItem.featured_status ?? \"standard\") === \"active\" &&\n    isWithinRange(now, classItem.featured_starts_at ?? null, classItem.featured_ends_at ?? null) &&\n    hasBudgetCapacity(listing);\n\n  const planBoost = plan?.includes_featured ? Number(plan.featured_boost ?? 0) : 0;\n\n  // Check for active class boost (paid boost)\n  const hasActiveBoost = Boolean(\n    boost &&\n    boost.status === \"active\" &&\n    new Date(boost.expires_at) > now\n  );\n\n  // Boost priority: paid boosts > plan boosts > featured flag\n  const isBoosted = hasActiveBoost || Boolean(isFeaturedFlag && planBoost > 0);\n\n  let score = popularity * 2 + reviewCount;\n\n  if (hasActiveBoost && boost) {\n    // Paid boosts get highest priority\n    const boostMultiplier = boost.plan === \"BOOST_MONTHLY\" ? 2000 : 1500;\n    score += boostMultiplier + featuredPriority * 20;\n  } else if (isBoosted) {\n    score += 1000 + planBoost + featuredPriority * 10;\n  } else if (isFeaturedFlag) {\n    score += 500 + featuredPriority * 5;\n  } else {\n    score += featuredPriority;\n  }\n\n  return { score, isBoosted, isFeaturedFlag, hasActiveBoost };\n}\n\nfunction mapClassToResult(params: {\n  classItem: DbClassRecord;\n  plan: PlanRecord | undefined;\n  listing: FeaturedListingRecord | undefined;\n  score: number;\n  isBoosted: boolean;\n  isFeaturedFlag: boolean;\n  now: Date;\n}): ClassResult {\n  const { classItem, plan, listing, score, isBoosted, isFeaturedFlag, now } = params;\n\n  const latitudeRaw = classItem.latitude;\n  const longitudeRaw = classItem.longitude;\n  const latitude =\n    typeof latitudeRaw === \"string\"\n      ? Number.parseFloat(latitudeRaw)\n      : typeof latitudeRaw === \"number\"\n        ? latitudeRaw\n        : null;\n  const longitude =\n    typeof longitudeRaw === \"string\"\n      ? Number.parseFloat(longitudeRaw)\n      : typeof longitudeRaw === \"number\"\n        ? longitudeRaw\n        : null;\n\n  const title = classItem.title ?? classItem.name ?? \"Parent Helper class\";\n  const description = classItem.description ?? null;\n  const category = classItem.category ?? classItem.main_category ?? null;\n  const town = classItem.town ?? null;\n  const ageRange = classItem.age_range ?? null;\n\n  const budgetOk = hasBudgetCapacity(listing);\n  const windowActive = isWithinRange(\n    now,\n    classItem.featured_starts_at ?? null,\n    classItem.featured_ends_at ?? null,\n  );\n\n  return {\n    id: classItem.id,\n    title,\n    description,\n    latitude,\n    longitude,\n    category,\n    town,\n    age_range: ageRange,\n    searchScore: score,\n    featured: {\n      isBoosted,\n      hasPlan: Boolean(plan?.includes_featured),\n      planSlug: plan?.slug ?? null,\n      budgetOk,\n      windowActive,\n      listingStatus: listing?.status ?? (isFeaturedFlag ? \"active\" : null),\n    },\n  };\n}\n\nfunction calculateAgeMonths(birthdate: string): number {\n  const birth = new Date(birthdate);\n  const now = new Date();\n  const years = now.getFullYear() - birth.getFullYear();\n  const months = now.getMonth() - birth.getMonth();\n  return years * 12 + months;\n}\n\n/**\n * Optimized geospatial search using PostGIS ST_DWithin\n * Uses GIST spatial index for fast distance queries\n * Falls back to text-based search if coordinates unavailable\n */\nasync function fetchSupabaseGeospatial(\n  filters: SearchFilters & { \n    childId?: string; \n    latitude?: number; \n    longitude?: number; \n    radius?: number;\n  },\n): Promise<ClassResult[] | null> {\n  if (!hasSupabaseServerEnv()) {\n    return null;\n  }\n\n  try {\n    const supabase = createClient();\n    \n    // If coordinates provided, use optimized geospatial query\n    if (filters.latitude && filters.longitude) {\n      const radiusKm = filters.radius || 10; // Default 10km radius\n      \n      // Parse age filter if provided\n      let ageMin: number | undefined;\n      let ageMax: number | undefined;\n      if (filters.age) {\n        // Try to parse age range (e.g., \"0-12\", \"12-24\")\n        const ageMatch = filters.age.match(/(\\d+)-(\\d+)/);\n        if (ageMatch) {\n          ageMin = parseInt(ageMatch[1], 10);\n          ageMax = parseInt(ageMatch[2], 10);\n        }\n      }\n      \n      // Use optimized PostGIS function (now uses materialized view internally)\n      const { data: geospatialResults, error: geoError } = await supabase\n        .rpc(\"search_classes_adaptive_radius\", {\n          p_latitude: filters.latitude,\n          p_longitude: filters.longitude,\n          p_category: filters.query || null,\n          p_age_min: ageMin || null,\n          p_age_max: ageMax || null,\n          p_limit: 50,\n          p_offset: 0,\n        });\n      \n      if (!geoError && geospatialResults && geospatialResults.length > 0) {\n        // Map geospatial results to ClassResult format\n        // Note: We still need to fetch full class data and related tables for scoring\n        const classIds = geospatialResults.map((r: any) => r.id);\n        return await enrichClassResults(supabase, classIds, filters);\n      }\n      \n      // If geospatial search fails, fall through to text-based search\n      console.warn(\"[fetchSupabaseGeospatial] Geospatial search failed, falling back:\", geoError);\n    }\n    \n    // Fallback to text-based search (existing implementation)\n    return await fetchSupabaseTextSearch(supabase, filters);\n  } catch (error) {\n    console.error(\"[/api/search] Geospatial search error:\", error);\n    return null;\n  }\n}\n\n/**\n * Text-based search (original implementation)\n * Used when coordinates are not available\n */\nasync function fetchSupabaseTextSearch(\n  supabase: ReturnType<typeof createClient>,\n  filters: SearchFilters & { childId?: string },\n): Promise<ClassResult[] | null> {\n  try {\n    let query = supabase.from(\"classes\").select(\"*\").limit(100);\n\n    // If childId is provided, fetch child data and apply personalized filters\n    let ageMonths: number | null = null;\n    let childInterests: string[] = [];\n\n    if (filters.childId && process.env.CHILD_PROFILES_ENABLED === \"true\") {\n      try {\n        // Fetch child data (RLS will ensure user can only access their own children)\n        const { data: child } = await supabase\n          .from(\"children\")\n          .select(`\n            birthdate, \n            interests, \n            child_preferences (\n              tags\n            )\n          `)\n          .eq(\"id\", filters.childId)\n          .single();\n\n        if (child && child.birthdate) {\n          ageMonths = calculateAgeMonths(child.birthdate);\n          childInterests = child.interests || [];\n          if (Array.isArray(child.child_preferences) && child.child_preferences.length > 0) {\n            const prefTags = child.child_preferences[0]?.tags || [];\n            childInterests = [...childInterests, ...prefTags];\n          }\n        }\n      } catch (error) {\n        console.error(\"[fetchSupabase] Error fetching child data:\", error);\n        // Continue without child filtering\n      }\n    }\n\n    if (filters.query) {\n      const likeValue = `%${filters.query}%`;\n      query = query.or(\n        `title.ilike.${likeValue},name.ilike.${likeValue},description.ilike.${likeValue}`,\n      );\n    }\n    if (filters.town) query = query.ilike(\"town\", `%${filters.town}%`);\n\n    // Use child's age if available, otherwise use age filter\n    if (ageMonths !== null) {\n      query = query.gte(\"age_group_max\", ageMonths).lte(\"age_group_min\", ageMonths);\n    } else if (filters.age) {\n      query = query.ilike(\"age_range\", `%${filters.age}%`);\n    }\n\n    const { data: classRows, error: classesError } = await query;\n    if (classesError) throw classesError;\n    if (!Array.isArray(classRows) || classRows.length === 0) return [];\n\n    const classes = classRows as DbClassRecord[];\n\n    const classIds = classes.map((item) => item.id).filter((id) => typeof id === \"number\");\n    const providerIds = classes\n      .map((item) => item.provider_id)\n      .filter((id): id is number => typeof id === \"number\");\n\n    const [listingsResult, providersResult, boostsResult] = await Promise.all([\n      classIds.length\n        ? supabase\n          .from(\"featured_listings\")\n          .select(\"*\")\n          .in(\"class_id\", classIds)\n        : Promise.resolve({ data: [] as FeaturedListingRecord[] }),\n      providerIds.length\n        ? supabase\n          .from(\"providers\")\n          .select(\"id, current_plan_id, billing_status\")\n          .in(\"id\", providerIds)\n        : Promise.resolve({ data: [] as ProviderRecord[] }),\n      classIds.length\n        ? supabase\n          .from(\"class_boosts\")\n          .select(\"class_id, plan, status, expires_at\")\n          .in(\"class_id\", classIds)\n          .eq(\"status\", \"active\")\n          .gt(\"expires_at\", new Date().toISOString())\n        : Promise.resolve({ data: [] as ClassBoostRecord[] }),\n    ]);\n\n    const listings =\n      (listingsResult.data as FeaturedListingRecord[] | null) ?? [];\n    const providers =\n      (providersResult.data as ProviderRecord[] | null) ?? [];\n    const boosts =\n      (boostsResult.data as ClassBoostRecord[] | null) ?? [];\n\n    const listingMap = new Map<number, FeaturedListingRecord>(\n      listings.map((listing) => [listing.class_id, listing]),\n    );\n    const providerMap = new Map<number, ProviderRecord>(\n      providers.map((provider) => [provider.id, provider]),\n    );\n    const boostMap = new Map<number, ClassBoostRecord>(\n      boosts.map((boost) => [boost.class_id, boost]),\n    );\n\n    const planIds = Array.from(\n      new Set(\n        providers\n          .map((provider) => provider.current_plan_id)\n          .filter((id): id is number => typeof id === \"number\"),\n      ),\n    );\n\n    let plans: PlanRecord[] = [];\n    if (planIds.length) {\n      const { data: planRows } = await supabase\n        .from(\"plans\")\n        .select(\"id, slug, featured_boost, includes_featured\")\n        .in(\"id\", planIds);\n      plans = (planRows as PlanRecord[] | null) ?? [];\n    }\n\n    const planMap = new Map<number, PlanRecord>(\n      plans.map((plan) => [plan.id, plan]),\n    );\n\n    const now = new Date();\n\n    // Boost score for classes matching child interests\n    const ranked = classes\n      .map((classItem) => {\n        const provider =\n          typeof classItem.provider_id === \"number\"\n            ? providerMap.get(classItem.provider_id)\n            : undefined;\n        const plan =\n          provider && typeof provider.current_plan_id === \"number\"\n            ? planMap.get(provider.current_plan_id)\n            : undefined;\n        const listing = listingMap.get(classItem.id);\n\n        const boost = boostMap.get(classItem.id);\n        const { score, isBoosted, isFeaturedFlag, hasActiveBoost } = computeScore({\n          classItem,\n          plan,\n          listing,\n          boost,\n          now,\n        });\n\n        // Boost score if class matches child interests\n        let personalizedScore = score;\n        if (childInterests.length > 0 && classItem.category) {\n          const categoryLower = classItem.category.toLowerCase();\n          const hasInterestMatch = childInterests.some((interest) =>\n            categoryLower.includes(interest.toLowerCase())\n          );\n          if (hasInterestMatch) {\n            personalizedScore += 100; // Boost personalized matches\n          }\n        }\n\n        return mapClassToResult({\n          classItem,\n          plan,\n          listing,\n          score: personalizedScore,\n          isBoosted,\n          isFeaturedFlag,\n          now,\n        });\n      })\n      .sort((a, b) => (b.searchScore ?? 0) - (a.searchScore ?? 0))\n      .slice(0, 50);\n\n    return ranked;\n  } catch (error) {\n    console.error(\"[/api/search] Text search error:\", error);\n    return null;\n  }\n}\n\n/**\n * Enrich geospatial search results with full class data and scoring\n */\nasync function enrichClassResults(\n  supabase: ReturnType<typeof createClient>,\n  classIds: number[],\n  filters: SearchFilters & { childId?: string },\n): Promise<ClassResult[] | null> {\n  try {\n    // Fetch full class data\n    const { data: classRows, error: classesError } = await supabase\n      .from(\"classes\")\n      .select(\"*\")\n      .in(\"id\", classIds);\n    \n    if (classesError || !classRows) {\n      throw classesError;\n    }\n    \n    const classes = classRows as DbClassRecord[];\n    \n    // Fetch related data (same as text search)\n    const providerIds = classes\n      .map((item) => item.provider_id)\n      .filter((id): id is number => typeof id === \"number\");\n    \n    const [listingsResult, providersResult, boostsResult] = await Promise.all([\n      supabase\n        .from(\"featured_listings\")\n        .select(\"*\")\n        .in(\"class_id\", classIds),\n      providerIds.length\n        ? supabase\n          .from(\"providers\")\n          .select(\"id, current_plan_id, billing_status\")\n          .in(\"id\", providerIds)\n        : Promise.resolve({ data: [] as ProviderRecord[] }),\n      supabase\n        .from(\"class_boosts\")\n        .select(\"class_id, plan, status, expires_at\")\n        .in(\"class_id\", classIds)\n        .eq(\"status\", \"active\")\n        .gt(\"expires_at\", new Date().toISOString()),\n    ]);\n    \n    const listings = (listingsResult.data as FeaturedListingRecord[] | null) ?? [];\n    const providers = (providersResult.data as ProviderRecord[] | null) ?? [];\n    const boosts = (boostsResult.data as ClassBoostRecord[] | null) ?? [];\n    \n    const listingMap = new Map<number, FeaturedListingRecord>(\n      listings.map((listing) => [listing.class_id, listing]),\n    );\n    const providerMap = new Map<number, ProviderRecord>(\n      providers.map((provider) => [provider.id, provider]),\n    );\n    const boostMap = new Map<number, ClassBoostRecord>(\n      boosts.map((boost) => [boost.class_id, boost]),\n    );\n    \n    const planIds = Array.from(\n      new Set(\n        providers\n          .map((provider) => provider.current_plan_id)\n          .filter((id): id is number => typeof id === \"number\"),\n      ),\n    );\n    \n    let plans: PlanRecord[] = [];\n    if (planIds.length) {\n      const { data: planRows } = await supabase\n        .from(\"plans\")\n        .select(\"id, slug, featured_boost, includes_featured\")\n        .in(\"id\", planIds);\n      plans = (planRows as PlanRecord[] | null) ?? [];\n    }\n    \n    const planMap = new Map<number, PlanRecord>(\n      plans.map((plan) => [plan.id, plan]),\n    );\n    \n    const now = new Date();\n    \n    // Map and score classes (preserve order from geospatial query)\n    const ranked = classes\n      .map((classItem) => {\n        const provider =\n          typeof classItem.provider_id === \"number\"\n            ? providerMap.get(classItem.provider_id)\n            : undefined;\n        const plan =\n          provider && typeof provider.current_plan_id === \"number\"\n            ? planMap.get(provider.current_plan_id)\n            : undefined;\n        const listing = listingMap.get(classItem.id);\n        const boost = boostMap.get(classItem.id);\n        \n        const { score, isBoosted, isFeaturedFlag } = computeScore({\n          classItem,\n          plan,\n          listing,\n          boost,\n          now,\n        });\n        \n        return mapClassToResult({\n          classItem,\n          plan,\n          listing,\n          score,\n          isBoosted,\n          isFeaturedFlag,\n          now,\n        });\n      })\n      .sort((a, b) => (b.searchScore ?? 0) - (a.searchScore ?? 0))\n      .slice(0, 50);\n    \n    return ranked;\n  } catch (error) {\n    console.error(\"[/api/search] Error enriching results:\", error);\n    return null;\n  }\n}\n\n/**\n * Legacy function name for backward compatibility\n */\nasync function fetchSupabase(\n  filters: SearchFilters & { childId?: string; latitude?: number; longitude?: number; radius?: number },\n): Promise<ClassResult[] | null> {\n  return fetchSupabaseGeospatial(filters);\n}\n\nexport async function GET(req: Request) {\n  try {\n    const url = new URL(req.url);\n    const filters = buildFilters(url);\n\n    // Generate cache key (returns null for personalized results)\n    const cacheKey = searchCache.generateKey({\n      latitude: filters.latitude,\n      longitude: filters.longitude,\n      radius: filters.radius,\n      query: filters.query,\n      town: filters.town,\n      age: filters.age,\n      childId: filters.childId,\n    });\n\n    // Try to get from cache (only for non-personalized queries)\n    const cached = cacheKey ? searchCache.get(cacheKey) : { hit: false };\n\n    if (cached.hit) {\n      // Fresh cache hit - return immediately\n      return NextResponse.json(\n        { results: cached.data },\n        {\n          headers: {\n            \"x-cache\": \"HIT\",\n          },\n        }\n      );\n    }\n\n    // Stale cache hit or cache miss - fetch fresh data\n    // For stale-while-revalidate, we could return stale data immediately\n    // but for simplicity, we'll just fetch fresh data\n    const supabaseResults = await fetchSupabaseGeospatial(filters);\n    \n    let results: ClassResult[];\n    if (Array.isArray(supabaseResults) && supabaseResults.length > 0) {\n      results = supabaseResults;\n    } else {\n      results = filterDemoClasses(filters);\n    }\n\n    // Store in cache (only for non-personalized queries)\n    if (cacheKey) {\n      searchCache.set(cacheKey, results);\n    }\n\n    // Return results with cache header\n    return NextResponse.json(\n      { results },\n      {\n        headers: {\n          \"x-cache\": \"MISS\",\n        },\n      }\n    );\n  } catch (error: any) {\n    console.error(\"[/api/search] Error:\", error);\n    return NextResponse.json(\n      { error: error?.message ?? \"Unable to fetch classes\" },\n      { \n        status: 500,\n        headers: {\n          \"x-cache\": \"MISS\",\n        },\n      },\n    );\n  }\n}\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/search/save/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/send/assistant/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/send/resources/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'req' is defined but never used. Allowed unused args must match /^_/u.","line":45,"column":28,"nodeType":null,"messageId":"unusedVar","endLine":45,"endColumn":31}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * API Route: SEND Resources\n * GET /api/send/resources?region=...\n * Fetches and caches SEND resources from trusted sources\n */\n\nimport { NextRequest, NextResponse } from \"next/server\";\nimport { createClient } from \"@/lib/supabase/server\";\n\nexport async function GET(req: NextRequest) {\n  try {\n    const supabase = await createClient();\n    const searchParams = req.nextUrl.searchParams;\n    const region = searchParams.get(\"region\");\n    const category = searchParams.get(\"category\");\n\n    let query = supabase.from(\"send_resources\").select(\"*\").order(\"updated_at\", { ascending: false });\n\n    if (region) {\n      query = query.or(`region.ilike.%${region}%,region.is.null`);\n    }\n\n    if (category) {\n      query = query.eq(\"category\", category);\n    }\n\n    const { data: resources, error } = await query.limit(100);\n\n    if (error) {\n      console.error(\"Error fetching SEND resources:\", error);\n      return NextResponse.json({ error: \"Failed to fetch resources\" }, { status: 500 });\n    }\n\n    return NextResponse.json({ resources: resources || [] });\n  } catch (error) {\n    console.error(\"Error in SEND resources API:\", error);\n    return NextResponse.json({ error: \"Internal server error\" }, { status: 500 });\n  }\n}\n\n/**\n * POST /api/send/resources/refresh\n * Manually refresh resources cache (admin only)\n */\nexport async function POST(req: NextRequest) {\n  try {\n    const supabase = await createClient();\n    \n    // Verify admin access\n    const {\n      data: { user },\n    } = await supabase.auth.getUser();\n\n    if (!user) {\n      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    }\n\n    // TODO: Check admin role\n\n    // Fetch resources from external sources\n    const resources = await fetchSendResources();\n\n    // Upsert into database\n    for (const resource of resources) {\n      await supabase.from(\"send_resources\").upsert(\n        {\n          title: resource.title,\n          summary: resource.summary,\n          category: resource.category,\n          url: resource.url,\n          region: resource.region,\n          source: resource.source,\n          updated_at: new Date().toISOString(),\n        },\n        { onConflict: \"url\" }\n      );\n    }\n\n    return NextResponse.json({ success: true, count: resources.length });\n  } catch (error) {\n    console.error(\"Error refreshing SEND resources:\", error);\n    retur