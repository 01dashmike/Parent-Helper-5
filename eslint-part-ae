ching (0-0.2 points)\n      // For now, we don't have user preferences, so we skip this\n      // Future: match against user's past bookings or preferences\n      score += 0.1; // Base category score\n\n      // Location bonus (0-0.1 points)\n      if (validatedRequest.location?.town && cls.town?.toLowerCase().includes(validatedRequest.location.town.toLowerCase())) {\n        score += 0.1;\n        reasons.push(`In ${cls.town}`);\n        distanceText = `Located in ${cls.town}`;\n      } else if (validatedRequest.location?.latitude && validatedRequest.location?.longitude && cls.latitude && cls.longitude) {\n        // Calculate approximate distance (simplified)\n        const lat1 = validatedRequest.location.latitude;\n        const lng1 = validatedRequest.location.longitude;\n        const lat2 = typeof cls.latitude === 'string' ? parseFloat(cls.latitude) : cls.latitude;\n        const lng2 = typeof cls.longitude === 'string' ? parseFloat(cls.longitude) : cls.longitude;\n        \n        // Simple distance calculation (Haversine would be more accurate)\n        const distanceKm = Math.sqrt(\n          Math.pow((lat2 - lat1) * 111, 2) + Math.pow((lng2 - lng1) * 111 * Math.cos(lat1 * Math.PI / 180), 2)\n        );\n        \n        if (distanceKm < 5) {\n          distanceText = `Less than 5km away`;\n        } else if (distanceKm < 10) {\n          distanceText = `About ${Math.round(distanceKm)}km away`;\n        } else {\n          distanceText = `About ${Math.round(distanceKm)}km away`;\n        }\n      }\n\n      // Ensure score is between 0 and 1\n      score = Math.max(0, Math.min(1, score));\n\n      // Build summary\n      const whySummary = [\n        ageMatchText,\n        distanceText,\n        popularityText,\n      ].filter(Boolean).join(\" • \");\n\n      return {\n        id: cls.id,\n        name: cls.name,\n        description: cls.description,\n        category: cls.category || cls.main_category,\n        town: cls.town,\n        postcode: cls.po