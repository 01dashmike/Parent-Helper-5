arningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { headers } from \"next/headers\";\nimport { NextResponse } from \"next/server\";\nimport Stripe from \"stripe\";\nimport { getStripe } from \"@/lib/stripe\";\nimport { createClient } from \"@/lib/supabase/server\";\nimport { sendTransactional } from \"@/lib/emails/sendTransactional\";\nimport { logActivity } from \"@/lib/activityLog\";\n\nexport const runtime = \"nodejs\";\nexport const dynamic = \"force-dynamic\";\n\nasync function logWebhookEvent(supabase: ReturnType<typeof createClient>, type: string, payload: any) {\n  await supabase.from(\"webhook_events\").insert({\n    type,\n    payload,\n  });\n}\n\nasync function sendBookingConfirmationEmails(\n  supabase: ReturnType<typeof createClient>,\n  booking: {\n    email: string;\n    occurrenceId: number;\n    amountCents: number;\n    currency: string;\n    bookingId?: string;\n  },\n  sessionId?: string\n) {\n  // Get user's referral code\n  const { getUserReferralCode } = await import(\"@/lib/referrals/getUserReferralCode\");\n  const referralCode = await getUserReferralCode(supabase, booking.email);\n  const referralUrl = referralCode \n    ? `${process.env.NEXT_PUBLIC_APP_URL || \"https://parenthelper.co.uk\"}/r/${referralCode}`\n    : null;\n  // Fetch occurrence details for email\n  const { data: occurrence } = await supabase\n    .from(\"session_instances\")\n    .select(\n      `\n      id,\n      starts_at,\n      ends_at,\n      class_sessions!inner(\n        id,\n        title,\n        classes!inner(\n          id,\n          name,\n          providers!inner(\n            id,\n            name,\n            contact_email\n          )\n        )\n      )\n    `\n    )\n    .eq(\"id\", booking.occurrenceId)\n    .single();\n\n  if (!occurrence) {\n    console.error(\"[webhook] Could not find occurrence for booking email\");\n    return;\n  }\n\n  const classData = occurrence.class_sessions?.classes;\n  const providerData = classData?.providers;\n  const sessionTitle = occurrence.class_sessions?.title || classData?.name || \"Class\";\n  const startsAt = occurrence.starts_at\n    ? new Date(occurrence.starts_at).toLocaleString(\"en-GB\", {\n      dateStyle: \"long\",\n      timeStyle: \"short\",\n    })\n    : \"TBC\";\n\n  const amount = booking.amountCents / 100;\n  const formattedAmount = new Intl.NumberFormat(\"en-GB\", {\n    style: \"currency\",\n    currency: booking.currency.toUpperCase() || \"GBP\",\n  }).format(amount);\n\n  // Get booking ID for review link\n  const reviewLink = booking.bookingId\n    ? `${process.env.NEXT_PUBLIC_APP_URL || \"https://parenthelper.co.uk\"}/review?booking_id=${booking.bookingId}`\n    : null;\n\n  // Customer confirmation email\n  const referralSection = referralCode && referralUrl ? `\n    <div style=\"margin: 30px 0; padding: 20px; background: #f0f7f0; border-radius: 8px; text-align: center;\">\n      <h3 style=\"margin: 0 0 12px; color: #2f2f2f; font-size: 18px;\">Invite another family and both of you get rewards! 🎁</h3>\n      <p style=\"margin: 0 0 16px; color: #666; font-size: 14px; line-height: 1.6;\">Share your referral code with friends and family. When they sign up and book, you both earn rewards!</p>\n      <div style=\"margin: 16px 0; padding: 12px; background: #ffffff; border-radius: 6px; border: 2px dashed #4f6f52;\">\n        <p style=\"margin: 0 0 8px; font-size: 12px; color: #666; text-transform: uppercase; letter-spacing: 0.5px;\">Your Referral Code</p>\n        <p style=\"margin: 0 0 12px; font-family: monospace; font-size: 20px; font-weight: 700; color: #4f6f52; letter-spacing: 2px;\">${referralCode}</p>\n        <a href=\"${referralUrl}\" style=\"display: inline-block; background-color: #4f6f52; color: #ffffff; text-decoration: none; padding: 10px 20px; border-radius: 6px; font-weight: 600; font-size: 14px;\">Share Your Link</a>\n      </div>\n      <p style=\"margin: 16px 0 0; font-size: 12px; color: #999;\">Your referral link: <a href=\"${referralUrl}\" style=\"color: #4f6f52; text-decoration: underline;\">${referralUrl}</a></p>\n      <p style=\"margin: 12px 0 0; font-size: 12px; color: #999;\"><a href=\"https://parenthelper.co.uk/referrals/info\" style=\"color: #4f6f52; text-decoration: underline;\">Learn more about our referral program</a></p>\n    </div>\n  ` : \"\";\n\n  const customerEmailHtml = `\n    <h2>Booking Confirmed</h2>\n    <p>Thank you for your booking!</p>\n    <div style=\"margin: 20px 0; padding: 15px; background: #f5f3f0; border-radius: 8px;\">\n      <p><strong>Class:</strong> ${sessionTitle}</p>\n      <p><strong>Date & Time:</strong> ${startsAt}</p>\n      <p><strong>Amount Paid:</strong> ${formattedAmount}</p>\n    </div>\n    <p>We look forward to seeing you!</p>\n    ${reviewLink ? `<p style=\"margin-top: 20px;\"><a href=\"${reviewLink}\" style=\"display: inline-block; padding: 10px 20px; background: #8B9A7A; color: white; text-decoration: none; border-radius: 5px;\">Share Your Experience</a></p>` : \"\"}\n    ${referralSection}\n  `;\n\n  try {\n    await sendTransactional({\n      to: booking.email,\n      subject: `Booking Confirmed: ${sessionTitle}`,\n      html: customerEmailHtml,\n      text: `Booking Confirmed\\n\\nClass: ${sessionTitle}\\nDate & Time: ${startsAt}\\nAmount Paid: ${formattedAmount}\\n\\nWe look forward to seeing you!${referralCode && referralUrl ? `\\n\\n🎁 Invite another family and both of you get rewards!\\n\\nShare your referral code with friends and family. When they sign up and book, you both earn rewards!\\n\\nYour Referral Code: ${referralCode}\\nYour Referral Link: ${referralUrl}\\n\\nShare your link: ${referralUrl}\\n\\nLearn more: https://parenthelper.co.uk/referrals/info` : \"\"}`,\n      type: \"booking_confirmation\",\n    });\n  } catch (error) {\n    console.error(\"[email-error]\", {\n      template: \"booking_confirmation\",\n      to: booking.email,\n      error: error instanceof Error ? error.message : String(error),\n    });\n  }\n\n  // Provider notification email\n  if (providerData?.contact_email) {\n    const providerEmailHtml = `\n      <h2>New Booking Received</h2>\n      <p>A new booking has been made for your class.</p>\n      <div style=\"margin: 20px 0; padding: 15px; background: #f5f3f0; border-radius: 8px;\">\n        <p><strong>Class:</strong> ${sessionTitle}</p>\n        <p><strong>Date & Time:</strong> ${startsAt}</p>\n        <p><strong>Customer Email:</strong> ${booking.email}</p>\n        <p><strong>Amount:</strong> ${formattedAmount}</p>\n      </div>\n    `;\n\n    try {\n      await sendTransactional({\n        to: providerData.contact_email,\n        subject: `New Booking: ${sessionTitle}`,\n        html: providerEmailHtml,\n      text: `New Booking\\n\\nClass: ${sessionTitle}\\nDate & Time: ${startsAt}\\nCustomer Email: ${booking.email}\\nAmount: ${formattedAmount}`,\n      type: \"provider_booking_notification\",\n      });\n    } catch (error) {\n      console.error(\"[email-error]\", {\n        template: \"provider_booking_notification\",\n        to: providerData.contact_email,\n        error: error instanceof Error ? error.message : String(error),\n      });\n    }\n  }\n}\n\nexport async function POST(req: Request) {\n  if (process.env.FEATURE_BOOKINGS !== \"true\") {\n    return NextResponse.json({ error: \"Not found\" }, { status: 404 });\n  }\n\n  const stripe = getStripe();\n  const headersList = await headers();\n  const signature = headersList.get(\"stripe-signature\");\n  const webhookSecret = process.env.STRIPE_WEBHOOK_SECRET;\n\n  if (!webhookSecret) {\n    console.error(\"[stripe/webhook] STRIPE_WEBHOOK_SECRET missing\");\n    return NextResponse.json({ error: \"Webhook secret not configured\" }, { status: 500 });\n  }\n\n  const rawBody = await req.text();\n  const supabase = createClient();\n\n  let event: Stripe.Event;\n  try {\n    event = stripe.webhooks.constructEvent(rawBody, signature ?? \"\", webhookSecret);\n  } catch (err) {\n    console.error(\"[stripe/webhook] Signature verification failed\", err);\n    await logWebhookEvent(supabase, \"signature_error\", { error: String(err) });\n    return NextResponse.json({ error: \"Invalid signature\" }, { status: 400 });\n  }\n\n  // Log webhook event\n  await logWebhookEvent(supabase, event.type, event.data.object);\n\n  try {\n    if (event.type === \"checkout.session.completed\") {\n      const session = event.data.object as Stripe.Checkout.Session;\n      \n      // Log activity\n      await logActivity({\n        eventType: \"stripe.payment.succeeded\",\n        scope: \"billing\",\n        level: \"info\",\n        title: \"Payment completed\",\n        description: `Checkout session: ${session.id}`,\n        metadata: {\n          sessionId: session.id,\n          amount: session.amount_total,\n          currency: session.currency,\n          customerEmail: session.customer_details?.email,\n        },\n      });\n\n      // Check if this is a Payment Link checkout\n      if (!session.payment_link) {\n        // Not a Payment Link checkout, skip\n        return NextResponse.json({ received: true });\n      }\n\n      // Check if booking already exists (idempotency)\n      const existingBooking = await supabase\n        .from(\"simple_bookings\")\n        .select(\"id\")\n        .eq(\"stripe_checkout_id\", session.id)\n        .single();\n\n      if (existingBooking.data) {\n        console.log(\"[stripe/webhook] Booking already exists, skipping\", session.id);\n        return NextResponse.json({ received: true, duplicate: true });\n      }\n\n      // Extract metadata or customer email\n      const customerEmail = session.customer_details?.email || session.customer_email;\n      if (!customerEmail) {\n        console.error(\"[stripe/webhook] No customer email in session\", session.id);\n        return NextResponse.json({ error: \"No customer email\" }, { status: 400 });\n      }\n\n      // Get amount from session\n      const amountTotal =