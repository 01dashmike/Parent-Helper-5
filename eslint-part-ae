 from \"@/lib/supabase.server\";\nimport { isAnalyticsRetentionEnabled } from \"@/lib/env\";\nimport { cookies } from \"next/headers\";\n\nasync function validateAdmin() {\n  const cookieStore = await cookies();\n  const cookieSecret = cookieStore.get(\"ph_admin\")?.value;\n  const adminSecret = process.env.ADMIN_SECRET;\n  if (!adminSecret || cookieSecret !== adminSecret) {\n    throw new Error(\"Unauthorized\");\n  }\n}\n\nexport const dynamic = \"force-dynamic\";\n\n/**\n * Calculate engagement scores for all families\n * Run this nightly via cron job\n */\nexport async function POST(req: NextRequest) {\n  try {\n    await validateAdmin();\n  } catch (error) {\n    return NextResponse.json({ error: \"Forbidden\" }, { status: 403 });\n  }\n\n  if (!isAnalyticsRetentionEnabled()) {\n    return NextResponse.json({ error: \"Analytics retention is disabled\" }, { status: 403 });\n  }\n\n  const supabase = getSupabaseServer();\n  if (!supabase) {\n    return NextResponse.json({ error: \"Server error\" }, { status: 500 });\n  }\n\n  try {\n    // Get all families with analytics events\n    const { data: families, error: familiesError } = await supabase\n      .from(\"family_profiles\")\n      .select(\"id, user_id\");\n\n    if (familiesError || !families) {\n      return NextResponse.json({ error: \"Failed to fetch families\" }, { status: 500 });\n    }\n\n    const results = [];\n\n    for (const family of families) {\n      // Calculate metrics from analytics_events\n      // Query by family_id or user_id\n      const query = supabase\n        .from(\"analytics_events\")\n        .select(\"event_name, created_at, event_props\")\n        .gte(\"created_at\", new Date(Date.now() - 90 * 24 * 60 * 60 * 1000).toISOString()); // Last 90 days\n\n      // Build OR condition\n      const conditions = [`family_id.eq.${family.id}`];\n      if (family.user_id) {\n        conditions.push(`user_id.eq.${family.user_id}`);\n      }\n\n      const { data: events } = await query.or(conditions.join(\",\"));\n\n      if (!events || events.length === 0) continue;\n\n      // Calculate metrics\n      const visitsCount = events.filter((e) => e.event_name === \"page_view\").length;\n      const recsClicked = events.filter((e) => e.event_name === \"recommendation_click\").length;\n      const blogReads = events.filter((e) => e.event_name === \"blog_read\").length;\n      const conversions = events.filter((e) => e.event_name === \"booking_completed\").length;\n\n      // Estimate session time (simplified - in production use proper session tracking)\n      const pageViews = events.filter((e) => e.event_name === \"page_view\");\n      const avgSessionTime = pageViews.length > 0 ? Math.round(pageViews.length * 120) : 0; // Estimate 2 min per page\n\n      // Calculate loyalty score (0-100 scale)\n      // Formula: (0.3*visits + 0.2*recs + 0.3*conversions + 0.2*session_time) / scaling\n      const maxVisits = 100; // Normalize to 100 max visits\n      const maxRecs = 50; // Normalize to 50 max recs\n      const maxConversions = 20; // Normalize to 20 max conversions\n      const maxSessionTime = 3600; // Normalize to 1 hour max\n\n      const normalizedVisits = Math.min(visitsCount / maxVisits, 1) * 100;\n      const normalizedRecs = Math.min(recsClicked / maxRecs, 1) * 100;\n      const normalizedConversions = Math.min(conversions / maxConversions, 1) * 100;\n      const normalizedSessionTime = Math.min(avgSessionTime / maxSessionTime, 1) * 100;\n\n      const loyaltyScore =\n        0.3 * normalizedVisits +\n        0.2 * normalizedRecs +\n        0.3 * normalizedConversions +\n        0.2 * normalizedSessionTime;\n\n      // Get last active timestamp\n      const lastEvent = events.sort(\n        (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()\n      )[0];\n      const lastActive = lastEvent?.created_at || new Date().toISOString();\n\n      // Upsert engagement score\n      const { error: upsertError } = await supabase\n        .from(\"engagement_scores\")\n        .upsert(\n          {\n            family_id: family.id,\n            visits_count: visitsCount,\n            avg_session_time: avgSessionTime,\n            last_active: lastActive,\n            recs_clicked: recsClicked,\n            blog_reads: blogReads,\n            conversions: conversions,\n            loyalty_score: Math.round(loyaltyScore * 100) / 100,\n            updated_at: new Date().toISOString(),\n          },\n          {\n            onConflict: \"family_id\",\n          }\n        );\n\n      if (upsertError) {\n        console.error(`Error upserting engagement score for family ${family.id}:`, upsertError);\n        continue;\n      }\n\n      results.push({\n        familyId: family.id,\n        loyaltyScore: Math.round(loyaltyScore * 100) / 100,\n        visitsCount,\n        conversions,\n      });\n    }\n\n    return NextResponse.json({\n      ok: true,\n      processed: results.length,\n      results: results.sort((a, b) => b.loyaltyScore - a.loyaltyScore).slice(0, 10), // Top 10\n    });\n  } catch (error: any) {\n    console.error(\"Error calculating engagement scores:\", error);\n    return NextResponse.json({ error: \"Internal server error\" }, { status: 500 });\n  }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/retention/send-reactivation/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'req' is defined but never used. Allowed unused args must match /^_/u.","line":22,"column":28,"nodeType":null,"messageId":"unusedVar","endLine":22,"endColumn":31},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'error' is defined but never used.","line":25,"column":12,"nodeType":null,"messageId":"unusedVar","endLine":25,"endColumn":17}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2