eward_id is required\" },\n                { status: 400 }\n            );\n        }\n\n        // Fetch reward\n        const { data: reward, error: rewardError } = await supabase\n            .from(\"rewards\")\n            .select(\"*\")\n            .eq(\"id\", reward_id)\n            .eq(\"user_id\", session.user.id)\n            .eq(\"status\", \"available\")\n            .single();\n\n        if (rewardError || !reward) {\n            return NextResponse.json(\n                { error: \"Reward not found or not available\" },\n                { status: 404 }\n            );\n        }\n\n        // Parse existing metadata (may be legacy format)\n        const existingMetadata = reward.metadata as RewardMetadata | Record<string, any> | null;\n        \n        // Prevent duplicate redemption: check if coupon already exists in metadata\n        if (existingMetadata?.stripe_coupon_id) {\n            return NextResponse.json({\n                success: true,\n                data: {\n                    reward_id: reward.id,\n                    value_cents: reward.value_cents,\n                    status: \"redeemed\",\n                    stripe_coupon_id: existingMetadata.stripe_coupon_id,\n                },\n            });\n        }\n\n        // Create Stripe coupon\n        const stripe = getStripe();\n        \n        // Calculate redeem_by: use reward.expires_at if available, otherwise now + 90 days\n        let redeemBy: number;\n        if (existingMetadata?.expires_at) {\n            const expiresAt = new Date(existingMetadata.expires_at);\n            redeemBy = Math.floor(expiresAt.getTime() / 1000);\n        } else {\n            const now = new Date();\n            now.setDate(now.getDate() + 90);\n            redeemBy = Math.floor(now.getTime() / 1000);\n        }\n\n        let couponId: string;\n        try {\n            const coupon = await stripe.coupons.create({\n                amount_off: reward.value_cents,\n                currency: \"gbp\",\n                duration: \"once\",\n                redeem_by: redeemBy,\n            });\n            couponId = coupon.id;\n        } catch (stripeError: any) {\n            console.error(\"[POST /api/rewards/redeem] Stripe coupon creation error:\", stripeError);\n            return NextResponse.json(\n                { error: \"Failed to create Stripe coupon\" },\n                { status: 500 }\n            );\n        }\n\n        // Update reward status and store coupon ID in metadata (preserve canonical structure)\n        // Ensure source field exists (required for canonical structure)\n        const source = existingMetadata?.source || reward.source as \"referral\" | \"booking\" | \"milestone\" | \"provider_referral\";\n        \n        const updatedMetadata: RewardMetadata = rewardMetadataSchema.parse({\n            source,\n            ...existingMetadata,\n            stripe_coupon_id: couponId,\n            booking_id: booking_id || existingMetadata?.booking_id || undefined,\n            expires_at: existingMetadata?.expires_at || new Date(Date.now() + 90 * 24 * 60 * 60 * 1000).toISOString(),\n            redeemed_at: new Date().toISOString(), // Additional field for tracking (not in canonical schema but allowed via passthrough)\n        });\n\n        const { error: updateError } = await supabase\n            .from(\"rewards\")\n            .update({\n                status: \"redeemed\",\n                metadata: updatedMetadata,\n            })\n            .eq(\"id\", reward_id);\n\n        if (updateError) {\n            console.error(\"[POST /api/rewards/redeem] Update error:\", updateError);\n            return NextResponse.json(\n                { error: \"Failed to redeem reward\" },\n                { status: 500 }\n            );\n        }\n\n        // Track reward redemption analytics event (non-blocking)\n        trackRewardRedeemed({\n            reward_id: reward.id,\n            user_id: session.user.id,\n            value_cents: reward.value_cents,\n            source: reward.source as \"referral\" | \"booking\" | \"milestone\" | \"provider_referral\",\n            stripe_coupon_id: couponId,\n            timestamp: new Date().toISOString(),\n        }).catch((error) => {\n            // Silent fail - analytics should never break the app\n            console.error(\"[POST /api/rewards/redeem] Failed to track reward redemption:\", error);\n        });\n\n        return NextResponse.json({\n            success: true,\n            data: {\n                reward_id: reward.id,\n                value_cents: reward.value_cents,\n                status: \"redeemed\",\n                stripe_coupon_id: couponId,\n            },\n        });\n    } catch (error: any) {\n        console.error(\"[POST /api/rewards/redeem] Unexpected error:\", error);\n        return NextResponse.json(\n            { error: error.message || \"Internal server error\" },\n            { status: 500 }\n        );\n    }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/rewards/summary/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'request' is defined but never used. Allowed unused args must match /^_/u.","line":10,"column":27,"nodeType":null,"messageId":"unusedVar","endLine":10,"endColumn":34},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'referralsError' is assigned a value but never used. Allowed unused vars must match /^(?:_|[A-Z].*)$/u.","line":61,"column":41,"nodeType":null,"messageId":"unusedVar","endLine":61,"endColumn":55}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { NextRequest, NextResponse } from \"next/server\";\nimport { createSupabaseServerComponentClient } from \"@/lib/supabase\";\n\nconst REWARDS_