but never used. Allowed unused args must match /^_/u.","line":287,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":287,"endColumn":21},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'growthMultiplier' is defined but never used. Allowed unused args must match /^_/u.","line":380,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":380,"endColumn":19}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { NextRequest, NextResponse } from \"next/server\";\nimport { getSupabaseServer } from \"@/lib/supabase.server\";\nimport { sendTransactional } from \"@/lib/emails/sendTransactional\";\nimport { cookies } from \"next/headers\";\n\nexport const dynamic = \"force-dynamic\";\nexport const runtime = \"nodejs\";\n\nfunction calculateProfileHealthScore(metrics: {\n  total_classes?: number;\n  active_classes?: number;\n  average_rating?: number;\n  review_count?: number;\n  total_bookings?: number;\n  revenue_last_30_days?: number;\n}): number {\n  let score = 0;\n  if (metrics.total_classes && metrics.total_classes > 0) score += 10;\n  if (metrics.active_classes && metrics.active_classes > 0) score += 10;\n  if (metrics.average_rating && metrics.average_rating > 0) score += 10;\n  if (metrics.review_count && metrics.review_count > 0) score += 10;\n  if (metrics.total_bookings && metrics.total_bookings > 10) score += 15;\n  else if (metrics.total_bookings && metrics.total_bookings > 0) score += 5;\n  if (metrics.revenue_last_30_days && metrics.revenue_last_30_days > 0) score += 15;\n  if (metrics.review_count && metrics.review_count > 5) score += 15;\n  else if (metrics.review_count && metrics.review_count > 0) score += 5;\n  if (metrics.average_rating && metrics.average_rating >= 4.5) score += 15;\n  else if (metrics.average_rating && metrics.average_rating >= 4.0) score += 10;\n  else if (metrics.average_rating && metrics.average_rating > 0) score += 5;\n  return Math.min(100, score);\n}\n\nexport async function POST(req: NextRequest) {\n  // Validate cron secret\n  const cookieStore = await cookies();\n  const cookieSecret = cookieStore.get(\"cron_secret\")?.value;\n  const headerSecret = req.headers.get(\"x-cron-secret\");\n  const expectedSecret = process.env.CRON_SECRET;\n  \n  if (!expectedSecret || (cookieSecret !== expectedSecret && headerSecret !== expectedSecret)) {\n    return NextResponse.json({ error: \"Forbidden\" }, { status: 403 });\n  }\n\n  const supabase = getSupabaseServer();\n  if (!supabase) {\n    return NextResponse.json({ error: \"Supabase not configured\" }, { status: 500 });\n  }\n\n  try {\n    // Calculate week start (Sunday)\n    const now = new Date();\n    const weekStart = new Date(now);\n    weekStart.setDate(now.getDate() - now.getDay());\n    weekStart.setHours(0, 0, 0, 0);\n    const weekStartStr = weekStart.toISOString().split(\"T\")[0];\n\n    // Get all active providers\n    const { data: providers, error: providersError } = await supabase\n      .from(\"providers\")\n      .select(\"id, name, contact_email\")\n      .eq(\"is_active\", true)\n      .not(\"contact_email\", \"is\", null);\n\n    if (providersError) throw providersError;\n\n    const siteUrl = process.env.NEXT_PUBLIC_APP_URL || \"https://parenthelper.co.uk\";\n    let processed = 0;\n    let emailsSent = 0;\n\n    for (const provider of providers || []) {\n      try {\n        // Calculate week metrics\n        const weekStartDate = new Date(weekStart);\n        const weekEndDate = new Date(weekStart);\n        weekEndDate.setDate(weekEndDate.getDate() + 7);\n\n        // Views (from analytics_events - class page views)\n        const { data: viewsData } = await supabase\n          .from(\"analytics_events\")\n          .select(\"id\")\n          .eq(\"event_name\", \"page_view\")\n          .gte(\"created_at\", weekStartDate.toISOString())\n          .lt(\"created_at\", weekEndDate.toISOString())\n          .or(`event_props->>'class_id'.in.(${await getProviderClassIds(supabase, provider.id)})`);\n\n        const views = viewsData?.length || 0;\n\n        // Bookings\n        const { data: bookingsData } = await supabase\n          .from(\"bookings\")\n          .select(\"id, total_paid\")\n          .eq(\"provider_id\", provider.id)\n          .eq(\"status\", \"confirmed\")\n          .gte(\"created_at\", weekStartDate.toISOString())\n          .lt(\"created_at\", weekEndDate.toISOString());\n\n        const bookings = bookingsData?.length || 0;\n        const revenueCents = bookingsData?.reduce((sum, b) => sum + Math.round(Number(b.total_paid) * 100), 0) || 0;\n\n        // Conversion rate\n        const conversionRate = views > 0 ? (bookings / views) * 100 : 0;\n\n        // Search appearances (estimate from featured listings impressions)\n        const subscriptionIds = await getProviderSubscriptionIds(supabase, provider.id);\n        let searchAppearances = 0;\n        if (subscriptionIds.length > 0) {\n          const { data: featuredData } = await supabase\n            .from(\"provider_subscription_usage\")\n            .select(\"featured_impressions\")\n            .gte(\"usage_date\", weekStartStr)\n            .lt(\"usage_date\", weekEndDate.toISOString().split(\"T\")[0])\n            .in(\"provider_subscription_id\", subscriptionIds);\n          searchAppearances = featuredData?.reduce((sum, d) => sum + (d.featured_impressions || 0), 0) || 0;\n        }\n\n        // Reviews\n        const { data: reviewsData } = await supabase\n          .from(\"provider_reviews\")\n          .select(\"id\")\n          .eq(\"provider_id\", provider.id)\n          .gte(\"created_at\", weekStartDate.toISOString())\n          .lt(\"created_at\", weekEndDate.toISOString());\n\n        const reviews = reviewsData?.length || 0;\n\n        // Profile health score\n        const { data: providerMetrics } = await supabase\n          .from(\"v_provider_metrics\")\n          .select(\"*\")\n          .eq(\"provider_id\", provider.id)\n          .single();\n\n        const profileHealthScore = calculateProfileHealthScore(providerMetrics || {});\n\n        // Store weekly analytics\n        await supabase.from(\"provider_analytics_weekly\").upsert({\n          provider_id: provider.id,\n          week_start: weekStartStr,\n          views,\n          bookings,\n          conversion_rate: conversionRate.toFixed(2),\n          search_appearances: searchAppearances,\n          reviews,\n          profile_health_score: profileHealthScore,\n          revenue_cents: revenueCents,\n        }, {\n          onConflict: \"provider_id,week_start\",\n        });\n\n        // Get top 3 metrics for email\n        const metrics = [\n          { label: \"Views\", value: views, icon: \"👁️\" },\n          { label: \"Bookings\", value: bookings, icon: \"📅\" },\n          { label: \"Conversion Rate\", value: `${conversionRate.toFixed(1)}%`, icon: \"📈\" },\n        ].sort((a, b) => (typeof a.value === \"number\" ? a.value : 0) - (typeof b.value === \"number\" ? b.value : 0))\n          .reverse()\n          .slice(0, 3);\n\n        // Get Growth Score\n        const growthScoreResponse = await fetch(`${siteUrl}/api/providers/growth-score?provider_id=${provider.id}`)\n          .then((res) => res.json())\n          .catch(() => null);\n\n        const growthScore = growthScoreResponse?.growthScore || 0;\n        const growthTier = growthScoreResponse?.tier || \"None\";\n        const growthMultiplier = growthScoreResponse?.multiplier || 1.0;\n\n        // Get visibility boost status\n        const { data: visibilityBoost } = await supabase\n          .from(\"provider_visibility_boosts\")\n          .select(\"boost_type, multiplier\")\n          .eq(\"provider_id\", provider.id)\n          .single();\n\n        // Get Next Best Action\n        const nextActionResponse = await fetch(`${siteUrl}/api/providers/next-action`, {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({ provider_id: provider.id }),\n        })\n          .then((res) => res.json())\n          .catch(() => null);\n\n        const nextAction = nextActionResponse || null;\n\n        // Get referral performance\n        const { data: referralAnalytics } = await supabase\n          .from(\"provider_referral_analytics\")\n          .select(\"event_type, created_at\")\n          .eq(\"provider_id\", provider.id)\n          .gte(\"created_at\", weekStartDate.toISOString())\n          .lt(\"created_at\", weekEndDate.toISOString());\n\n        const referralClicks = referralAnalytics?.filter((r) => r.event_type === \"registration\").length || 0;\n        const referralBookings = referralAnalytics?.filter((r) => r.event_type === \"first_booking\").length || 0;\n\n        // Get location-based offers\n        const { data: offers } = await fetch(`${siteUrl}/api/providers/offers?provider_id=${provider.id}`)\n          .then((res) => res.json())\n          .catch(() => ({ offers: [] }));\n\n        // A/B test variant assignment (simple: even/odd provider ID)\n        const variantId = provider.id % 2 === 0 ? \"A\" : \"B\";\n\n        // Send weekly email\n        if (provider.contact_email) {\n          await sendTransactional({\n            to: provider.contact_email,\n            subject: variantId === \"A\"\n              ? `Your Growth Score: ${growthScore.toFixed(0)}/100 - ${growthTier} Tier`\n              : `Improve Your Visibility: ${growthTier} Tier Active`,\n            html: getWeeklyEmailTemplate({\n              providerName: provider.name,\n              growthScore,\n              growthTier,\n              growthMultiplier,\n              visibilityBoost: visibilityBoost || null,\n              referralClicks,\n              referralBookings,\n              nextAction,\n              dashboardUrl: `${siteUrl}/provider/analytics`,\n              offers: offers?.offers || [],\n              variantId,\n            }),\n            text: getWeeklyEmailText({\n              providerName: provider.name,\n              growthScore,\n              growthTier,\n              growthMultiplier,\n              visibilityBoost: visibilityBoost || null,\n              referralClicks,\n              referralBookings,\n              nextAction,\n              dashboardUrl: `${siteUrl}/provider/analytics`,\n            }),\n            type: \"provider_weekly_analytics\",\n          });\n\n          // Track email test\n          await supabase.from(\"provider_email_tests\").insert({\n            provider_id: provider.id,\n            variant_id: variantId,\n            sent_at: new Date().toISOString(),\n          });\n\n          emailsSent++;\n        }\n\n        processed++;\n      } catch (error: any) {\n        console.error(`Error processing provider ${provider.id}:`, error);\n        continue;\n      }\n    }\n\n    return NextResponse.json({\n      message: \"Weekly analytics processed\",\n      processed,\n      emailsSent,\n      weekStart: weekStartStr,\n    });\n  } catch (error: any) {\n    console.error(\"[cron/provider-weekly-analytics] Error:\", error);\n    return NextResponse.json({ error: error.message || \"Internal server error\" }, { status: 500 });\n  }\n}\n\nasync function getProviderClassIds(supabase: any, providerId: number): Promise<string> {\n  const { data: classes } = await supabase\n    .from(\"classes\")\n    .select(\"id\")\n    .eq(\"provider_id\", providerId);\n  return classes?.map((c: any) => c.id).join(\",\") || \"\";\n}\n\nasync function getProviderSubscriptionIds(supabase: any, providerId: number): Promise<number[]> {\n  const { data: subscriptions } = await supabase\n    .from(\"provider_subscriptions\")\n    .select(\"id\")\n    .eq(\"provider_id\", providerId);\n  return subscriptions?.map((s: any) => s.id) || [];\n}\n\nfunction getWeeklyEmailTemplate({\n  providerName,\n  metrics,\n  profileHealthScore,\n  dashboardUrl,\n  offers,\n}: {\n  providerName: string;\n  metrics: Array<{ label: string; value: string | number; icon: string }>;\n  profileHealthScore: number;\n  dashboardUrl: string;\n  offers: Array<{ title: string; description: string; cta: string; ctaUrl: string }>;\n}): string {\n  return `\n    <!DOCTYPE html>\n    <html>\n    <head>\n      <meta charset=\"utf-8\">\n      <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n      <title>Your Weekly Performance</title>\n    </head>\n    <body style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;\">\n      <div style=\"background: #f5f3f0; padding: 20px; border-radius: 8px; margin-bottom: 20px;\">\n        <h1 style=\"margin: 0; color: #3d3d3d;\">Hi ${providerName},</h1>\n        <p style=\"margin: 10px 0 0; color: #666;\">Here's your weekly Growth Score and performance summary:</p>\n      </div>\n\n      <!-- Growth Score Summary -->\n      <div style=\"background: white; border: 2px solid ${growthTier === \"Gold\" ? \"#ffd700\" : growthTier === \"Silver\" ? \"#c0c0c0\" : growthTier === \"Bronze\" ? \"#cd7f32\" : \"#9bae82\"}; border-radius: 8px; padding: 20px; margin-bottom: 20px; text-align: center;\">\n        <div style=\"font-size: 48px; font-weight: bold; color: ${growthTier === \"Gold\" ? \"#ffd700\" : growthTier === \"Silver\" ? \"#c0c0c0\" : growthTier === \"Bronze\" ? \"#cd7f32\" : \"#9bae82\"}; margin-bottom: 10px;\">\n          ${growthScore.toFixed(0)}/100\n        </div>\n        <div style=\"font-size: 18px; font-weight: 600; color: #3d3d3d; margin-bottom: 5px;\">\n          ${growthTier} Tier ${growthTier !== \"None\" ? \"🏆\" : \"\"}\n        </div>\n        ${visibilityBoost ? `\n          <div style=\"margin-top: 10px; padding: 10px; background: #e8f5e9; border-radius: 6px;\">\n            <div style=\"font-size: 14px; color: #2e7d32; font-weight: 600;\">\n              Visibility Boost Active: +${Math.round((visibilityBoost.multiplier - 1) * 100)}% exposure\n            </div>\n          </div>\n        ` : \"\"}\n      </div>\n\n      <!-- Referral Performance -->\n      ${referralClicks > 0 || referralBookings > 0 ? `\n        <div style=\"background: #f9f9f9; border-left: 4px solid #9bae82; padding: 15px; border-radius: 4px; margin-bottom: 20px;\">\n          <div style=\"font-weight: 600; color: #3d3d3d; margin-bottom: 5px;\">Referral Performance</div>\n          <div style=\"font-size: 14px; color: #666;\">\n            ${referralClicks} referral${referralClicks !== 1 ? \"s\" : \"\"} → ${referralBookings} booking${referralBookings !== 1 ? \"s\" : \"\"}\n          </div>\n        </div>\n      ` : \"\"}\n\n      <!-- Next Best Action -->\n      ${nextAction ? `\n        <div style=\"background: #fff3cd; border-left: 4px solid #ffc107; padding: 15px; border-radius: 4px; margin-bottom: 20px;\">\n          <div style=\"font-weight: 600; color: #3d3d3d; margin-bottom: 5px;\">✨ Your Next Best Action</div>\n          <div style=\"font-size: 16px; color: #3d3d3d; margin-bottom: 5px; font-weight: 600;\">${nextAction.title}</div>\n          <div style=\"font-size: 14px; color: #666; margin-bottom: 10px;\">${nextAction.explanation}</div>\n          <div style=\"font-size: 12px; color: #666; margin-bottom: 10px;\">\n            <strong>Impact:</strong> ${nextAction.estimatedImpact} | <strong>Deadline:</strong> ${nextAction.suggestedDeadline}\n          </div>\n          <a href=\"${dashboardUrl}${nextAction.dashboardLink}\" style=\"display: inline-block; padding: 8px 16px; background: #9bae82; color: white; text-decoration: none; border-radius: 4px; font-size: 14px; font-weight: 600;\">Take Action →</a>\n        </div>\n      ` : \"\"}\n\n      ${offers.length > 0 ? `\n        <div style=\"background: #fff; border: 1px solid #ddd; border-radius: 8px; padding: 20px; margin-bottom: 20px;\">\n          <h2 style=\"margin: 0 0 15px; color: #3d3d3d; font-size: 18px;\">Special Offers in Your Area</h2>\n          ${offers.map((offer: any) => `\n            <div style=\"margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #eee;\">\n              <h3 style=\"margin: 0 0 5px; color: #3d3d3d; font-size: 16px;\">${offer.title}</h3>\n              <p style=\"margin: 0 0 10px; color: #666; font-size: 14px;\">${offer.description}</p>\n              <a href=\"${offer.ctaUrl}\" style=\"display: inline-block; padding: 8px 16px; background: #9bae82; color: white; text-decoration: none; border-radius: 4px; font-size: 14px;\">${offer.cta}</a>\n            </div>\n          `).join(\"\")}\n        </div>\n      ` : \"\"}\n\n      <div style=\"text-align: center; margin-top: 30px;\">\n        <a href=\"${dashboardUrl}\" style=\"display: inline-block; padding: 12px 24px; background: #9bae82; color: white; text-decoration: none; border-radius: 6px; font-weight: 600;\">View Full Dashboard</a>\n      </div>\n\n      <p style=\"margin-top: 30px; font-size: 12px; color: #999; text-align: center;\">\n        You're receiving this because you're an active provider on Parent Helper.\n      </p>\n    </body>\n    </html>\n  `;\n}\n\nfunction getWeeklyEmailText({\n  providerName,\n  growthScore,\n  growthTier,\n  growthMultiplier,\n  visibilityBoost,\n  referralClicks,\n  referralBookings,\n  nextAction,\n  dashboardUrl,\n}: {\n  providerName: string;\n  growthScore: number;\n  growthTier: string;\n  growthMultiplier: number;\n  visibilityBoost: { boost_type: string; multiplier: number } | null;\n  referralClicks: number;\n  referralBookings: number;\n  nextAction: {\n    title: string;\n    explanation: string;\n    estimatedImpact: string;\n    suggestedDeadline: string;\n    dashboardLink: string;\n  } | null;\n  dashboardUrl: string;\n}): string {\n  return `\nHi ${providerName},\n\nHere's your weekly Growth Score and performance summary:\n\nGrowth Score: ${growthScore.toFixed(0)}/100\nTier: ${growthTier}${growthTier !== \"None\" ? \" 🏆\" : \"\"}\n${visibilityBoost ? `Visibility Boost Active: +${Math.round((visibilityBoost.multiplier - 1) * 100)}% exposure` : \"\"}\n\n${referralClicks > 0 || referralBookings > 0 ? `Referral Performance: ${referralClicks} referral${referralClicks !== 1 ? \"s\" : \"\"} → ${referralBookings} booking${referralBookings !== 1 ? \"s\" : \"\"}\\n` : \"\"}\n${nextAction ? `\\n✨ Your Next Best Action:\\n${nextAction.title}\\n${nextAction.explanation}\\nImpact: ${nextAction.estimatedImpact} | Deadline: ${nextAction.suggestedDeadline}\\nTake action: ${dashboardUrl}${nextAction.dashboardLink}\\n` : \"\"}\n\nView your full dashboard: ${dashboardUrl}\n\nYou're receiving this because you're an active provider on Parent Helper.\n  `.trim();\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/provider-weekly-growth/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'previousWeekStartStr' is assigned a value but never used. Allowed unused vars must match /^(?:_|[A-Z].*)$/u.","line":52,"column":11,"nodeType":null,"messageId":"unusedVar","endLine":52,"endColumn":31}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { NextRequest, NextResponse } from \"next/server\";\nimport { getSupabaseServer } from \"@/lib/supabase.server\";\nimport { calculateProviderGrowthScore, calculateProfileCompleteness } from \"@/lib/utils/provider-growth-score\";\nimport { generateNextBestAction } from \"@/lib/utils/provider-ai-suggestions\";\n\nasync function validateCronSecret(request: NextRequest) {\n  const authHeader = request.headers.get(\"authorization\");\n  const cronSecret = process.env.CRON_SECRET;\n  \n  if (!cronSecret) {\n    return false;\n  }\n  \n  return authHeader === `Bearer ${cronSecret}`;\n}\n\n/**\n * Get week start date (Monday)\n */\nfunction getWeekStart(date: Date = new Date()): string {\n  const d = new Date(date);\n  const day = d.getDay();\n  const diff = d.getDate() - day + (day === 0 ? -6 : 1); // Adjust when day is Sunday\n  d.setDate(diff);\n  d.setHours(0, 0, 0, 0);\n  return d.toISOString().split(\"T\")[0];\n}\n\n/**\n * Calculate provider variant for A/B testing\n */\nfunction getProviderVariant(providerId: number): \"A\" | \"B\" {\n  return providerId % 2 === 0 ? \"A\" : \"B\";\n}\n\nexport async function POST(request: NextRequest) {\n  // Validate cron secret\n  if (!(await validateCronSecret(request))) {\n    return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n  }\n\n  const supabase = getSupabaseServer();\n  if (!supabase) {\n    return NextResponse.json({ error: \"Supabase not configured\" }, { status: 500 });\n  }\n\n  try {\n    const weekStart = getWeekStart();\n    const weekStartDate = new Date(weekStart);\n    const previousWeekStart = new Date(weekStartDate);\n    previousWeekStart.setDate(previousWeekStart.getDate() - 7);\n    const previousWeekStartStr = previousWeekStart.toISOString().split(\"T\")[0];\n\n    // Get all active providers\n    const { data: providers, error: providersError } = await supabase\n      .from(\"providers\")\n      .select(\"id, name, description_raw, description_override, contact_email, contact_phone, website, address_line1, postcode, latitude, longitude\")\n      .eq(\"is_active\", true);\n\n    if (providersError) {\n      console.error(\"Error fetching providers:\", providersError);\n      return NextResponse.json({ error: \"Failed to fetch providers\" }, { status: 500 });\n    }\n\n    if (!providers || providers.length === 0) {\n      return NextResponse.json({ processed: 0, scores: 0, emails: 0 });\n    }\n\n    let processed = 0;\n    let scoresCreated = 0;\n    let emailsSent = 0;\n\n    // Process each provider\n    for (const provider of providers) {\n      try {\n        // Get current week metrics\n        const weekStartTimestamp = new Date(weekStart).toISOString();\n        const weekEndTimestamp = new Date(weekStartDate);\n        weekEndTimestamp.setDate(weekEndTimestamp.getDate() + 7);\n        const weekEndTimestampStr = weekEndTimestamp.toISOString();\n\n        // Get views (from provider_metrics or provider_analytics_weekly)\n        let views = 0;\n        try {\n          const { data: weeklyAnalytics } = await supabase\n            .from(\"provider_analytics_weekly\")\n            .select(\"views\")\n            .eq(\"provider_id\", provider.id)\n            .eq(\"week_start\", weekStart)\n            .single();\n\n          views = weeklyAnalytics?.views || 0;\n        } catch {\n          // Try provider_metrics table\n          const { data: metrics } = await supabase\n            .from(\"provider_metrics\")\n            .select(\"views\")\n            .eq(\"provider_id\", provider.id)\n            .gte(\"metric_date\", weekStart)\n            .lt(\"metric_date\", weekEndTimestampStr);\n\n          views = metrics?.reduce((sum, m) => sum + (m.views || 0), 0) || 0;\n        }\n\n        // Get bookings\n        const { data: bookings } = await supabase\n          .from(\"bookings\")\n          .select(\"id, total_paid\")\n          .eq(\"provider_id\", provider.id)\n          .eq(\"status\", \"confirmed\")\n          .gte(\"created_at\", weekStartTimestamp)\n          .lt(\"created_at\", weekEndTimestampStr);\n\n        const currentBookings = bookings?.length || 0;\n\n        // Get previous week bookings\n        const previousWeekStartTimestamp = previousWeekStart.toISOString();\n        const { data: previousBookings } = await supabase\n          .from(\"bookings\")\n          .select(\"id\")\n          .eq(\"provider_id\", provider.id)\n          .eq(\"status\", \"confirmed\")\n          .gte(\"created_at\", previousWeekStartTimestamp)\n          .lt(\"created_at\", weekStartTimestamp);\n\n        const previousWeekBookingsCount = previousBookings?.length || 0;\n\n        // Get reviews\n        const { data: reviews } = await supabase\n          .from(\"provider_reviews\")\n          .select(\"rating\")\n          .eq(\"provider_id\", provider.id)\n          .eq(\"status\", \"approved\");\n\n        const reviewCount = reviews?.length || 0;\n        const reviewAverage = reviewCount > 0\n          ? reviews.reduce((sum, r) => sum + (r.rating || 0), 0) / reviewCount\n          : 0;\n\n        // Calculate profile completeness\n        const profileCompletion = calculateProfileCompleteness(provider);\n\n        // Calculate growth score\n        const metrics = {\n          views,\n          bookings: currentBookings,\n          conversions: currentBookings,\n          reviews: reviewCount,\n          profile_completion: profileCompletion,\n          review_average: reviewAverage,\n          previous_week_bookings: previousWeekBookingsCount,\n        };\n\n        const scoreResult = calculateProviderGrowthScore(metrics, {\n          bookings: previousWeekBookingsCount,\n        });\n\n        // Generate AI suggestion\n        const nextBestAction = await generateNextBestAction(\n          {\n            ...metrics,\n            growth_score: scoreResult.score,\n          },\n          provider.name || undefined\n        );\n\n        // Store growth score\n        const { error: scoreError } = await supabase\n          .from(\"provider_growth_score\")\n          .upsert({\n            provider_id: provider.id,\n            week_start: weekStart,\n            growth_score: scoreResult.score,\n            metrics_json: metrics,\n            next_best_action: nextBestAction,\n          }, {\n            onConflict: \"provider_id,week_start\",\n          });\n\n        if (scoreError) {\n          console.error(`Error storing score for provider ${provider.id}:`, scoreError);\n        } else {\n          scoresCreated++;\n        }\n\n        // Send weekly email\n        const variant = getProviderVariant(provider.id);\n        const emailSent = await sendWeeklyEmail(provider, scoreResult, nextBestAction, variant);\n        if (emailSent) {\n          emailsSent++;\n\n          // Log email test\n          await supabase.from(\"provider_email_tests\").insert({\n            provider_id: provider.id,\n            variant_id: variant,\n            sent_at: new Date().toISOString(),\n          });\n        }\n\n        processed++;\n      } catch (error) {\n        console.error(`Error processing provider ${provider.id}:`, error);\n      }\n    }\n\n    return NextResponse.json({\n      processed,\n      scoresCreated,\n      emailsSent,\n      weekStart,\n    });\n  } catch (error) {\n    console.error(\"Error in weekly growth cron:\", error);\n    return NextResponse.json(\n      { error: \"Internal server error\" },\n      { status: 500 }\n    );\n  }\n}\n\nasync function sendWeeklyEmail(\n  provider: any,\n  scoreResult: any,\n  nextBestAction: string,\n  variant: \"A\" | \"B\"\n): Promise<boolean> {\n  const { sendTransactional } = await import(\"@/lib/emails/sendTransactional\");\n\n  const subject = variant === \"A\"\n    ? \"Your Parent Helper Growth Report\"\n    : \"See how your classes performed this week\";\n\n  const scoreColor = scoreResult.score >= 70 ? \"#10B981\" : scoreResult.score >= 50 ? \"#F59E0B\" : \"#EF4444\";\n  const scoreLabel = scoreResult.score >= 70 ? \"Excellent\" : scoreResult.score >= 50 ? \"Good\" : \"Needs Improvement\";\n\n  const html = `\n    <div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n      <div style=\"background: linear-gradient(135deg, #9CAF88 0%, #A8B8A8 100%); padding: 30px; text-align: center; border-radius: 12px 12px 0 0;\">\n        <h1 style=\"color: white; margin: 0; font-size: 28px;\">${variant === \"A\" ? \"Your Growth Report\" : \"Weekly Performance\"}</h1>\n      </div>\n      <div style=\"background: white; padding: 30px; border-radius: 0 0 12px 12px; border: 1px solid #e5e7eb;\">\n        <p style=\"font-size: 18px; color: #3A3A3A; margin-top: 0;\">\n          Hi ${provider.name || \"Provider\"},\n        </p>\n        <p style=\"color: #666;\">\n          Here's how your classes performed this week:\n        </p>\n\n        <!-- Growth Score Visual -->\n        <div style=\"text-align: center; margin: 30px 0; padding: 30px; background: #F5F3F0; border-radius: 12px;\">\n          <div style=\"display: inline-block; position: relative; width: 120px; height: 120px;\">\n            <svg width=\"120\" height=\"120\" style=\"transform: rotate(-90deg);\">\n              <circle cx=\"60\" cy=\"60\" r=\"50\" stroke=\"#e5e7eb\" stroke-width=\"8\" fill=\"none\"/>\n              <circle\n                cx=\"60\"\n                cy=\"60\"\n                r=\"50\"\n                stroke=\"${scoreColor}\"\n                stroke-width=\"8\"\n                fill=\"none\"\n                stroke-dasharray=\"${(scoreResult.score / 100) * 314} 314\"\n                stroke-linecap=\"round\"\n              />\n            </svg>\n            <div style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;\">\n              <div style=\"font-size: 32px; font-weight: bold; color: ${scoreColor};\">\n                ${Math.round(scoreResult.score)}\n              </div>\n              <div style=\"font-size: 12px; color: #666; margin-top: 4px;\">${scoreLabel}</div>\n            </div>\n          </div>\n          <h3 style=\"color: #3A3A3A; margin-top: 20px; margin-bottom: 10px;\">Growth Score</h3>\n        </div>\n\n        <!-- Metrics Breakdown -->\n        <div style=\"margin: 30px 0;\">\n          <h3 style=\"color: #3A3A3A; margin-bottom: 15px;\">Key Metrics</h3>\n          <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr style=\"border-bottom: 1px solid #e5e7eb;\">\n              <td style=\"padding: 10px 0; color: #666;\">Views</td>\n              <td style=\"text-align: right; font-weight: bold; color: #3A3A3A;\">${scoreResult.metrics.views}</td>\n            </tr>\n            <tr style=\"border-bottom: 1px solid #e5e7eb;\">\n              <td style=\"padding: 10px 0; color: #666;\">Bookings</td>\n              <td style=\"text-align: right; font-weight: bold; color: #3A3A3A;\">${scoreResult.metrics.bookings}</td>\n            </tr>\n            <tr style=\"border-bottom: 1px solid #e5e7eb;\">\n              <td style=\"padding: 10px 0; color: #666;\">Conversion Rate</td>\n              <td style=\"text-align: right; font-weight: bold; color: #3A3A3A;\">\n                ${scoreResult.metrics.views > 0 ? ((scoreResult.metrics.bookings / scoreResult.metrics.views) * 100).toFixed(1) : 0}%\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding: 10px 0; color: #666;\">Profile Completeness</td>\n              <td style=\"text-align: right; font-weight: bold; color: #3A3A3A;\">${scoreResult.metrics.profile_completion}%</td>\n            </tr>\n          </table>\n        </div>\n\n        <!-- AI Suggestion -->\n        <div style=\"background: #FEF3C7; border-left: 4px solid #F59E0B; padding: 20px; margin: 30px 0; border-radius: 8px;\">\n          <h3 style=\"color: #92400E; margin-top: 0; margin-bottom: 10px;\">💡 Next Best Action</h3>\n          <p style=\"color: #78350F; margin: 0; font-size: 16px;\">${nextBestAction}</p>\n        </div>\n\n        <!-- CTA -->\n        <div style=\"text-align: center; margin: 30px 0;\">\n          <a\n            href=\"${process.env.NEXT_PUBLIC_APP_URL || \"http://localhost:3000\"}/provider/dashboard\"\n            style=\"display: inline-block; background-color: #9CAF88; color: white; padding: 14px 28px; text-decoration: none; border-radius: 24px; font-weight: bold; font-size: 16px;\"\n          >\n            Improve My Score\n          </a>\n        </div>\n\n        <p style=\"color: #666; margin-bottom: 0; font-size: 14px;\">\n          Best regards,<br>\n          The Parent Helper Team\n        </p>\n      </div>\n    </div>\n  `;\n\n  const text = `${variant === \"A\" ? \"Your Growth Report\" : \"Weekly Performance\"}\\n\\nHi ${provider.name || \"Provider\"},\\n\\nGrowth Score: ${Math.round(scoreResult.score)}/100\\nViews: ${scoreResult.metrics.views}\\nBookings: ${scoreResult.metrics.bookings}\\n\\nNext Best Action: ${nextBestAction}\\n\\nView your dashboard: ${process.env.NEXT_PUBLIC_APP_URL || \"http://localhost:3000\"}/provider/dashboard`;\n\n  const result = await sendTransactional({\n    to: provider.contact_email || provider.contactEmail,\n    subject,\n    html,\n    text,\n    type: \"provider_weekly_update\",\n  });\n\n  return result.ok;\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/provider-weekly-reports/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/referral-reminders/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'error' is defined but never used.","line":98,"column":16,"nodeType":null,"messageId":"unusedVar","endLine":98,"endColumn":21}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { NextRequest, NextResponse } from \"next/server\";\nimport { getSupabaseServer } from \"@/lib/supabase.server\";\nimport { sendTransactional } from \"@/lib/emails/sendTransactional\";\n\nexport const dynamic = \"force-dynamic\";\nexport const runtime = \"nodejs\";\n\n/**\n * GET /api/cron/referral-reminders\n * \n * Cron job to send reminder emails for pending referrals\n * \n * Logic:\n * 1. Find referrals created 7+ days ago\n * 2. Where referred user has NOT signed up (status = 'pending')\n * 3. And reminder_sent = false\n * 4. Send reminder email\n * 5. Update referral → reminder_sent = true\n * \n * Secured with CRON_SECRET header\n */\nexport async function GET(request: NextRequest) {\n  const startTime = Date.now();\n  \n  // Verify cron secret\n  if (process.env.CRON_SECRET) {\n    const provided = request.headers.get(\"x-cron-secret\");\n    if (provided !== process.env.CRON_SECRET) {\n      return NextResponse.json({ error: \"Forbidden\" }, { status: 403 });\n    }\n  }\n\n  const supabase = getSupabaseServer();\n  if (!supabase) {\n    return NextResponse.json({ error: \"Supabase not configured\" }, { status: 500 });\n  }\n\n  const log = (message: string, data?: any) => {\n    const timestamp = new Date().toISOString();\n    console.log(`[referral-reminders-cron][${timestamp}] ${message}`, data || \"\");\n  };\n\n  try {\n    log(\"Starting referral reminders cron job\");\n\n    // Calculate date 7 days ago\n    const sevenDaysAgo = new Date();\n    sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);\n    const sevenDaysAgoISO = sevenDaysAgo.toISOString();\n\n    // Find pending referrals created 7+ days ago where reminder hasn't been sent\n    // Check if reminder_sent field exists, otherwise use metadata\n    const { data: pendingReferrals, error: referralsError } = await supabase\n      .from(\"member_referrals\")\n      .select(\"id, referrer_user_id, referred_email, referral_code, created_at, reminder_sent, metadata\")\n      .eq(\"status\", \"pending\")\n      .lt(\"created_at\", sevenDaysAgoISO)\n      .or(\"reminder_sent.is.null,reminder_sent.eq.false\");\n\n    if (referralsError) {\n      log(\"Error fetching pending referrals\", referralsError);\n      return NextResponse.json(\n        { error: \"Failed to fetch referrals\", details: referralsError.message },\n        { status: 500 }\n      );\n    }\n\n    if (!pendingReferrals || pendingReferrals.length === 0) {\n      log(\"No pending referrals found for reminders\");\n      return NextResponse.json({\n        ok: true,\n        processed: 0,\n        reminders_sent: 0,\n        duration_ms: Date.now() - startTime,\n      });\n    }\n\n    log(`Found ${pendingReferrals.length} pending referrals to process`);\n\n    // Check which referred emails have signed up\n    // Use a more efficient approach: check each email individually if needed\n    // For now, we'll check during processing to avoid loading all users\n    const signedUpEmails = new Set<string>();\n    \n    // Batch check emails by querying auth.users via RPC or checking referrals table\n    // If referral status is 'converted', user has signed up - skip those\n    // For pending referrals, we need to verify against auth.users\n    // Optimize: only check emails we're actually processing\n    const emailsToCheck = [...new Set(pendingReferrals.map((r) => r.referred_email.toLowerCase()))];\n    \n    // Check each email individually (more efficient than loading all users)\n    for (const email of emailsToCheck) {\n      try {\n        const { data: user } = await supabase.auth.admin.getUserByEmail(email);\n        if (user?.user) {\n          signedUpEmails.add(email);\n        }\n      } catch (error) {\n        // User doesn't exist, which is fine\n      }\n    }\n\n    let remindersSent = 0;\n    let skipped = 0;\n    const errors: string[] = [];\n\n    // Process each referral\n    for (const referral of pendingReferrals) {\n      try {\n        // Skip if user has already signed up\n        if (signedUpEmails.has(referral.referred_email.toLowerCase())) {\n          log(`Skipping referral ${referral.id} - user already signed up`);\n          skipped++;\n          continue;\n        }\n\n        // Skip if reminder already sent (double-check)\n        if (referral.reminder_sent === true) {\n          log(`Skipping referral ${referral.id} - reminder already sent`);\n          skipped++;\n          continue;\n        }\n\n        // Get referrer user info\n        const { data: referrerUser } = await supabase.auth.admin.getUserById(\n          referral.referrer_user_id\n        );\n\n        if (!referrerUser?.user?.email) {\n          log(`Skipping referral ${referral.id} - referrer user not found`);\n          skipped++;\n          continue;\n        }\n\n        const referrerName = referrerUser.user.email.split(\"@\")[0];\n        const referralUrl = `${process.env.NEXT_PUBLIC_APP_URL || \"https://parenthelper.co.uk\"}/signup?ref=${referral.referral_code}`;\n\n        // Send reminder email\n        const emailResult = await sendTransactional({\n          to: referral.referred_email,\n          subject: `Reminder: ${referrerName} invited you to Parent Helper`,\n          html: `\n            <div style=\"font-family: sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n              <h1 style=\"color: #9CAF88;\">Don't miss out!</h1>\n              <p>Hi there,</p>\n              <p><strong>${referrerName}</strong> invited you to join Parent Helper a week ago, and we wanted to make sure you didn't miss it!</p>\n              <p>Parent Helper is the best way to discover amazing baby and toddler classes near you.</p>\n              <div style=\"background: #f5f5f0; padding: 20px; border-radius: 8px; margin: 20px 0; text-align: center;\">\n                <p style=\"margin: 0 0 15px; font-weight: 600;\">Sign up using this link and you'll both earn £5 credit when you book your first class:</p>\n                <a href=\"${referralUrl}\" style=\"display: inline-block; background-color: #9CAF88; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 600;\">\n                  Accept Invitation\n                </a>\n              </div>\n              <p style=\"font-size: 14px; color: #666;\">Or copy this link: ${referralUrl}</p>\n              <p>Happy exploring!</p>\n              <p>Best regards,<br>The Parent Helper Team</p>\n            </div>\n          `,\n          text: `Don't miss out!\\n\\n${referrerName} invited you to join Parent Helper a week ago, and we wanted to make sure you didn't miss it!\\n\\nParent Helper is the best way to discover amazing baby and toddler classes near you.\\n\\nSign up using this link and you'll both earn £5 credit when you book your first class:\\n${referralUrl}\\n\\nHappy exploring!\\n\\nThe Parent Helper Team`,\n          type: \"referral_reminder\",\n        });\n\n        if (!emailResult.ok) {\n          log(`Failed to send reminder email for referral ${referral.id}`, emailResult.error);\n          errors.push(`Referral ${referral.id}: ${emailResult.error || \"Email send failed\"}`);\n          continue;\n        }\n\n        // Update referral → reminder_sent = true\n        const { error: updateError } = await supabase\n          .from(\"member_referrals\")\n          .update({ reminder_sent: true })\n          .eq(\"id\", referral.id);\n\n        if (updateError) {\n          log(`Error updating reminder_sent for referral ${referral.id}`, updateError);\n          errors.push(`Referral ${referral.id}: Update failed - ${updateError.message}`);\n          continue;\n        }\n\n        remindersSent++;\n        log(`Sent reminder for referral ${referral.id} to ${referral.referred_email}`);\n      } catch (error: any) {\n        log(`Error processing referral ${referral.id}`, error);\n        errors.push(`Referral ${referral.id}: ${error.message || \"Unknown error\"}`);\n      }\n    }\n\n    const duration = Date.now() - startTime;\n    const summary = {\n      ok: true,\n      processed: pendingReferrals.length,\n      reminders_sent: remindersSent,\n      skipped,\n      errors: errors.length > 0 ? errors : undefined,\n      duration_ms: duration,\n    };\n\n    log(\"Referral reminders cron job completed\", summary);\n\n    return NextResponse.json(summary);\n  } catch (error: any) {\n    log(\"Unexpected error in referral reminders cron\", error);\n    return NextResponse.json(\n      {\n        ok: false,\n        error: error.message || \"Internal server error\",\n        duration_ms: Date.now() - startTime,\n      },\n      { status: 500 }\n    );\n  }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/rewards-expiration/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/rewards-monthly-summary/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/seo-metadata/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/update-loyalty-tiers/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'oldTier' is defined but never used. Allowed unused args must match /^_/u.","line":222,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":222,"endColumn":10}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { NextRequest, NextResponse } from \"next/server\";\nimport { getSupabaseServer } from \"@/lib/supabase.server\";\nimport { sendTransactional } from \"@/lib/emails/sendTransactional\";\n\nasync function validateCronSecret(request: NextRequest) {\n  const authHeader = request.headers.get(\"authorization\");\n  const cronSecret = process.env.CRON_SECRET;\n  \n  if (!cronSecret) {\n    return false;\n  }\n  \n  return authHeader === `Bearer ${cronSecret}`;\n}\n\n/**\n * Calculate loyalty tier based on engagement metrics\n */\nfunction calculateLoyaltyTier(\n  loyaltyScore: number,\n  conversions: number,\n  reviews: number\n): \"bronze\" | \"silver\" | \"gold\" | \"platinum\" {\n  // Bronze: Default tier\n  // Silver: 5+ bookings OR loyalty score >= 30\n  // Gold: 10+ bookings AND 3+ reviews OR loyalty score >= 60\n  // Platinum: 25+ bookings AND 10+ reviews OR loyalty score >= 85\n\n  if (conversions >= 25 && reviews >= 10) return \"platinum\";\n  if (loyaltyScore >= 85) return \"platinum\";\n  \n  if (conversions >= 10 && reviews >= 3) return \"gold\";\n  if (loyaltyScore >= 60) return \"gold\";\n  \n  if (conversions >= 5) return \"silver\";\n  if (loyaltyScore >= 30) return \"silver\";\n  \n  return \"bronze\";\n}\n\n/**\n * Calculate streak days based on last active date\n */\nfunction calculateStreakDays(lastActive: Date, lastStreakDate: Date | null): number {\n  const now = new Date();\n  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());\n  const lastActiveDate = new Date(lastActive.getFullYear(), lastActive.getMonth(), lastActive.getDate());\n  \n  // If last streak date exists and is yesterday, increment streak\n  if (lastStreakDate) {\n    const lastStreak = new Date(lastStreakDate.getFullYear(), lastStreakDate.getMonth(), lastStreakDate.getDate());\n    const yesterday = new Date(today);\n    yesterday.setDate(yesterday.getDate() - 1);\n    \n    if (lastStreak.getTime() === yesterday.getTime() && lastActiveDate.getTime() === today.getTime()) {\n      // Streak continues - we'll increment in the update\n      return -1; // Signal to increment\n    }\n  }\n  \n  // Check if active today (new streak or continuation)\n  if (lastActiveDate.getTime() === today.getTime()) {\n    return 1; // Start or continue streak\n  }\n  \n  return 0; // Streak broken\n}\n\nexport async function POST(request: NextRequest) {\n  // Validate cron secret\n  if (!(await validateCronSecret(request))) {\n    return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n  }\n\n  const supabase = getSupabaseServer();\n  if (!supabase) {\n    return NextResponse.json({ error: \"Supabase not configured\" }, { status: 500 });\n  }\n\n  try {\n    // Get all engagement scores\n    const { data: scores, error: fetchError } = await supabase\n      .from(\"engagement_scores\")\n      .select(\"*\");\n\n    if (fetchError) {\n      console.error(\"Error fetching engagement scores:\", fetchError);\n      return NextResponse.json({ error: \"Failed to fetch scores\" }, { status: 500 });\n    }\n\n    if (!scores || scores.length === 0) {\n      return NextResponse.json({ updated: 0, upgraded: 0 });\n    }\n\n    let updated = 0;\n    let upgraded = 0;\n\n    // Get reviews count per family (if reviews table exists)\n    const { data: reviews } = await supabase\n      .from(\"provider_reviews\")\n      .select(\"family_id\")\n      .not(\"family_id\", \"is\", null);\n\n    const reviewsByFamily: Record<string, number> = {};\n    reviews?.forEach((review: any) => {\n      if (review.family_id) {\n        reviewsByFamily[review.family_id] = (reviewsByFamily[review.family_id] || 0) + 1;\n      }\n    });\n\n    // Process each score\n    for (const score of scores) {\n      const loyaltyScore = parseFloat(score.loyalty_score || \"0\");\n      const conversions = score.conversions || 0;\n      const reviews = reviewsByFamily[score.family_id] || 0;\n      const currentTier = score.loyalty_tier || \"bronze\";\n      \n      // Calculate new tier\n      const newTier = calculateLoyaltyTier(loyaltyScore, conversions, reviews);\n      \n      // Calculate streak\n      const lastActive = new Date(score.last_active);\n      const lastStreakDate = score.last_streak_date ? new Date(score.last_streak_date) : null;\n      const streakChange = calculateStreakDays(lastActive, lastStreakDate);\n      \n      let newStreakDays = score.streak_days || 0;\n      let newLastStreakDate = score.last_streak_date;\n      \n      if (streakChange === -1) {\n        // Increment streak\n        newStreakDays = (score.streak_days || 0) + 1;\n        newLastStreakDate = new Date().toISOString().split(\"T\")[0];\n      } else if (streakChange === 1) {\n        // Start new streak or continue\n        if (newStreakDays === 0) {\n          newStreakDays = 1;\n        } else {\n          newStreakDays = (score.streak_days || 0) + 1;\n        }\n        newLastStreakDate = new Date().toISOString().split(\"T\")[0];\n      } else {\n        // Streak broken - reset if not active today\n        const today = new Date();\n        const lastActiveDate = new Date(lastActive.getFullYear(), lastActive.getMonth(), lastActive.getDate());\n        const todayDate = new Date(today.getFullYear(), today.getMonth(), today.getDate());\n        \n        if (lastActiveDate.getTime() < todayDate.getTime()) {\n          newStreakDays = 0;\n          newLastStreakDate = null;\n        }\n      }\n\n      // Update if tier changed or streak changed\n      if (newTier !== currentTier || newStreakDays !== (score.streak_days || 0)) {\n        const { error: updateError } = await supabase\n          .from(\"engagement_scores\")\n          .update({\n            loyalty_tier: newTier,\n            streak_days: newStreakDays,\n            last_streak_date: newLastStreakDate,\n            updated_at: new Date().toISOString(),\n          })\n          .eq(\"family_id\", score.family_id);\n\n        if (updateError) {\n          console.error(`Error updating score for ${score.family_id}:`, updateError);\n          continue;\n        }\n\n        updated++;\n\n        // Send milestone email if tier upgraded\n        if (newTier !== currentTier && tierOrder(newTier) > tierOrder(currentTier)) {\n          upgraded++;\n          \n          // Get family email (if family_profiles table exists)\n          try {\n            const { data: family } = await supabase\n              .from(\"family_profiles\")\n              .select(\"email, name\")\n              .eq(\"id\", score.family_id)\n              .single();\n\n            if (family?.email) {\n              await sendMilestoneEmail(family.email, family.name || \"Family\", newTier, currentTier);\n            }\n          } catch (error) {\n            console.warn(`Could not send milestone email for ${score.family_id}:`, error);\n          }\n        }\n      }\n    }\n\n    return NextResponse.json({\n      updated,\n      upgraded,\n      total: scores.length,\n    });\n  } catch (error) {\n    console.error(\"Error updating loyalty tiers:\", error);\n    return NextResponse.json(\n      { error: \"Internal server error\" },\n      { status: 500 }\n    );\n  }\n}\n\nfunction tierOrder(tier: string): number {\n  const order: Record<string, number> = {\n    bronze: 1,\n    silver: 2,\n    gold: 3,\n    platinum: 4,\n  };\n  return order[tier] || 0;\n}\n\nasync function sendMilestoneEmail(\n  email: string,\n  name: string,\n  newTier: string,\n  oldTier: string\n) {\n  const tierNames: Record<string, string> = {\n    bronze: \"Bronze\",\n    silver: \"Silver\",\n    gold: \"Gold\",\n    platinum: \"Platinum\",\n  };\n\n  const tierColors: Record<string, string> = {\n    bronze: \"#CD7F32\",\n    silver: \"#C0C0C0\",\n    gold: \"#FFD700\",\n    platinum: \"#E5E4E2\",\n  };\n\n  const tierBenefits: Record<string, string[]> = {\n    silver: [\"Priority customer support\", \"Early access to new classes\"],\n    gold: [\"Exclusive discounts\", \"Free class credits\", \"Priority booking\"],\n    platinum: [\"VIP support\", \"Maximum discounts\", \"Free premium features\", \"Exclusive events\"],\n  };\n\n  const benefits = tierBenefits[newTier] || [];\n\n  await sendTransactional({\n    to: email,\n    subject: `🎉 Congratulations! You've reached ${tierNames[newTier]} Family status!`,\n    html: `\n      <div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n        <div style=\"background: linear-gradient(135deg, ${tierColors[newTier]} 0%, ${tierColors[newTier]}80 100%); padding: 30px; text-align: center; border-radius: 12px 12px 0 0;\">\n          <h1 style=\"color: white; margin: 0; font-size: 32px;\">🎉 Congratulations!</h1>\n        </div>\n        <div style=\"background: white; padding: 30px; border-radius: 0 0 12px 12px; border: 1px solid #e5e7eb;\">\n          <p style=\"font-size: 18px; color: #3A3A3A; margin-top: 0;\">\n            Hi ${name},\n          </p>\n          <p style=\"color: #666;\">\n            We're thrilled to let you know that you've been upgraded to <strong style=\"color: ${tierColors[newTier]};\">${tierNames[newTier]} Family</strong> status!\n          </p>\n          <p style=\"color: #666;\">\n            Thank you for being such a valued member of the Parent Helper community. Your continued engagement and support mean the world to us.\n          </p>\n          ${benefits.length > 0 ? `\n            <div style=\"background: #F5F3F0; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n              <h3 style=\"color: #3A3A3A; margin-top: 0;\">Your ${tierNames[newTier]} Family Benefits:</h3>\n              <ul style=\"color: #666; padding-left: 20px;\">\n                ${benefits.map((benefit) => `<li style=\"margin: 8px 0;\">${benefit}</li>`).join(\"\")}\n              </ul>\n            </div>\n          ` : \"\"}\n          <p style=\"color: #666;\">\n            Keep exploring amazing classes and activities for your little ones!\n          </p>\n          <p style=\"color: #666; margin-bottom: 0;\">\n            Best regards,<br>\n            The Parent Helper Team\n          </p>\n        </div>\n      </div>\n    `,\n    text: `Congratulations ${name}! You've been upgraded to ${tierNames[newTier]} Family status. Thank you for being a valued member of Parent Helper.`,\n    type: \"loyalty_milestone\",\n  });\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/weekly-growth-score/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/weekly/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/demo/family-user/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/demo/rebuild-recs/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'req' is defined but never used. Allowed unused args must match /^_/u.","line":8,"column":28,"nodeType":null,"messageId":"unusedVar","endLine":8,"endColumn":31}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"impor