ewStatus = parsed.data.action === \"approve\" ? \"approved\" : \"rejected\";\n    const { error: updateError } = await supabase\n      .from(\"class_questions\")\n      .update({ status: newStatus })\n      .eq(\"id\", qid);\n\n    if (updateError) {\n      console.error(\"Error updating question status:\", updateError);\n      return NextResponse.json({ error: \"Failed to update question\" }, { status: 500 });\n    }\n\n    return NextResponse.json({ ok: true, status: newStatus });\n  } catch (error: any) {\n    console.error(\"Error in POST /api/classes/questions/[qid]/moderate:\", error);\n    return NextResponse.json({ error: \"Internal server error\" }, { status: 500 });\n  }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/auto-credit-rewards/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/check-alerts/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/check-inactivity/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/cron/geosearch-refresh/route.ts","messages":[],"suppressedMessages":[],"err