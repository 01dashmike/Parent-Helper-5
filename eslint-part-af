        return NextResponse.json(\n                { error: \"Wallet not found\" },\n                { status: 404 }\n            );\n        }\n\n        // Get all members\n        const members = await db\n            .select()\n            .from(familyMembers)\n            .where(eq(familyMembers.walletId, wallet.id))\n            .orderBy(familyMembers.createdAt);\n\n        // Get transactions\n        const transactions = await db\n            .select()\n            .from(walletTransactions)\n            .where(eq(walletTransactions.walletId, wallet.id))\n            .orderBy(desc(walletTransactions.createdAt))\n            .limit(50);\n\n        // Calculate balance\n        const balance = transactions.reduce((sum, t) => {\n            if (t.type === \"credit\" || t.type === \"bonus\") {\n                return sum + t.amountCents;\n            } else {\n                return sum - t.amountCents;\n            }\n        }, 0);\n\n        return NextResponse.json({\n            wallet,\n            members,\n            transactions,\n            balance,\n        });\n    } catch (error) {\n        console.error(\"[api/wallet/summary] Error:\", error);\n        return NextResponse.json(\n            { error: \"Failed to fetch wallet summary\" },\n            { status: 500 }\n        );\n    }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/wallet/transfer/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]}]