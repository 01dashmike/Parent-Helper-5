s: bookings?.filter((b) => b.status === \"confirmed\").length || 0,\n      totalClasses: classes?.length || 0,\n      featuredClasses: classes?.filter((c) => c.is_featured).length || 0,\n      topCategories: getTopCategories(classes || []),\n      topLocations: getTopLocations(classes || []),\n      dayOfWeekDistribution: getDayOfWeekDistribution(classes || []),\n      searchPatterns: extractSearchPatterns(searchEvents || []),\n      lowPerformingAreas: identifyLowPerformingAreas(providerMetrics || [], classes || []),\n    };\n\n    // Build prompt for OpenAI\n    const prompt = buildAnalysisPrompt(analysis);\n\n    // Call OpenAI\n    const openaiResponse = await fetch(\"https://api.openai.com/v1/chat/completions\", {\n      method: \"POST\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n        Authorization: `Bearer ${process.env.OPENAI_API_KEY}`,\n      },\n      body: JSON.stringify({\n        model: process.env.OPENAI_MODEL || \"gpt-4o-mini\",\n        response_format: { type: \"json_object\" },\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You are a growth analyst for Parent Helper, a UK platform connecting parents with baby and toddler classes. Analyze the provided data and suggest exactly 3 actionable growth recommendations. Focus on concrete, implementable actions like adding classes on specific days, featuring in specific locations, or optimizing schedules. Return valid JSON only.\",\n          },\n          {\n            role: \"user\",\n            content: prompt,\n          },\n        ],\n        temperature: 0.7,\n        max_tokens: 1000,\n      }),\n    });\n\n    if (!openaiResponse.ok) {\n      const errorData = await openaiResponse.text();\n      console.error(\"OpenAI error:\", errorData);\n      return NextResponse.json(\n        { error: \"Failed to generate recommendations\" },\n        { status: 500 }\n      );\n    }\n\n    const openaiData = await openaiResponse.json();\n    const content = openaiData?.choices?.[0]?.message?.content;\n\n    if (!content) {\n      return NextResponse.json(\n        { error: \"No content returned from OpenAI\" },\n        { status: 500 }\n      );\n    }\n\n    let recommendations: GrowthRecommendation[];\n    try {\n      const parsed = JSON.parse(content);\n      recommendations = parsed.recommendations || parsed.recommendation || [];\n      \n      // Ensure we have exactly 3 recommendations\n      if (!Array.isArray(recommendations) || recommendations.length === 0) {\n        // Fallback to rule-based recommendations if AI fails\n        recommendations = generateFallbackRecommendations(analysis);\n      } else {\n        recommendations = recommendations.slice(0, 3).map((rec: any, idx: number) => ({\n          title: rec.title || rec.recommendation || `Recommendation ${idx + 1}`,\n          description: rec.description || rec.reason || \"\",\n          actionType: rec.actionType || \"improve_listing\",\n          actionData: rec.actionData || {},\n          priority: rec.priority || idx + 1,\n          expectedImpact: rec.expectedImpact || rec.impact || \"Medium\",\n        }));\n      }\n    } catch (parseError) {\n      console.error(\"Failed to parse OpenAI response:\", parseError);\n      // Fallback to rule-based recommendations\n      recommendations = generateFallbackRecommendations(analysis);\n    }\n\n    return NextResponse.json({\n      ok: true,\n      recommendations,\n      analysis,\n      generatedAt: new Date().toISOString(),\n    });\n  } catch (error: any) {\n    console.error(\"Unexpected error:\", error);\n    return NextResponse.json(\n      { error: error.message ?? \"Internal server error\" },\n      { status: 500 }\n    );\n  }\n}\n\nfunction getTopCategories(classes: any[]): Array<{ category: string; count: number }> {\n  const categoryMap = new Map<string, number>();\n  classes.forEach((c) => {\n    const cat = c.category || \"other\";\n    categoryMap.set