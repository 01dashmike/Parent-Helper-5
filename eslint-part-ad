der\n * Called when provider data changes (e.g., photo upload/deletion)\n * \n * Body: { provider_id: number }\n */\nexport const dynamic = \"force-dynamic\";\n\nexport async function POST(req: NextRequest) {\n  try {\n    const body = await req.json();\n    const { provider_id } = body;\n\n    if (!provider_id || typeof provider_id !== \"number\") {\n      return NextResponse.json(\n        { error: \"provider_id (number) is required\" },\n        { status: 400 }\n      );\n    }\n\n    // Recompute growth score (invalidates cache and triggers fresh calculation)\n    await recomputeProviderGrowthScore(provider_id);\n\n    return NextResponse.json({ \n      ok: true, \n      message: \"Growth score recomputation triggered\" \n    });\n  } catch (error: any) {\n    console.error(\"[api/providers/growth-score/recompute] Error:\", error);\n    return NextResponse.json(\n      { error: error.message || \"Internal server error\" },\n      { status: 500 }\n    );\n  }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/providers/growth-score/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/providers/next-action/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'weakAreas' is defined but never used. Allowed unused args must match /^_/u.","line":155,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":155,"endColumn":12}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { NextRequest, NextResponse } from \"next/server\";\nimport { getSupabaseServer } from \"@/lib/supabase.server\";\nimport OpenAI from \"openai\";\n\nexport const dynamic = \"force-dynamic\";\n\nconst openai = new OpenAI({\n  apiKey: process.env.OPENAI_API_KEY,\n});\n\ninterface NextBestAction {\n  title: string;\n  explanation: string;\n  estimatedImpact: string;\n  suggestedDeadline: string;\n  dashboardLink: string;\n}\n\nexport async function POST(req: NextRequest) {\n  try {\n    const body = await req.json();\n    const { provider_id } = body;\n\n    if (!provider_id) {\n      return NextResponse.json({ error: \"provider_id is required\" }, { status: 400 });\n    }\n\n    const supabase = getSupabaseServer();\n    if (!supabase) {\n      return NextResponse.json({ error: \"Server error\" }, { status: 500 });\n    }\n\n    // Fetch provider growth score and metrics\n    const { data: growthScore } = await supabase\n      .from(\"provider_growth_score\")\n      .select(\"*\")\n      .eq(\"provider_id\", provider_id)\n      .order(\"week_start\", { ascending: false })\n      .limit(1)\n      .single();\n\n    if (!growthScore) {\n      return NextResponse.json({ error: \"Growth score not found. Please calculate it first.\" }, { status: 404 });\n    }\n\n    const metrics = growthScore.metrics_json as {\n      profile_completion: number;\n      listing_quality: number;\n      booking_activity: number;\n      reviews_score: number;\n      referral_activity: number;\n    };\n\n    // Fetch provider data for context\n    const { data: provider } = await supabase\n      .from(\"providers\")\n      .select(\"name, total_classes, active_classes\")\n      .eq(\"id\", provider_id)\n      .single();\n\n    // Identify weak areas\n    const weakAreas = [];\n    if (metrics.profile_completion < 70) weakAreas.push(\"profile completion\");\n    if (metrics.listing_quality < 60) weakAreas.push(\"listing quality\");\n    if (metrics.booking_activity < 50) weakAreas.push(\"booking activity\");\n    if (metrics.reviews_score < 50) weakAreas.push(\"reviews\");\n    if (metrics.referral_activity < 30) weakAreas.push(\"referral activity\");\n\n    // Generate AI suggestion\n    const prompt = `You are a helpful assistant for Parent Helper, a platform connecting parents with activity providers.\n\nGiven this provider's analytics:\n- Profile Completion: ${metrics.profile_completion}/100\n- Listing Quality: ${metrics.listing_quality}/100\n- Booking Activity: ${metrics.booking_activity}/100\n- Reviews Score: ${metrics.reviews_score}/100\n- Referral Activity: ${metrics.referral_activity}/100\n- Overall Growth Score: ${growthScore.growth_score}/100\n\nWeak areas: ${weakAreas.join(\", \") || \"none\"}\n\nProvider context: ${provider?.name || \"Unknown\"}, ${provider?.active_classes || 0} active classes.\n\nSuggest the single highest-impact action they should take next. Use simple language targeted at busy parents running classes. Be specific and actionable.\n\nReturn a JSON object with:\n{\n  \"title\": \"Short action title (max 60 chars)\",\n  \"explanation\": \"Brief explanation of why this matters (2-3 sentences)\",\n  \"estimatedImpact\": \"Expected improvement (e.g., '+15% more bookings')\",\n  \"suggestedDeadline\": \"When to complete this (e.g., 'This week' or 'Within 2 weeks')\",\n  \"dashboardLink\": \"Relative path to relevant dashboard section (e.g., '/provider/profile' or '/provider/classes')\"\n}`;\n\n    let nextAction: NextBestAction;\n\n    if (process.env.OPENAI_API_KEY) {\n      try {\n        const completion = await openai.chat.completions.create({\n          model: \"gpt-4o-mini\",\n          messages: [\n            {\n              role: \"system\",\n              content: \"You are a helpful assistant that provides actionable advice for small business owners. Always return valid JSON.\",\n            },\n            {\n              role: \"user\",\n              content: prompt,\n            },\n          ],\n          temperature: 0.7,\n          response_format: { type: \"json_object\" },\n        });\n\n        const response = JSON.parse(completion.choices[0]?.message?.content || \"{}\");\n        nextAction = {\n          title: response.title || \"Improve your profile\",\n          explanation: response.explanation || \"Complete your profile to attract more families.\",\n          estimatedImpact: response.estimatedImpact || \"+10% more visibility\",\n          suggestedDeadline: response.suggestedDeadline || \"This week\",\n          dashboardLink: response.dashboardLink || \"/provider/profile\",\n        };\n      } catch (error: any) {\n        console.error(\"[next-action] OpenAI error:\", error);\n        // Fallback to rule-based suggestion\n        nextAction = generateFallbackAction(metrics, weakAreas);\n      }\n    } else {\n      // Fallback to rule-based suggestion\n      nextAction = generateFallbackAction(metrics, weakAreas);\n    }\n\n    // Update growth score with next best action\n    await supabase\n      .from(\"provider_growth_score\")\n      .update({ next_best_action: JSON.stringify(nextAction) })\n      .eq(\"provider_id\", provider_id)\n      .eq(\"week_start\", growthScore.week_start);\n\n    return NextResponse.json(nextAction);\n  } catch (error: any) {\n    console.error(\"[api/providers/next-action] Error:\", error);\n    return NextResponse.json({ error: error.message || \"Internal server error\" }, { status: 500 });\n  }\n}\n\nfunction generateFallbackAction(\n  metrics: {\n    profile_completion: number;\n    listing_quality: number;\n    booking_activity: number;\n    reviews_score: number;\n    referral_activity: number;\n  },\n  weakAreas: string[]\n): NextBestAction {\n  // Rule-based fallback suggestions\n  if (metrics.profile_completion < 70) {\n    return {\n      title: \"Complete your profile\",\n      explanation: \"A complete profile helps families trust your classes. Add photos, descriptions, and contact information.\",\n      estimatedImpact: \"+20% more profile views\",\n      suggestedDeadline: \"This week\",\n      dashboardLink: \"/provider/profile\",\n    };\n  }\n\n  if (metrics.listing_quality < 60) {\n    return {\n      title: \"Improve your class listings\",\n      explanation: \"High-quality listings with photos and detailed descriptions get more bookings.\",\n      estimatedImpact: \"+15% more bookings\",\n      suggestedDeadline: \"This week\",\n      dashboardLink: \"/provider/classes\",\n    };\n  }\n\n  if (metrics.reviews_score < 50) {\n    return {\n      title: \"Request reviews from recent bookings\",\n      explanation: \"Reviews build trust and help families choose your classes. Send a quick request to recent customers.\",\n      estimatedImpact: \"+25% more conversions\",\n      suggestedDeadline: \"Within 2 weeks\",\n      dashboardLink: \"/provider/reviews\",\n    };\n  }\n\n  if (metrics.referral_activity < 30) {\n    return {\n      title: \"Share your referral link\",\n      explanation: \"Refer other providers to Parent Helper and earn rewards. Every referral helps grow the platform.\",\n      estimatedImpact: \"+10% growth score boost\",\n      suggestedDeadline: \"This week\",\n      dashboardLink: \"/provider/referrals\",\n    };\n  }\n\n  if (metrics.booking_activity < 50) {\n    return {\n      title: \"Promote your classes\",\n      explanation: \"Share your classes on social media and with local parent groups to increase bookings.\",\n      estimatedImpact: \"+30% more bookings\",\n      suggestedDeadline: \"This week\",\n      dashboardLink: \"/provider/classes\",\n    };\n  }\n\n  // Default: maintain momentum\n  return {\n    title: \"Keep up the great work!\",\n    explanation: \"Your profile is performing well. Continue engaging with families and maintaining high-quality listings.\",\n    estimatedImpact: \"Maintain current performance\",\n    suggestedDeadline: \"Ongoing\",\n    dashboardLink: \"/provider/analytics\",\n  };\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed