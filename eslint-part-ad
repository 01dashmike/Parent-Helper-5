unt = Object.values(dayCounts).reduce((a, b) => a + b, 0) / Object.keys(dayCounts).length;\n  Object.entries(dayCounts).forEach(([day, count]) => {\n    if (count < avgDayCount * 0.5 && day !== \"unknown\") {\n      lowPerforming.push(`Low coverage on ${day}`);\n    }\n  });\n\n  return lowPerforming;\n}\n\nfunction buildAnalysisPrompt(analysis: any): string {\n  return `Analyze the following Parent Helper platform data and suggest exactly 3 actionable growth recommendations.\n\nData Summary:\n- Total Providers: ${analysis.totalProviders}\n- Total Bookings (30 days): ${analysis.totalBookings} (${analysis.confirmedBookings} confirmed)\n- Total Classes: ${analysis.totalClasses} (${analysis.featuredClasses} featured)\n- Top Categories: ${analysis.topCategories.map((c: any) => `${c.category} (${c.count})`).join(\", \")}\n- Top Locations: ${analysis.topLocations.map((l: any) => `${l.location} (${l.count})`).join(\", \")}\n- Day Distribution: ${JSON.stringify(analysis.dayOfWeekDistribution)}\n- Low Performing Areas: ${analysis.lowPerformingAreas.join(\", \") || \"None identified\"}\n\nReturn a JSON object with exactly 3 recommendations in this format:\n{\n  \"recommendations\": [\n    {\n      \"title\": \"Short actionable title\",\n      \"description\": \"Detailed explanation of why this helps growth\",\n      \"actionType\": \"add_classes|feature_location|optimize_schedule|improve_listing|expand_coverage\",\n      \"actionData\": {\n        \"dayOfWeek\": \"Sunday\" (if applicable),\n        \"location\": \"SW11\" (if applicable),\n        \"postcode\": \"SW11 1AA\" (if applicable),\n        \"category\": \"sensory\" (if applicable)\n      },\n      \"priority\": 1-3,\n      \"expectedImpact\": \"High|Medium|Low\"\n    }\n  ]\n}\n\nFocus on concrete, implementable actions based on the data patterns.`;\n}\n\nfunction generateFallbackRecommendations(analysis: any): GrowthRecommendation[] {\n  const recommendations: GrowthRecommendation[] = [];\n\n  // Recommendation 1: Add classes on under-served days\n  const dayCounts = analysis.dayOfWeekDistribution;\n  const avgDayCount = Object.values(dayCounts).reduce((a: number, b: number) => a + b, 0) / Math.max(Object.keys(dayCounts).length, 1);\n  const underServedDay = Object.entries(dayCounts).find(\n    ([day, count]) => (count as number) < avgDayCount * 0.5 && day !== \"unknown\"\n  );\n\n  if (underServedDay) {\n    recommendations.push({\n      title: `Add more classes on ${underServedDay[0]}s`,\n      description: `${underServedDay[0]} has ${underServedDay[1]} classes compared to an average of ${Math.round(avgDayCount)}. Adding classes on this day could capture demand from parents looking for weekend activities.`,\n      actionType: \"add_classes\",\n      actionData: { dayOfWeek: underServedDay[0] as string },\n      priority: 1,\n      expectedImpact: \"High\",\n    });\n  }\n\n  // Recommendation 2: Feature in high-demand location\n  if (analysis.topLocations.length > 0) {\n    const topLocation = analysis.topLocations[0];\n    recommendations.push({\n      title: `Feature classes in ${topLocation.location}`,\n      description: `${topLocation.location} has ${topLocation.count} classes but may benefit from featured listings to increase visibility and bookings.`,\n      actionType: \"feature_location\",\n      actionData: { location: topLocation.location },\n      priority: 2,\n      expectedImpact: \"Medium\",\n    });\n  }\n\n  // Recommendation 3: Expand coverage in low-performing areas\n  if (analysis.lowPerformingAreas.length > 0) {\n    recommendations.push({\n      title: \"Expand coverage in underserved areas\",\n      description: analysis.lowPerformingAreas[0],\n      actionType: \"expand_coverage\",\n      priority: 3,\n      expectedImpact: \"Medium\",\n    });\n  }\n\n  // Fill remaining slots with generic recommendations\n  while (recommendations.length < 3) {\n    recommendations.push({\n      title: \"Optimize class listings\",\n      description: \"Improve class 