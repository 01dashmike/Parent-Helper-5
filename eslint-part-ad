/lib/env\";\nimport { sendTransactional } from \"@/lib/emails/sendTransactional\";\nimport { replaceTemplateVariables } from \"@/lib/marketing/utils\";\nimport { familyNewsletterTemplate } from \"@/lib/emails/templates/familyNewsletter\";\n\nexport const dynamic = \"force-dynamic\";\nexport const runtime = \"nodejs\";\n\n/**\n * Send weekly family newsletters\n * Called by cron job weekly\n */\nexport async function POST(req: Request) {\n  // Verify cron secret\n  const authHeader = req.headers.get(\"authorization\");\n  const cronSecret = process.env.CRON_SECRET;\n  if (cronSecret && authHeader !== `Bearer ${cronSecret}`) {\n    return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n  }\n\n  if (!hasSupabaseServerEnv() || !isPersonalizationEnabled() || !isNewsletterEnabled()) {\n    return NextResponse.json({ error: \"Newsletter not enabled\" }, { status: 400 });\n  }\n\n  try {\n    const supabase = getSupabaseServer();\n    if (!supabase) {\n      return NextResponse.json({ error: \"Supabase not configured\" }, { status: 500 });\n    }\n\n    const batchSize = parseInt(process.env.NEWSLETTER_BATCH_SIZE || \"500\", 10);\n\n    // Get users with weekly newsletter enabled and marketing opt-in\n    const { data: users } = await supabase\n      .from(\"user_preferences\")\n      .select(\"user_id, newsletter_frequency\")\n      .eq(\"newsletter_frequency\", \"weekly\")\n      .limit(batchSize);\n\n    if (!users || users.length === 0) {\n      return NextResponse.json({ ok: true, sent: 0 });\n    }\n\n    let sent = 0;\n    const appUrl = process.env.NEXT_PUBLIC_APP_URL || \"https://parenthelper.co.uk\";\n\n    for (const userPref of users) {\n      try {\n        // Get user details\n        const { data: user } = await supabase.auth.admin.getUserById(userPref.user_id);\n        if (!user?.user?.email) continue;\n\n        // Get family profile\n        const { data: familyProfile } = await supabase\n          .from(\"family_profiles\")\n          .select(\"*\")\n          .eq(\"user_id\", userPref.user_id)\n          .single();\n\n        if (!familyProfile || !familyProfile.marketing_opt_in) continue;\n\n        // Get children\n        const { data: children } = await supabase\n          .from(\"child_profiles\")\n          .select(\"*\")\n          .eq(\"family_id\", familyProfile.id)\n          .limit(1);\n\n        const child = children?.[0];\n\n        // Get top recommendations\n        const { data: recommendations } = await supabase\n          .from(\"recommendations\")\n          .select(\"*, classes(*)\")\n          .eq(\"user_id\", userPref.user_id)\n          .gt(\"expires_at\", new Date().toISOString())\n          .order(\"score\", { ascending: false })\n          .limit(6);\n\n        // Build email content blocks\n        const blocks = buildNewsletterBlocks(recommendations || [], child, familyProfile);\n\n        // Build template variables\n        const variables = {\n          household_name: familyProfile.household_name || \"there\",\n          child_name: child?.first_name || \"your child\",\n          local_city: familyProfile.postcode?.split(\" \")[0] || \"your area\",\n          app_url: appUrl,\n          unsubscribe_url: `${appUrl}/account/preferences?unsubscribe=true`,\n          ...blocks,\n        };\n\n        // Send email\n        const result = await sendTransactional({\n          to: user.user.email,\n          subject: replaceTemplateVariables(familyNewsletterTemplate.subject, variables),\n          html: replaceTemplateVariables(familyNewsletterTemplate.html, variables),\n          text: replaceTemplateVariables(familyNewsletterTemplate.text, variables),\n          type: \"newsletter\",\n        });\n\n        if (result.ok) {\n          sent++;\n        }\n      } catch (error) {\n        console.error(`[sendWeeklyNewsletters] Error for user ${userPref.user_id}:`, error);\n      }\n    }\n\n    return NextResponse.json({ ok: true, sent, total: users.length });\n  } catch (error: any) {\n    console.error(\"[api/personalisation/newsletter/weekly] Error:\", error);\n    return NextResponse.json({ error: error.message || \"Internal server error\" }, { status: 500 });\n  }\n}\n\nfunction buildNewsletterBlocks(\n  recommendations: any[],\n  child: any,\n  familyProfile: any\n): Record<string, string> {\n  const blocks: Record<string, string> = {};\n\n  // Child-specific section\n  if (child && recommendations.length > 0) {\n    const childRecs = recommendations.slice(0, 3);\n    blocks.child_section = childRecs\n      .map(\n        (rec) => `\n      <div class=\"class-card\">\n        <h3>${rec.classes?.name || \"Class\"}</h3>\n        <p>${rec.classes?.category || \"\"} ${rec.classes?.town ? `• ${rec.classes.town}` : \"\"}</p>\n        <p style=\"font-size: 12px; color: #666;\">${rec.rationale || \"\"}</p>\n      </div>\n    `\n      )\n      .join(\"\");\n  }\n\n  // Local section\n  const localRecs = recommendations.filter((r) => r.rationale?.includes(\"close to you\")).slice(0, 3);\n  if (localRecs.length > 0) {\n    blocks.local_section = localRecs\n      .map(\n        (rec) => `\n      <div class=\"class-card\">\n        <h3>${rec.classes?.name || \"Class\"}</h3>\n        <p>${rec.classes?.category || \"\"} ${rec.classes?.town ? `• ${rec.classes.town}` : \"\"}</p>\n      </div>\n    `\n      )\n      .join(\"\");\n  }\n\n  // Editor's picks (high quality + popular)\n  const editorsPicks = recommendations\n    .filter((r) => r.rationale?.includes(\"popular\") || r.rationale?.includes(\"highly rated\"))\n    .slice(0, 3);\n  if (editorsPicks.length > 0) {\n    blocks.editors_picks_section = editorsPicks\n      .map(\n        (rec) => `\n      <div class=\"class-card\">\n        <h3>${rec.classes?.name || \"Class\"}</h3>\n        <p>${rec.classes?.category || \"\"} ${rec.classes?.town ? `• ${rec.classes.town}` : \"\"}</p>\n      </div>\n    `\n      )\n      .join(\"\");\n  }\n\n  return blocks;\n}\n\n","usedDeprecatedRules":[{"rul