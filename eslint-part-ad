ce)\n */\nexport async function POST(req: Request) {\n  // Verify cron secret\n  const authHeader = req.headers.get(\"authorization\");\n  const cronSecret = process.env.CRON_SECRET;\n  if (cronSecret && authHeader !== `Bearer ${cronSecret}`) {\n    return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n  }\n\n  if (!hasSupabaseServerEnv() || !isPersonalizationEnabled()) {\n    return NextResponse.json({ error: \"Personalisation not enabled\" }, { status: 400 });\n  }\n\n  try {\n    const supabase = getSupabaseServer();\n    if (!supabase) {\n      return NextResponse.json({ error: \"Supabase not configured\" }, { status: 500 });\n    }\n\n    // Get saved searches due for digest\n    const now = new Date();\n    const weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\n    const { data: savedSearches } = await supabase\n      .from(\"saved_searches\")\n      .select(\"*\")\n      .eq(\"cadence\", \"weekly\")\n      .or(`last_sent_at.is.null,last_sent_at.lt.${weekAgo.toISOString()}`)\n      .limit(100);\n\n    if (!savedSearches || savedSearches.length === 0) {\n      return NextResponse.json({ ok: true, sent: 0 });\n    }\n\n    let sent = 0;\n    const appUrl = process.env.NEXT_PUBLIC_APP_URL || \"https://parenthelper.co.uk\";\n\n    for (const search of savedSearches) {\n      try {\n        // Get user details\n        const { data: user } = await supabase.auth.admin.getUserById(search.user_id);\n        if (!user?.user?.email) continue;\n\n        // Get family profile to check opt-in\n        const { data: familyProfile } = await supabase\n          .from(\"family_profiles\")\n          .select(\"*\")\n          .eq(\"user_id\", search.user_id)\n          .single();\n\n        if (!familyProfile || !familyProfile.marketing_opt_in) continue;\n\n        // Find new classes matching search params\n        const newClasses = await findNewClassesForSearch(supabase, search, search.last_sent_at);\n\n        if (newClasses.length === 0) 