f (result.ok) {\n          // Update last_sent_at\n          await supabase\n            .from(\"saved_searches\")\n            .update({ last_sent_at: now.toISOString() })\n            .eq(\"id\", search.id);\n\n          sent++;\n        }\n      } catch (error) {\n        console.error(`[sendSavedSearchDigest] Error for search ${search.id}:`, error);\n      }\n    }\n\n    return NextResponse.json({ ok: true, sent, total: savedSearches.length });\n  } catch (error: any) {\n    console.error(\"[api/personalisation/saved-search-digest] Error:\", error);\n    return NextResponse.json({ error: error.message || \"Internal server error\" }, { status: 500 });\n  }\n}\n\nasync function findNewClassesForSearch(\n  supabase: any,\n  search: any,\n  lastSentAt: string | null\n): Promise<any[]> {\n  const params = search.params || {};\n  const sinceDate = lastSentAt || new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString();\n\n  let query = supabase\n    .from(\"classes\")\n    .select(\"*\")\n    .eq(\"is_active\", true)\n    .gte(\"created_at\", sinceDate)\n    .limit(50);\n\n  // Apply search filters\n  if (params.town) {\n    query = query.ilike(\"town\", `%${params.town}%`);\n  }\n  if (params.category) {\n    query = query.eq(\"category\", params.category);\n  }\n  if (params.q) {\n    query = query.or(`name.ilike.%${params.q}%,description.ilike.%${params.q}%`);\n  }\n\n  const { data: classes } = await query;\n  return classes || [];\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/photos/cache/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/provider