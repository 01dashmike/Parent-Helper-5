) => s + tx.fee, 0),\n      0\n    );\n    const totalNet = payoutsWithBookings.reduce(\n      (sum, p) => sum + p.payout.amount,\n      0\n    );\n    const lastPayout = payouts.length > 0\n      ? payouts.sort((a, b) => b.arrival_date - a.arrival_date)[0]\n      : null;\n\n    return NextResponse.json({\n      summary: {\n        totalGross,\n        totalFees,\n        totalNet,\n        lastPayout: lastPayout\n          ? {\n              id: lastPayout.id,\n              amount: lastPayout.amount,\n              currency: lastPayout.currency,\n              arrival_date: lastPayout.arrival_date,\n            }\n          : null,\n        payoutCount: payouts.length,\n      },\n      payouts: payoutsWithBookings,\n      dateRange: {\n        from: from.toISOString(),\n        to: to.toISOString(),\n      },\n    });\n  } catch (error: any) {\n    console.error(\"[provider/payouts] Error:\", error);\n    return NextResponse.json(\n      { error: error.message || \"Failed to fetch payouts\" },\n      { status: 500 }\n    );\n  }\n}\n\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/Users/mike/Documents/Parent-Helper-5/app/api/provider/referrals/code/route.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'createClient' is defined but never used. Allowed unused vars must match /^(?:_|[A-Z].*)$/u.","line":2,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":2,"endColumn":22}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { NextRequest, NextResponse } from \"next/server\";\nimport { createClient } from \"@/lib/supabase/server\";\nimport { generateReferralCode } from \"@/app/provider/referrals/actions\";\n\n/**\n * GET /api/provider/referrals/code\n * Get or generate referral code for a provider\n */\nexport async function GET(request: NextRe